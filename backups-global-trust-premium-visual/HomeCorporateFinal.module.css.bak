.integrated,
.services,
.homeOffices {
  position: relative;
  overflow: hidden;
  color: #111;
  background:
    radial-gradient(circle at 12% 4%, rgba(23, 50, 71, .065), transparent 28rem),
    linear-gradient(180deg, #f8f5ef 0%, #eee9df 100%);
}

.integrated::before,
.services::before,
.homeOffices::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .16;
  background-image:
    linear-gradient(rgba(0,0,0,.032) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,.024) 1px, transparent 1px);
  background-size: 86px 86px;
}

.integrated {
  padding: clamp(4.8rem, 7vw, 6.6rem) 0 clamp(4rem, 6vw, 5.4rem);
}

.services {
  padding: clamp(4.2rem, 6.5vw, 6rem) 0;
  border-top: 1px solid rgba(0,0,0,.08);
}

.integratedInner,
.servicesInner,
.homeOfficesInner,
.homeFinalCtaInner {
  position: relative;
  z-index: 1;
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.integratedInner {
  display: grid;
  grid-template-columns: minmax(0, .78fr) minmax(430px, 1.22fr);
  gap: clamp(2.4rem, 5vw, 5rem);
  align-items: center;
}

.copy span,
.servicesHead span,
.homeOfficesHead span,
.globalContent > span,
.solutionsPanel span {
  display: inline-flex;
  margin-bottom: .9rem;
  color: #173247;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.copy h2,
.servicesHead h2,
.homeOfficesHead h2,
.globalContent h2,
.homeFinalCta h2 {
  margin: 0;
  font-weight: 950;
  text-wrap: balance;
  -webkit-font-smoothing: antialiased;
}

.copy h2,
.servicesHead h2 {
  max-width: 760px;
  color: #111;
  font-size: clamp(2.55rem, 5vw, 5.45rem);
  line-height: .9;
  letter-spacing: -.078em;
}

.copy h2::after,
.servicesHead h2::after,
.homeOfficesHead h2::after,
.globalContent h2::after,
.homeFinalCta h2::after {
  content: ".";
  color: #173247;
}

.copy p {
  max-width: 560px;
  margin: 1.25rem 0 0;
  color: rgba(0,0,0,.66);
  font-size: clamp(1rem, 1.15vw, 1.08rem);
  line-height: 1.72;
}

.copy ul {
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: .72rem;
}

.copy li {
  position: relative;
  padding-left: 1.45rem;
  color: rgba(0,0,0,.76);
  font-size: .96rem;
  font-weight: 850;
}

.copy li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .43rem;
  width: .55rem;
  height: .55rem;
  border-radius: 999px;
  background: #173247;
  box-shadow: 0 0 0 5px rgba(23,50,71,.08);
}

.copy a {
  width: fit-content;
  margin-top: 1.7rem;
  display: inline-flex;
  color: #173247;
  text-decoration: none;
  font-size: .8rem;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.heroImage {
  position: relative;
  min-height: 430px;
  overflow: hidden;
  border-radius: 28px;
  background: #090a0d;
  box-shadow: 0 34px 105px rgba(0,0,0,.16);
  isolation: isolate;
}

.heroImage img {
  object-fit: cover;
  filter: brightness(.9) contrast(1.05) saturate(1.04);
  transform: scale(1.02);
}

.heroImage::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(0,0,0,.02), rgba(0,0,0,.18)),
    radial-gradient(circle at 84% 12%, rgba(23,50,71,.16), transparent 18rem);
}

/* SERVICES */

.servicesHead {
  max-width: 850px;
  margin-bottom: clamp(2rem, 4vw, 3rem);
}

.servicesLayout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 420px;
  gap: clamp(3rem, 5vw, 5.2rem);
  align-items: start;
}

.serviceList {
  border-top: 1px solid rgba(0,0,0,.13);
}

.serviceRow {
  min-height: 88px;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 38px;
  gap: 1.2rem;
  align-items: center;
  padding: 1.05rem 0;
  border-bottom: 1px solid rgba(0,0,0,.12);
  color: #111;
  text-decoration: none;
  transition: transform .22s ease, border-color .22s ease;
}

.serviceRow > strong {
  display: none;
}

.serviceIcon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  color: rgba(0,0,0,.76);
}

.serviceIcon svg {
  width: 31px;
  height: 31px;
  display: block;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: transform .22s ease, color .22s ease;
}

.serviceRow h3 {
  margin: 0;
  color: #111;
  font-size: clamp(1.12rem, 1.25vw, 1.34rem);
  line-height: 1.08;
  letter-spacing: -.04em;
}

.serviceRow p {
  max-width: 560px;
  margin: .35rem 0 0;
  color: rgba(0,0,0,.58);
  font-size: .94rem;
  line-height: 1.5;
}

.serviceRow i {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: #173247;
  background: rgba(23,50,71,.06);
  font-style: normal;
  font-weight: 900;
  transition: transform .22s ease, background .22s ease, color .22s ease;
}

.serviceRow:hover {
  transform: translateX(4px);
  border-color: rgba(23,50,71,.34);
}

.serviceRow:hover .serviceIcon {
  color: #173247;
}

.serviceRow:hover .serviceIcon svg {
  transform: translateX(2px);
}

.serviceRow:hover i {
  transform: translateX(4px);
  background: #173247;
  color: #fff;
}

.solutionsPanel {
  position: sticky;
  top: 110px;
  min-height: 520px;
  padding: 40px 34px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 14px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(5,6,9,.64) 0%, rgba(5,6,9,.9) 100%),
    radial-gradient(circle at 88% 0%, rgba(23,50,71,.34), transparent 220px),
    url("/images/sectores/transporteterrestre.png") center / cover no-repeat;
  color: #fff;
  box-shadow:
    0 34px 95px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.08);
  isolation: isolate;
}

.solutionsPanel::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .14;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 42px 42px;
}

.solutionsPanel::after {
  content: "";
  position: absolute;
  inset: auto -20% -35% -20%;
  height: 44%;
  z-index: 0;
  opacity: .45;
  pointer-events: none;
  filter: blur(18px);
  background: radial-gradient(circle, rgba(23,50,71,.28), transparent 62%);
}

.solutionsPanel > * {
  position: relative;
  z-index: 1;
}

.solutionsPanel span {
  margin-bottom: 18px;
  color: #d8ab62;
  font-size: 10px;
}

.solutionsPanel h3 {
  max-width: 340px;
  margin: 0;
  color: #fff;
  font-size: 32px;
  line-height: 1.06;
  letter-spacing: -.045em;
  font-weight: 900;
}

.solutionsPanel p {
  max-width: 340px;
  margin: 22px 0 0;
  color: rgba(255,255,255,.78);
  font-size: 14px;
  line-height: 1.65;
}

.panelStats {
  display: grid;
  gap: 0;
  margin-top: 34px;
}

.panelStats div {
  position: relative;
  min-height: 76px;
  padding: 20px 0 0 44px;
  border-top: 1px solid rgba(255,255,255,.16);
}

.panelStats div::before {
  content: "";
  position: absolute;
  left: 0;
  top: 23px;
  width: 24px;
  height: 24px;
  border-radius: 999px;
  border: 1px solid rgba(216,171,98,.55);
  background: radial-gradient(circle, rgba(23,50,71,.35), transparent 58%);
}

.panelStats strong {
  display: block;
  color: #fff;
  font-size: 20px;
  line-height: 1.15;
  font-weight: 950;
  letter-spacing: -.025em;
}

.panelStats small {
  display: block;
  margin-top: 7px;
  color: rgba(255,255,255,.62);
  font-size: 12px;
  line-height: 1.5;
}

/* GLOBAL MAP */

.globalTrust {
  position: relative;
  isolation: isolate;
  min-height: clamp(560px, 48vw, 720px);
  padding: 0;
  overflow: hidden;
  color: #fff;
  background:
    linear-gradient(
      90deg,
      rgba(3,4,6,.96) 0%,
      rgba(3,4,6,.84) 25%,
      rgba(3,4,6,.42) 44%,
      rgba(3,4,6,.10) 70%,
      rgba(3,4,6,.18) 100%
    ),
    url("/images/mapa/mapa.png") center center / cover no-repeat;
}

.globalTrust::after {
  display: none;
}

.globalOverlay {
  position: relative;
  z-index: 1;
  width: min(1180px, calc(100% - 40px));
  min-height: inherit;
  margin: 0 auto;
  padding: clamp(4.2rem, 5.6vw, 6rem) 0 clamp(6.5rem, 8vw, 8rem);
  display: flex;
  align-items: center;
}

.globalContent {
  max-width: 440px;
}

.globalContent > span {
  margin-bottom: .8rem;
  color: #173247;
  font-size: .68rem;
}

.globalContent h2 {
  max-width: 430px;
  color: #fff;
  font-size: clamp(2.25rem, 3.4vw, 4rem);
  line-height: .97;
  letter-spacing: -.065em;
}

.globalCards {
  max-width: 390px;
  margin-top: 1.55rem;
  display: grid;
  gap: 0;
}

.globalCards div {
  padding: .82rem 0;
  border-top: 1px solid rgba(255,255,255,.16);
}

.globalCards strong {
  display: block;
  color: #fff;
  font-size: .92rem;
  font-weight: 950;
  letter-spacing: -.025em;
}

.globalCards p {
  max-width: 390px;
  margin: .45rem 0 0;
  color: rgba(255,255,255,.70);
  font-size: .82rem;
  line-height: 1.48;
}

.mobileCertifications {
  display: none;
}

.certificationsImage {
  display: none;
}

.certificationsImage img {
  object-fit: contain;
}

/* OFFICES */

.homeOffices {
  padding: clamp(4.4rem, 6.2vw, 6rem) 0;
  background:
    radial-gradient(circle at 12% 0%, rgba(23,50,71,.065), transparent 30rem),
    radial-gradient(circle at 88% 18%, rgba(216,171,98,.10), transparent 24rem),
    linear-gradient(180deg, #f8f5ef 0%, #eee9df 100%);
}

.homeOfficesHead {
  max-width: 760px;
  margin-bottom: 2rem;
}

.homeOfficesHead h2 {
  color: #111;
  font-size: clamp(2.25rem, 4vw, 4.3rem);
  line-height: .94;
  letter-spacing: -.065em;
}

.homeOfficesGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1.15rem;
}

.homeOfficeCard,
.allOfficesCard {
  min-height: 166px;
  overflow: hidden;
  border-radius: 14px;
  background: rgba(255,255,255,.72);
  border: 1px solid rgba(0,0,0,.075);
  color: #111;
  text-decoration: none;
  box-shadow:
    0 24px 70px rgba(0,0,0,.07),
    inset 0 1px 0 rgba(255,255,255,.65);
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}

.homeOfficeCard:hover,
.allOfficesCard:hover {
  transform: translateY(-4px);
  border-color: rgba(23,50,71,.28);
  box-shadow: 0 26px 75px rgba(0,0,0,.105);
}

.homeOfficeImage {
  position: relative;
  height: 86px;
  background: #111217;
  overflow: hidden;
}

.homeOfficeImage img {
  object-fit: cover;
  filter: brightness(.84) contrast(1.05) saturate(1.04);
  transform: scale(1.02);
}

.homeOfficeImage::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,.18));
}

.homeOfficeBody {
  padding: 1rem 1.05rem 1.05rem;
}

.homeOfficeBody strong {
  display: block;
  color: #111;
  font-size: .95rem;
  font-weight: 950;
  letter-spacing: -.02em;
}

.homeOfficeBody small {
  display: block;
  margin-top: .18rem;
  color: rgba(0,0,0,.62);
  font-size: .8rem;
}

.homeOfficeBody p {
  margin: .55rem 0 0;
  color: #111;
  font-size: .82rem;
  font-weight: 850;
}

.allOfficesCard {
  padding: 1.1rem;
  display: grid;
  place-items: center;
  text-align: center;
  background:
    radial-gradient(circle at 50% 0%, rgba(23,50,71,.06), transparent 12rem),
    rgba(255,255,255,.62);
}

.allOfficesCard span {
  display: block;
  color: #111;
  font-size: 2rem;
  line-height: 1;
}

.allOfficesCard strong {
  display: block;
  margin-top: .65rem;
  font-size: .9rem;
  font-weight: 950;
}

.allOfficesCard small {
  display: block;
  margin-top: .2rem;
  color: rgba(0,0,0,.62);
  font-size: .72rem;
}

.allOfficesCard i {
  margin-top: .55rem;
  color: #173247;
  font-style: normal;
  font-weight: 950;
}

/* FINAL CTA */

.homeFinalCta {
  position: relative;
  min-height: 340px;
  overflow: hidden;
  background:
    linear-gradient(
      90deg,
      rgba(5,6,9,.98) 0%,
      rgba(5,6,9,.88) 38%,
      rgba(5,6,9,.48) 62%,
      rgba(5,6,9,.16) 100%
    ),
    url("/images/operador/contacenter.png") right center / auto 106% no-repeat,
    #050609;
  color: #fff;
}

.homeFinalCta::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 18% 50%, rgba(23,50,71,.12), transparent 18rem),
    linear-gradient(180deg, rgba(255,255,255,.026), transparent 35%);
}

.homeFinalCtaInner {
  position: relative;
  z-index: 1;
  min-height: inherit;
  display: flex;
  align-items: center;
}

.homeFinalCta h2 {
  max-width: 540px;
  color: #fff;
  font-size: clamp(2rem, 3.2vw, 3.55rem);
  line-height: .98;
  letter-spacing: -.065em;
}

.homeFinalCta p {
  margin: .75rem 0 1.4rem;
  color: rgba(255,255,255,.76);
  font-size: 1rem;
}

.homeFinalCta a {
  min-height: 46px;
  padding: 0 1.35rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 5px;
  background: #173247;
  color: #fff;
  text-decoration: none;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .04em;
  text-transform: uppercase;
  box-shadow: 0 18px 42px rgba(23,50,71,.24);
}

/* TABLET */

@media (max-width: 1020px) {
  .integratedInner,
  .servicesLayout {
    grid-template-columns: 1fr;
  }

  .solutionsPanel {
    position: relative;
    top: auto;
    min-height: auto;
  }

  .panelStats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .homeOfficesGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .allOfficesCard {
    min-height: 140px;
  }
}

/* MOBILE */

@media (max-width: 768px) {
  .globalTrust {
    min-height: 650px;
    padding-bottom: 0;
    background:
      linear-gradient(
        180deg,
        rgba(3,4,6,.88) 0%,
        rgba(3,4,6,.74) 35%,
        rgba(3,4,6,.58) 65%,
        rgba(3,4,6,.88) 100%
      ),
      url("/images/mapa/mapa-mobile.png") center center / cover no-repeat;
  }

  .globalTrust::after {
    display: none;
  }

  .globalOverlay {
    width: calc(100% - 28px);
    min-height: 650px;
    padding: 3rem 0 4.5rem;
    align-items: flex-start;
  }

  .mobileCertifications {
    position: relative;
    z-index: 2;
    display: block;
    margin-top: 0;
    padding: 0;
    background: #050609;
  }

  .certificationsImage {
    position: relative;
    display: block;
    width: 100%;
    height: 76px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 0;
    background: rgba(255,255,255,.96);
    box-shadow: 0 12px 28px rgba(0,0,0,.12);
    filter:
      brightness(1.16)
      contrast(1.08);
  }

  .globalContent {
    max-width: 100%;
  }

  .globalContent > span {
    font-size: .62rem;
    letter-spacing: .24em;
    margin-bottom: .8rem;
  }

  .globalContent h2 {
    max-width: 320px;
    font-size: clamp(1.8rem, 9.2vw, 2.45rem);
    line-height: .98;
    letter-spacing: -.06em;
  }

  .globalCards {
    max-width: 310px;
    margin-top: 1.45rem;
  }

  .globalCards div {
    padding: .78rem 0;
  }

  .globalCards strong {
    font-size: .88rem;
  }

  .globalCards p {
    font-size: .78rem;
    line-height: 1.45;
  }

  .homeFinalCta {
    min-height: 330px;
    background:
      linear-gradient(
        90deg,
        rgba(5,6,9,.98) 0%,
        rgba(5,6,9,.94) 44%,
        rgba(5,6,9,.72) 64%,
        rgba(5,6,9,.42) 100%
      ),
      url("/images/operador/contacenter.png") 82% center / auto 108% no-repeat,
      #050609;
  }

  .homeFinalCta h2 {
    max-width: 285px;
    font-size: clamp(1.7rem, 8.8vw, 2.35rem);
    line-height: 1;
  }

  .homeFinalCta p {
    max-width: 245px;
    font-size: .92rem;
    line-height: 1.45;
  }

  .homeFinalCta a {
    width: auto;
    min-height: 46px;
    padding: 0 1.25rem;
    font-size: .72rem;
  }
}

@media (max-width: 640px) {
  .integrated,
  .services {
    padding: 4rem 0;
  }

  .integratedInner,
  .servicesInner,
  .homeOfficesInner,
  .homeFinalCtaInner {
    width: calc(100% - 28px);
  }

  .copy h2,
  .servicesHead h2 {
    font-size: clamp(2.1rem, 10vw, 3.1rem);
    line-height: .93;
  }

  .heroImage {
    min-height: 230px;
    border-radius: 24px;
  }

  .serviceRow {
    min-height: auto;
    grid-template-columns: 34px minmax(0, 1fr) 30px;
    gap: .8rem;
    padding: 1rem 0;
  }

  .serviceIcon {
    width: 30px;
    height: 30px;
  }

  .serviceIcon svg {
    width: 24px;
    height: 24px;
  }

  .serviceRow h3 {
    font-size: 1.02rem;
  }

  .serviceRow p {
    font-size: .82rem;
  }

  .solutionsPanel {
    min-height: auto;
    padding: 24px 20px;
    border-radius: 10px;
  }

  .solutionsPanel h3 {
    max-width: 280px;
    font-size: 24px;
  }

  .solutionsPanel p {
    max-width: 300px;
  }

  .panelStats {
    grid-template-columns: 1fr;
    margin-top: 24px;
  }

  .homeOffices {
    padding: 3.6rem 0;
  }

  .homeOfficesHead h2 {
    font-size: clamp(2rem, 9vw, 2.9rem);
  }

  .homeOfficesGrid {
    grid-template-columns: 1fr;
  }

  .homeOfficeCard {
    min-height: auto;
  }

  .homeOfficeImage {
    height: 110px;
  }
}

/* =====================================================
   HOME MOBILE PHASE 1 — CORPORATE SECTIONS TYPOGRAPHY
   Ajuste puntual pedido por cliente:
   versión móvil / letras / respiración visual
   ===================================================== */

@media (max-width: 768px) {
  .integrated,
  .services,
  .homeOffices,
  .homeFinalCta {
    overflow-x: hidden !important;
  }

  .integratedInner,
  .servicesInner,
  .globalOverlay,
  .homeOfficesInner,
  .homeFinalCtaInner {
    width: calc(100% - 44px) !important;
    max-width: 360px !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .copy,
  .servicesHead,
  .homeOfficesHead,
  .globalContent {
    max-width: 340px !important;
  }

  .copy h2,
  .servicesHead h2,
  .homeOfficesHead h2,
  .globalContent h2,
  .homeFinalCta h2 {
    max-width: 335px !important;
    font-size: clamp(1.82rem, 8.15vw, 2.42rem) !important;
    line-height: 1 !important;
    letter-spacing: -.052em !important;
  }

  .copy p,
  .servicesHead p,
  .globalContent p,
  .homeOfficesHead p,
  .homeFinalCta p {
    max-width: 315px !important;
    font-size: .88rem !important;
    line-height: 1.62 !important;
  }

  .serviceRow h3 {
    font-size: 1rem !important;
    line-height: 1.18 !important;
  }

  .serviceRow p {
    font-size: .82rem !important;
    line-height: 1.48 !important;
  }

  .solutionsPanel h3 {
    max-width: 285px !important;
    font-size: 1.42rem !important;
    line-height: 1.08 !important;
  }

  .solutionsPanel p {
    max-width: 285px !important;
    font-size: .86rem !important;
    line-height: 1.55 !important;
  }

  .globalCards {
    max-width: 310px !important;
  }

  .globalCards strong {
    font-size: 1.28rem !important;
    line-height: 1.08 !important;
  }

  .globalCards p {
    font-size: .82rem !important;
    line-height: 1.48 !important;
  }

  .homeOfficeBody p {
    font-size: .82rem !important;
    line-height: 1.45 !important;
  }
}

@media (max-width: 430px) {
  .integratedInner,
  .servicesInner,
  .globalOverlay,
  .homeOfficesInner,
  .homeFinalCtaInner {
    width: calc(100% - 40px) !important;
    max-width: 330px !important;
  }

  .copy,
  .servicesHead,
  .homeOfficesHead,
  .globalContent {
    max-width: 320px !important;
  }

  .copy h2,
  .servicesHead h2,
  .homeOfficesHead h2,
  .globalContent h2,
  .homeFinalCta h2 {
    max-width: 315px !important;
    font-size: clamp(1.72rem, 7.8vw, 2.22rem) !important;
  }

  .copy p,
  .servicesHead p,
  .globalContent p,
  .homeOfficesHead p,
  .homeFinalCta p {
    max-width: 300px !important;
    font-size: .84rem !important;
    line-height: 1.58 !important;
  }
}

@media (max-width: 380px) {
  .integratedInner,
  .servicesInner,
  .globalOverlay,
  .homeOfficesInner,
