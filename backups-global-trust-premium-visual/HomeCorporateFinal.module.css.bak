  }
}

/* =====================================================
   HOME MOBILE PHASE 2 — CTA + SHADOW POLISH
   Ajuste puntual pedido por cliente:
   llamados de acción / botones / sombras
   ===================================================== */

@media (max-width: 768px) {
  .serviceRow,
  .solutionsPanel,
  .globalCards div,
  .homeOfficeCard,
  .allOfficesCard {
    box-shadow:
      0 18px 46px rgba(0,0,0,.11),
      inset 0 1px 0 rgba(255,255,255,.12) !important;
  }

  .serviceRow {
    border-bottom: 1px solid rgba(0,0,0,.075) !important;
  }

  .serviceRow:hover {
    transform: none !important;
  }

  .solutionsPanel {
    background:
      radial-gradient(circle at 16% 0%, rgba(23,50,71,.12), transparent 14rem),
      linear-gradient(180deg, rgba(12,14,19,.96), rgba(5,6,9,.98)) !important;
    border: 1px solid rgba(255,255,255,.11) !important;
    box-shadow:
      0 22px 58px rgba(0,0,0,.24),
      inset 0 1px 0 rgba(255,255,255,.07) !important;
  }

  .globalCards div {
    background: rgba(5,6,9,.52) !important;
    border-top: 1px solid rgba(255,255,255,.13) !important;
    box-shadow:
      0 16px 38px rgba(0,0,0,.18),
      inset 0 1px 0 rgba(255,255,255,.05) !important;
  }

  .homeOfficeCard,
  .allOfficesCard {
    border-radius: 16px !important;
    background: rgba(255,255,255,.78) !important;
    border: 1px solid rgba(0,0,0,.075) !important;
    box-shadow:
      0 18px 48px rgba(0,0,0,.09),
      inset 0 1px 0 rgba(255,255,255,.70) !important;
  }

  .homeFinalCta {
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.055),
      0 -18px 60px rgba(0,0,0,.16) !important;
  }

  .homeFinalCta a {
    min-height: 50px !important;
    padding: 0 1.35rem !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 999px !important;
    background:
      linear-gradient(135deg, #173247 0%, #214a64 52%, #07111d 100%) !important;
    color: #fff !important;
    border: 1px solid rgba(255,255,255,.16) !important;

    text-decoration: none !important;
    text-transform: uppercase !important;
    text-align: center !important;

    font-size: .72rem !important;
    font-weight: 950 !important;
    letter-spacing: .065em !important;
    line-height: 1.1 !important;

    box-shadow:
      0 16px 34px rgba(23,50,71,.24),
      0 4px 12px rgba(0,0,0,.20),
      inset 0 1px 0 rgba(255,255,255,.18) !important;
  }

  .homeFinalCta a:active {
    transform: translateY(1px) scale(.99) !important;
  }
}

@media (max-width: 430px) {
  .homeFinalCta a {
    min-height: 48px !important;
    padding: 0 1.2rem !important;
    font-size: .68rem !important;
    letter-spacing: .055em !important;
  }

  .homeOfficeCard,
  .allOfficesCard {
    border-radius: 15px !important;
  }
}

@media (max-width: 380px) {
  .homeFinalCta a {
    min-height: 44px !important;
    padding: 0 1rem !important;
    font-size: .62rem !important;
    letter-spacing: .048em !important;
  }
}

