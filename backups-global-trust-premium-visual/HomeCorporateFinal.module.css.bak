.section :where(a) {
  color: var(--section-blue) !important;
  text-decoration: none !important;
  letter-spacing: .14em !important;
  font-weight: 900 !important;
}

.section :where(a:hover) {
  color: var(--section-ink) !important;
}

/* Cards / imagen */
.section :where(img) {
  filter:
    saturate(.92)
    contrast(1.02)
    brightness(.98) !important;
}

/* Mobile: título más fino y menos brutal */
@media (max-width: 760px) {
  .section :where(h1, h2, h3) {
    font-size: clamp(2.25rem, 10vw, 3.15rem) !important;
    line-height: .96 !important;
    letter-spacing: -0.06em !important;
  }

  .section :where(p) {
    font-size: .98rem !important;
    line-height: 1.74 !important;
  }

  .section :where(a) {
    font-size: .78rem !important;
  }
}

/* =====================================================
   INTEGRATED SECTION FINAL PREMIUM REBRAND
   Clases reales: integrated / copy / heroImage.
   Azul tinta + champagne + tipografía más fina.
   ===================================================== */

.integrated {
  background:
    radial-gradient(circle at 12% 0%, rgba(23, 50, 71, .075), transparent 28rem),
    linear-gradient(180deg, #f7f4ee 0%, #fbfaf7 58%, #f5f1ea 100%) !important;
}

.integrated .copy {
  --ink: #081521;
  --ink-soft: #13283b;
  --blue-ink: #173247;
  --champagne: #cdbb8d;
}

/* Label: SOLUCIONES A MEDIDA */
.integrated .copy > span,
.integrated .copy small,
.integrated .copy [class*="badge"],
.integrated .copy [class*="Badge"],
.integrated .copy [class*="eyebrow"],
.integrated .copy [class*="Eyebrow"] {
  color: #173247 !important;
  letter-spacing: .24em !important;
  font-weight: 950 !important;
}

/* Título */
.integrated .copy h2,
.integrated .copy h3 {
  color: #081521 !important;
  font-weight: 900 !important;
  letter-spacing: -0.065em !important;
  line-height: .94 !important;
}

/* Punto final/acento del título */
.integrated .copy h2 span,
.integrated .copy h3 span,
.integrated .copy h2 strong,
.integrated .copy h3 strong {
  color: #173247 !important;
}

/* Párrafo */
.integrated .copy p {
  color: rgba(8, 21, 33, .72) !important;
  font-weight: 500 !important;
  line-height: 1.75 !important;
}

/* Items */
.integrated .copy ul,
.integrated .copy ol {
  gap: .88rem !important;
}

.integrated .copy li {
  color: rgba(8, 21, 33, .84) !important;
  font-weight: 850 !important;
}

/* Si los puntos están hechos con span/div antes del texto */
.integrated .copy li::before,
.integrated .copy li span:first-child,
.integrated .copy li i,
.integrated .copy li b {
  background: #173247 !important;
  color: #173247 !important;
  box-shadow: 0 0 0 5px rgba(23,50,71,.08) !important;
}

/* Link CONOCER MÁS */
.integrated .copy a {
  color: #173247 !important;
  letter-spacing: .15em !important;
  font-weight: 950 !important;
  text-decoration: none !important;
}

.integrated .copy a:hover {
  color: #081521 !important;
}

/* Imagen/card */
.integrated .heroImage {
  border: 1px solid rgba(8, 21, 33, .10) !important;
  box-shadow:
    0 22px 54px rgba(8, 21, 33, .13),
    inset 0 1px 0 rgba(255,255,255,.70) !important;
}

.integrated .heroImage img {
  filter: saturate(.92) contrast(1.02) brightness(.98) !important;
}

/* Mobile */
@media (max-width: 760px) {
  .integrated .copy h2,
  .integrated .copy h3 {
    font-size: clamp(2.25rem, 10.2vw, 3.05rem) !important;
    line-height: .96 !important;
    letter-spacing: -0.062em !important;
  }

  .integrated .copy p {
    font-size: .98rem !important;
    line-height: 1.74 !important;
  }

  .integrated .copy a {
    font-size: .78rem !important;
  }
}

/* =====================================================
   MOBILE SERVICES CLEANUP
   Oculta panel repetitivo en mobile:
   "De origen a destino, bajo una sola coordinación".
   ===================================================== */

@media (max-width: 760px) {
  .solutionsPanel {
    display: none !important;
  }

  .servicesLayout {
    display: block !important;
  }

  .serviceList {
    width: 100% !important;
  }
}

/* =====================================================
   HOME FULL PREMIUM INK REBRAND
   Azul tinta + graphite + champagne.
   Sombras más finas, menos rojo, más B2B premium.
   ===================================================== */

.services,
.homeOffices {
  background:
    radial-gradient(circle at 12% 0%, rgba(23, 50, 71, .055), transparent 28rem),
    linear-gradient(180deg, #fbfaf7 0%, #f6f2eb 100%) !important;
}

.servicesHead span,
.homeOfficesHead span,
.globalContent span,
.homeFinalCta span {
  color: #173247 !important;
  letter-spacing: .24em !important;
  font-weight: 950 !important;
}

.servicesHead h2,
.homeOfficesHead h2,
.globalContent h2,
.homeFinalCta h2 {
  color: #081521 !important;
  letter-spacing: -0.06em !important;
  line-height: .94 !important;
  font-weight: 900 !important;
}

.serviceRow,
.homeOfficeCard,
.allOfficesCard {
  background:
    linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,247,243,.92)) !important;
  border: 1px solid rgba(8, 21, 33, .105) !important;
  box-shadow:
    0 14px 34px rgba(8, 21, 33, .07),
    inset 0 1px 0 rgba(255,255,255,.86) !important;
}

.serviceRow:hover,
.homeOfficeCard:hover,
.allOfficesCard:hover {
  border-color: rgba(23, 50, 71, .26) !important;
  box-shadow:
    0 20px 48px rgba(8, 21, 33, .105),
    inset 0 1px 0 rgba(255,255,255,.92) !important;
}

.serviceIcon {
  background:
    linear-gradient(180deg, rgba(255,255,255,.96), rgba(239,242,242,.88)) !important;
  border: 1px solid rgba(8, 21, 33, .12) !important;
  box-shadow:
    0 8px 18px rgba(8, 21, 33, .08),
    inset 0 1px 0 rgba(255,255,255,.9) !important;
}

.serviceIcon svg,
.serviceRow svg,
.allOfficesCard svg {
  stroke: #173247 !important;
}

.serviceRow h3,
.homeOfficeBody h3,
.allOfficesCard h3 {
  color: #081521 !important;
}

.serviceRow p,
.homeOfficeBody p,
.allOfficesCard p {
  color: rgba(8, 21, 33, .66) !important;
}

/* Flechas / círculos */
.serviceRow > span,
.serviceRow a,
.allOfficesCard a {
  color: #173247 !important;
}

/* Panel oscuro del mapa/confianza: de negro puro a azul tinta premium */
.globalTrust {
  background:
    radial-gradient(circle at 82% 18%, rgba(142, 202, 230, .13), transparent 22rem),
    radial-gradient(circle at 18% 74%, rgba(205, 187, 141, .10), transparent 18rem),
    linear-gradient(180deg, #07111d 0%, #081521 48%, #03070d 100%) !important;
}

.globalOverlay {
  background:
    linear-gradient(90deg, rgba(7, 17, 29, .96) 0%, rgba(7, 17, 29, .88) 48%, rgba(7, 17, 29, .72) 100%) !important;
}

.globalContent span {
  color: #cdbb8d !important;
}

.globalContent h2 {
  color: #ffffff !important;
}

.globalCards > div,
.globalCards article {
  background:
    linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.045)) !important;
  border: 1px solid rgba(255,255,255,.14) !important;
  box-shadow:
    0 18px 42px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.10) !important;
  backdrop-filter: blur(16px) saturate(1.12) !important;
  -webkit-backdrop-filter: blur(16px) saturate(1.12) !important;
}

.globalCards h3 {
  color: #ffffff !important;
}

.globalCards p {
  color: rgba(255,255,255,.76) !important;
}

/* CTA final: no más rojo, mismo lenguaje que hero */
.homeFinalCta {
  background:
    radial-gradient(circle at 82% 30%, rgba(23, 50, 71, .30), transparent 20rem),
    linear-gradient(135deg, #07111d 0%, #0d1c2b 48%, #120d14 100%) !important;
}

.homeFinalCta h2 {
  color: #ffffff !important;
}

.homeFinalCta p {
  color: rgba(255,255,255,.78) !important;
}

.homeFinalCta a {
  color: #fff !important;
  background:
    radial-gradient(circle at 18% 0%, rgba(255,255,255,.18), transparent 30%),
    linear-gradient(135deg, #07111d 0%, #0d1c2b 48%, #173247 100%) !important;
  border: 1px solid rgba(205,187,141,.32) !important;
  box-shadow:
    0 18px 42px rgba(0,0,0,.34),
    0 8px 22px rgba(7,17,29,.42),
    inset 0 1px 0 rgba(255,255,255,.18) !important;
}

/* Mobile refinado */
@media (max-width: 760px) {
  .services,
  .homeOffices {
    padding-top: 4.5rem !important;
    padding-bottom: 4.8rem !important;
  }

  .servicesHead h2,
  .homeOfficesHead h2,
  .globalContent h2,
  .homeFinalCta h2 {
    font-size: clamp(2.15rem, 9.6vw, 3rem) !important;
    line-height: .96 !important;
  }

  .serviceRow {
    border-radius: 18px !important;
  }

  .globalTrust {
    padding-top: 4.8rem !important;
    padding-bottom: 4.8rem !important;
  }

  .homeFinalCta {
    padding-top: 4.8rem !important;
    padding-bottom: 4.8rem !important;
  }
}
