@import "../styles/reset.css";
@import "../styles/tokens.css";
@import "../styles/utilities.css";

body {
  overflow-x: hidden;
  font-family: var(--font-body);
}

main {
  isolation: isolate;
}

/* === Across premium mobile fixes === */

@media (max-width: 900px) {
  .heroServices,
  .serviceGrid {
    display: flex !important;
    flex-direction: row !important;
    overflow-x: auto !important;
    width: calc(100% - 24px) !important;
    margin: 28px auto 0 !important;
    border-radius: 26px !important;
    background: linear-gradient(180deg, rgba(7,8,12,.92), rgba(7,8,12,.98)) !important;
    border: 1px solid rgba(255,255,255,.08) !important;
    backdrop-filter: blur(18px) !important;
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }

  .heroServices::-webkit-scrollbar,
  .serviceGrid::-webkit-scrollbar {
    display: none !important;
  }

  .heroService,
  .serviceCard {
    min-width: 238px !important;
    max-width: 238px !important;
    min-height: 92px !important;
    padding: 18px 20px !important;
    border-right: 1px solid rgba(255,255,255,.07) !important;
    border-bottom: 0 !important;
  }

  .heroService:last-child,
  .serviceCard:last-child {
    border-right: 0 !important;
  }
}

@media (max-width: 720px) {
  

  
}


/* Hide decorative big numbers that cheapen premium cards */
[class*="number"],
[class*="Number"],
[class*="index"],
[class*="Index"] {
  opacity: 0;
  pointer-events: none;
}


/* === FIX GLOBAL MOBILE OVERFLOW === */
html,
body {
  max-width: 100%;
  overflow-x: hidden;
}

* {
  box-sizing: border-box;
}


/* === FIX GLOBAL MOBILE OVERFLOW === */
html,
body {
  max-width: 100%;
  overflow-x: hidden;
}

* {
  box-sizing: border-box;
}


/* FIX CONTACTO: oficinas sobre fondo marfil, no negro */
main:has(.contact-office-grid) {
  background: #f4f1eb !important;
}

main:has(.contact-office-grid) section {
  background: #f4f1eb !important;
  background-color: #f4f1eb !important;
  background-image: none !important;
}

.contact-office-grid {
  background: #f4f1eb !important;
  background-color: #f4f1eb !important;
  background-image: none !important;
  box-shadow: none !important;
  padding-top: 18px !important;
}

.contact-office-grid::before,
.contact-office-grid::after {
  display: none !important;
  content: none !important;
  background: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
}

.contact-office-grid > a {
  background: #111 !important;
  border: 1px solid rgba(0,0,0,.08) !important;
  box-shadow: 0 22px 60px rgba(0,0,0,.14) !important;
}

.contact-office-grid [class*="cardOverlay"] {
  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.04) 0%,
      rgba(0,0,0,.16) 45%,
      rgba(0,0,0,.74) 100%
    ) !important;
}

