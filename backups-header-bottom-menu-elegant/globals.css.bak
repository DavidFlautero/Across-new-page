}

/* Banderas sobre hero */
body:not(.across-header-solid) [class*="Header_language"],
body:not(.across-header-solid) [class*="Header_locale"],
body:not(.across-header-solid) [class*="Header_flag"] {
  background: rgba(255,255,255,.18) !important;
  border: 1px solid rgba(255,255,255,.22) !important;
  box-shadow: 0 8px 18px rgba(0,0,0,.12) !important;
}

/* Hamburguesa sobre hero */
body:not(.across-header-solid) [class*="Header_menuButton"],
body:not(.across-header-solid) [class*="Header_mobileToggle"],
body:not(.across-header-solid) [class*="Header_burger"] {
  background: rgba(8,10,14,.86) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.16) !important;
  box-shadow:
    0 8px 20px rgba(0,0,0,.16),
    inset 0 1px 0 rgba(255,255,255,.08) !important;
}

body:not(.across-header-solid) [class*="Header_menuButton"] svg,
body:not(.across-header-solid) [class*="Header_mobileToggle"] svg,
body:not(.across-header-solid) [class*="Header_burger"] svg {
  stroke: #fff !important;
}

/* =========================
   DESPUÉS DEL HERO — BLANCO
   ========================= */

