/* Header contact button alignment fix */
header a[href="/contacto"],
header a[href="/contact"],
nav a[href="/contacto"],
nav a[href="/contact"] {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  text-align: center !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

/* Cookie banner: force a real decision, no visual escape */
[class*="cookie"] button[aria-label*="close" i],
[class*="cookie"] button[aria-label*="cerrar" i],
[class*="cookie"] .close,
[class*="cookie"] .Close,
[class*="cookie"] [class*="close"],
[class*="cookie"] [class*="Close"] {
  display: none !important;
  pointer-events: none !important;
}

[class*="cookie"] a,
[class*="Cookie"] a {
  text-decoration: underline !important;
  text-underline-offset: 3px !important;
}

[class*="cookie"] button,
[class*="Cookie"] button {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
}

/* Brand red for cookie buttons */
[class*="cookie"] button,
[class*="Cookie"] button {
  background: #e11343f2 !important;
  border-color: #e11343f2 !important;
  color: #fff !important;
}

/* === HERO CTA ABOVE OVERLAYS === */
[class*="heroContent"],
[class*="Hero_heroContent"],
[class*="heroInner"] {
  position: relative;
  z-index: 5;
}

[class*="heroContent"] a,
[class*="heroContent"] button,
[class*="Hero_heroContent"] a,
[class*="Hero_heroContent"] button,
[class*="actions"] a,
[class*="actions"] button {
  position: relative;
  z-index: 6;
}

[class*="heroOverlay"],
[class*="overlay"],
[class*="redGlow"] {
  pointer-events: none;
}

/* === FLOATING CALL BUTTON FINAL POSITION === */
@media (max-width: 1100px) {
  [class*="FloatingCallButton_floating"] {
    right: clamp(.75rem, 2.4vw, 1.2rem) !important;
    bottom: calc(7rem + env(safe-area-inset-bottom)) !important;
    z-index: 5200 !important;
  }

  [class*="FloatingCallButton_chatBubble"] {
    right: 0 !important;
    bottom: calc(100% + .42rem) !important;
    z-index: 5201 !important;
  }

  [class*="FloatingCallButton_callPill"] {
    z-index: 5201 !important;
  }
}

@media (max-width: 760px) {
  [class*="FloatingCallButton_floating"] {
    right: .72rem !important;
    bottom: calc(7.15rem + env(safe-area-inset-bottom)) !important;
  }
}

@media (max-width: 760px) and (max-height: 720px) {
  [class*="FloatingCallButton_floating"] {
    right: .58rem !important;
    bottom: calc(5.75rem + env(safe-area-inset-bottom)) !important;
  }
}

@media (max-width: 1100px) {
  body:has([class*="mobilePanelVisible"]) [class*="FloatingCallButton_floating"] {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(16px) scale(.96) !important;
  }
}


/* =====================================================
   IPHONE SE / SMALL MOBILE — OMIT FLOATING CALL BUTTON
   No se elimina del proyecto. Solo se oculta en pantallas
   pequeñas donde compite con CTAs y barra inferior.
   ===================================================== */

@media (max-width: 430px), (max-height: 760px) {
  [class*="FloatingCallButton_floating"],
  [class*="FloatingCallButton_callPill"],
  [class*="FloatingCallButton_callButton"],
  [class*="FloatingCallButton_chatBubble"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* FORCE MOBILE — OMIT FLOATING CALL BUTTON */
@media (max-width: 760px) {
  [class*="FloatingCallButton_floating"],
  [class*="FloatingCallButton_callPill"],
  [class*="FloatingCallButton_callButton"],
  [class*="FloatingCallButton_chatBubble"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* FORCE MOBILE — FLOATING CALL BUTTON OFF */
@media (max-width: 760px) {
  [class*="FloatingCallButton"],
  [class*="FloatingCallButton_floating"],
  [class*="FloatingCallButton_callPill"],
  [class*="FloatingCallButton_callButton"],
  [class*="FloatingCallButton_chatBubble"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* =====================================================
   MOBILE CORPORATE BACKGROUND — MAERSK STYLE ROUND
   ===================================================== */

@media (max-width: 760px) {
  html,
  body {
    background: #f7f5f0 !important;
  }
}

/* =====================================================
   ACROSS WHITE CORPORATE HEADER + FOOTER POLISH
   Dirección visual:
   - Header blanco / glass claro
   - Letras negras
   - Rojo solo para contacto/acciones
   - Footer blanco/crema corporativo
   - Negro solo como contraste puntual
   ===================================================== */

/* -----------------------------
   HEADER DESKTOP
   ----------------------------- */

@media (min-width: 761px) {
  [class*="Header_header"],
  header[class*="header"],
  header {
    background: rgba(255, 255, 255, .94) !important;
    border: 1px solid rgba(0, 0, 0, .08) !important;
    border-bottom-color: rgba(0, 0, 0, .10) !important;
    box-shadow: 0 14px 38px rgba(0, 0, 0, .08) !important;
    backdrop-filter: blur(16px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(16px) saturate(1.08) !important;
  }

  [class*="Header_inner"] {
    color: #111 !important;
  }

  [class*="Header_nav"] a,
  [class*="Header_nav"] button,
  [class*="Header_actions"] a,
  [class*="Header_actions"] button,
  [class*="Header_menu"] a,
  [class*="Header_menu"] button {
    color: #111 !important;
    font-weight: 850 !important;
    letter-spacing: .015em !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  [class*="Header_nav"] a:hover,
  [class*="Header_nav"] button:hover,
  [class*="Header_actions"] a:hover,
  [class*="Header_actions"] button:hover {
    background: rgba(180, 0, 50, .07) !important;
    color: #b40032 !important;
  }

  [class*="Header_contact"],
  [class*="Header_cta"] {
    background: #b40032 !important;
    color: #fff !important;
    border: 1px solid #b40032 !important;
    border-radius: 8px !important;
    box-shadow: none !important;
  }

  [class*="Header_contact"]:hover,
  [class*="Header_cta"]:hover {
    background: #950028 !important;
    color: #fff !important;
  }

  [class*="Header_language"],
  [class*="Header_locale"],
  [class*="Header_flag"] {
    background: rgba(255, 255, 255, .72) !important;
    border-color: rgba(0, 0, 0, .10) !important;
    box-shadow: none !important;
  }
}

/* -----------------------------
   HEADER MOBILE
   ----------------------------- */

@media (max-width: 760px) {
  [class*="Header_header"],
  header[class*="header"],
  header {
    top: 10px !important;
    left: 10px !important;
    right: 10px !important;

    background: rgba(255, 255, 255, .95) !important;
    border: 1px solid rgba(0, 0, 0, .10) !important;
    border-radius: 0 0 18px 18px !important;
    box-shadow: 0 14px 36px rgba(0, 0, 0, .14) !important;

    backdrop-filter: blur(16px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(16px) saturate(1.08) !important;
  }

  [class*="Header_inner"] {
    min-height: 62px !important;
    padding-left: 12px !important;
    padding-right: 12px !important;
    color: #111 !important;
  }

  [class*="Header_brand"],
  [class*="Header_logo"] {
    color: #111 !important;
  }

  [class*="Header_language"],
  [class*="Header_locale"],
  [class*="Header_flag"] {
    background: #fff !important;
    border: 1px solid rgba(0, 0, 0, .12) !important;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .08) !important;
  }

  [class*="Header_menuButton"],
  [class*="Header_mobileToggle"],
  [class*="Header_burger"] {
    background: #111 !important;
    color: #fff !important;
    border: 1px solid #111 !important;
    border-radius: 12px !important;
    box-shadow: none !important;
  }

  [class*="Header_menuButton"] svg,
  [class*="Header_mobileToggle"] svg,
  [class*="Header_burger"] svg {
    stroke: #fff !important;
  }

  [class*="Header_mobilePanel"],
  [class*="Header_mobilePanelVisible"],
  [class*="Header_mobileMenu"],
  [class*="Header_panel"] {
    background: #fff !important;
    color: #111 !important;
    border-left: 1px solid rgba(0, 0, 0, .10) !important;
    box-shadow: -18px 0 48px rgba(0, 0, 0, .18) !important;
  }

  [class*="Header_mobilePanel"] a,
  [class*="Header_mobilePanel"] button,
  [class*="Header_mobilePanelVisible"] a,
  [class*="Header_mobilePanelVisible"] button,
  [class*="Header_mobileMenu"] a,
  [class*="Header_mobileMenu"] button,
  [class*="Header_panel"] a,
  [class*="Header_panel"] button {
    color: #111 !important;
    background: transparent !important;
    border-bottom: 1px solid rgba(0, 0, 0, .10) !important;
    font-weight: 850 !important;
    box-shadow: none !important;
  }

  [class*="Header_mobilePanel"] a:hover,
  [class*="Header_mobilePanel"] button:hover,
  [class*="Header_mobilePanelVisible"] a:hover,
  [class*="Header_mobilePanelVisible"] button:hover,
  [class*="Header_mobileMenu"] a:hover,
  [class*="Header_mobileMenu"] button:hover,
  [class*="Header_panel"] a:hover,
  [class*="Header_panel"] button:hover {
    background: #f7f5f0 !important;
    color: #b40032 !important;
  }
}

/* -----------------------------
   FOOTER WHITE CORPORATE
   ----------------------------- */

footer,
[class*="Footer_footer"],
[class*="footer"] {
  background: #f7f5f0 !important;
  color: #111 !important;
  border-top: 1px solid rgba(0, 0, 0, .10) !important;
  box-shadow: none !important;
}

footer *,
[class*="Footer_footer"] *,
[class*="footer"] * {
  color: inherit;
}

footer h2,
footer h3,
footer h4,
footer strong,
[class*="Footer_footer"] h2,
[class*="Footer_footer"] h3,
[class*="Footer_footer"] h4,
[class*="Footer_footer"] strong {
  color: #111 !important;
}

footer p,
footer small,
footer li,
[class*="Footer_footer"] p,
[class*="Footer_footer"] small,
[class*="Footer_footer"] li {
  color: rgba(17, 17, 17, .66) !important;
}

footer a,
[class*="Footer_footer"] a {
  color: rgba(17, 17, 17, .72) !important;
  text-decoration: none !important;
}

footer a:hover,
[class*="Footer_footer"] a:hover {
  color: #b40032 !important;
}

footer [class*="social"] a,
[class*="Footer_footer"] [class*="social"] a {
  border: 1px solid rgba(180, 0, 50, .22) !important;
  color: #b40032 !important;
  background: #fff !important;
}

footer [class*="social"] a:hover,
[class*="Footer_footer"] [class*="social"] a:hover {
  background: #b40032 !important;
  color: #fff !important;
}

@media (max-width: 760px) {
  footer,
  [class*="Footer_footer"],
  [class*="footer"] {
    background: #f7f5f0 !important;
    color: #111 !important;
    padding-top: 3rem !important;
    padding-bottom: 2rem !important;
  }

  footer a,
  [class*="Footer_footer"] a {
    color: rgba(17, 17, 17, .76) !important;
  }
}

/* =====================================================
   GLOBAL HEADER LIGHT OVERRIDE
   Refuerzo contra parches anteriores negros.
   ===================================================== */

@media (max-width: 760px) {
  [class*="Header_header"] {
    background: rgba(255,255,255,.92) !important;
    border-color: rgba(17,17,17,.10) !important;
    box-shadow:
      0 14px 36px rgba(0,0,0,.14),
      inset 0 1px 0 rgba(255,255,255,.86) !important;
  }

  [class*="Header_menuButton"],
  [class*="Header_mobileToggle"],
  [class*="Header_burger"] {
    background: #fff !important;
    color: #111 !important;
    border-color: rgba(17,17,17,.14) !important;
  }

  [class*="Header_menuButton"] svg,
  [class*="Header_mobileToggle"] svg,
  [class*="Header_burger"] svg {
    stroke: #111 !important;
  }
}

/* =====================================================
   HEADER TRANSPARENT TO WHITE
   Hero: glass transparente elegante.
   Después del hero: blanco corporativo.
   ===================================================== */

/* Estado inicial sobre el hero */
[class*="Header_header"] {
  transition:
    background .28s ease,
    border-color .28s ease,
    box-shadow .28s ease,
    backdrop-filter .28s ease,
    transform .28s ease !important;
}

/* -----------------------------
   MOBILE — TRANSPARENTE SOBRE HERO
   ----------------------------- */

@media (max-width: 760px) {
  body:not(.across-header-solid) [class*="Header_header"] {
    background: rgba(255,255,255,.10) !important;
    border: 1px solid rgba(255,255,255,.18) !important;
    box-shadow:
      0 16px 42px rgba(0,0,0,.18),
      inset 0 1px 0 rgba(255,255,255,.18) !important;
    backdrop-filter: blur(18px) saturate(1.15) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.15) !important;
  }

  body:not(.across-header-solid) [class*="Header_brand"],
  body:not(.across-header-solid) [class*="Header_logo"] {
    background: rgba(8,10,14,.78) !important;
    border-radius: 16px !important;
    box-shadow:
      0 10px 24px rgba(0,0,0,.18),
      inset 0 1px 0 rgba(255,255,255,.08) !important;
  }

  body:not(.across-header-solid) [class*="Header_menuButton"],
  body:not(.across-header-solid) [class*="Header_mobileToggle"],
  body:not(.across-header-solid) [class*="Header_burger"] {
    background: rgba(8,10,14,.82) !important;
    color: #fff !important;
    border: 1px solid rgba(255,255,255,.14) !important;
  }

  body:not(.across-header-solid) [class*="Header_menuButton"] svg,
  body:not(.across-header-solid) [class*="Header_mobileToggle"] svg,
  body:not(.across-header-solid) [class*="Header_burger"] svg {
    stroke: #fff !important;
  }

  body:not(.across-header-solid) [class*="Header_language"],
  body:not(.across-header-solid) [class*="Header_locale"],
  body:not(.across-header-solid) [class*="Header_flag"] {
    background: rgba(255,255,255,.16) !important;
    border: 1px solid rgba(255,255,255,.22) !important;
    box-shadow: 0 8px 18px rgba(0,0,0,.14) !important;
  }
}

/* -----------------------------
   MOBILE — BLANCO DESPUÉS DEL HERO
   ----------------------------- */

@media (max-width: 760px) {
  body.across-header-solid [class*="Header_header"] {
    background: rgba(255,255,255,.96) !important;
    border: 1px solid rgba(17,17,17,.10) !important;
    box-shadow:
      0 14px 36px rgba(0,0,0,.12),
      inset 0 1px 0 rgba(255,255,255,.90) !important;
    backdrop-filter: blur(18px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.08) !important;
  }

  body.across-header-solid [class*="Header_brand"],
  body.across-header-solid [class*="Header_logo"] {
    background: rgba(8,10,14,.92) !important;
    border-radius: 16px !important;
    box-shadow: 0 8px 20px rgba(0,0,0,.12) !important;
  }

  body.across-header-solid [class*="Header_menuButton"],
  body.across-header-solid [class*="Header_mobileToggle"],
  body.across-header-solid [class*="Header_burger"] {
    background: #fff !important;
    color: #111 !important;
    border: 1px solid rgba(17,17,17,.14) !important;
    box-shadow: 0 8px 20px rgba(0,0,0,.08) !important;
  }

  body.across-header-solid [class*="Header_menuButton"] svg,
  body.across-header-solid [class*="Header_mobileToggle"] svg,
  body.across-header-solid [class*="Header_burger"] svg {
    stroke: #111 !important;
  }

  body.across-header-solid [class*="Header_language"],
  body.across-header-solid [class*="Header_locale"],
  body.across-header-solid [class*="Header_flag"] {
    background: #fff !important;
    border: 1px solid rgba(17,17,17,.12) !important;
    box-shadow: 0 6px 14px rgba(0,0,0,.08) !important;
  }
}

/* -----------------------------
   DESKTOP — TRANSPARENTE SOBRE HERO
   ----------------------------- */

@media (min-width: 761px) {
  body:not(.across-header-solid) [class*="Header_header"] {
    background: rgba(255,255,255,.08) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    box-shadow:
      0 16px 42px rgba(0,0,0,.16),
      inset 0 1px 0 rgba(255,255,255,.12) !important;
    backdrop-filter: blur(18px) saturate(1.12) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.12) !important;
  }

  body:not(.across-header-solid) [class*="Header_nav"] a,
  body:not(.across-header-solid) [class*="Header_nav"] button,
  body:not(.across-header-solid) [class*="Header_actions"] a,
  body:not(.across-header-solid) [class*="Header_actions"] button {
    color: rgba(255,255,255,.92) !important;
  }

  body:not(.across-header-solid) [class*="Header_brand"],
  body:not(.across-header-solid) [class*="Header_logo"] {
    background: rgba(8,10,14,.78) !important;
    border-radius: 16px !important;
  }
}

/* -----------------------------
   DESKTOP — BLANCO DESPUÉS DEL HERO
   ----------------------------- */

@media (min-width: 761px) {
  body.across-header-solid [class*="Header_header"] {
    background: rgba(255,255,255,.96) !important;
    border: 1px solid rgba(17,17,17,.10) !important;
    box-shadow:
      0 14px 36px rgba(0,0,0,.10),
      inset 0 1px 0 rgba(255,255,255,.90) !important;
    backdrop-filter: blur(18px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.08) !important;
  }

  body.across-header-solid [class*="Header_nav"] a,
  body.across-header-solid [class*="Header_nav"] button,
  body.across-header-solid [class*="Header_actions"] a,
  body.across-header-solid [class*="Header_actions"] button {
    color: #111 !important;
  }

  body.across-header-solid [class*="Header_nav"] a:hover,
  body.across-header-solid [class*="Header_nav"] button:hover {
    color: #b40032 !important;
    background: rgba(180,0,50,.07) !important;
  }

  body.across-header-solid [class*="Header_brand"],
  body.across-header-solid [class*="Header_logo"] {
    background: rgba(8,10,14,.92) !important;
    border-radius: 16px !important;
  }
}

/* =====================================================
   FINAL FIX — HEADER TRANSPARENT ON HERO / WHITE AFTER
   Corrige doble capa: blanco arriba + transparente detrás.
   ===================================================== */

/* Transición general */
[class*="Header_header"],
[class*="Header_inner"] {
  transition:
    background .28s ease,
    border-color .28s ease,
    box-shadow .28s ease,
    backdrop-filter .28s ease !important;
}

/* Quitar pseudo capas viejas si existen */
[class*="Header_header"]::before,
[class*="Header_header"]::after,
[class*="Header_inner"]::before,
[class*="Header_inner"]::after {
  background: transparent !important;
  box-shadow: none !important;
}

/* =========================
   HERO — TRANSPARENTE REAL
   ========================= */

body:not(.across-header-solid) [class*="Header_header"] {
