.page {
  background: #f4f0ea;
  color: #111;
}

.intro {
  padding: 12rem 5vw 5rem;
  background:
    radial-gradient(circle at 84% 18%, rgba(150,12,38,.12), transparent 30rem),
    linear-gradient(180deg, #f8f5f0, #eee8df);
}

.intro span,
.network span {
  color: #a9823e;
  font-size: .72rem;
  font-weight: 850;
  letter-spacing: .28em;
  text-transform: uppercase;
}

.intro h1 {
  max-width: 980px;
  margin: 1rem 0 0;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3rem, 6vw, 6.4rem);
  font-weight: 300;
  line-height: .95;
  letter-spacing: -.075em;
}

.intro p {
  max-width: 720px;
  margin-top: 1.4rem;
  color: rgba(0,0,0,.62);
  font-size: 1.1rem;
  line-height: 1.8;
}

.editorial {
  padding: 5rem 5vw;
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 5rem;
  border-top: 1px solid rgba(0,0,0,.08);
}

.editorial h2,
.network h2 {
  margin: 0;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(2.4rem, 4vw, 4.8rem);
  font-weight: 320;
  line-height: .98;
  letter-spacing: -.06em;
}

.text p,
.network p {
  color: rgba(0,0,0,.62);
  font-size: 1rem;
  line-height: 1.85;
}

.cards {
  padding: 0 5vw 5rem;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
}

.cards article {
  min-height: 260px;
  padding: 2rem;
  background: rgba(255,255,255,.62);
  border: 1px solid rgba(0,0,0,.07);
  box-shadow: 0 20px 70px rgba(0,0,0,.06);
}

.cards span {
  color: #a50f2d;
  font-weight: 850;
}

.cards h3 {
  margin: 2.2rem 0 .8rem;
  font-size: 1.35rem;
}

.cards p {
  color: rgba(0,0,0,.58);
  line-height: 1.7;
}

.quote {
  padding: 5rem 5vw;
  background: #08090d;
  color: white;
}

.quote blockquote {
  max-width: 1100px;
  margin: 0 auto;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(2.2rem, 4vw, 4.8rem);
  font-weight: 300;
  line-height: 1;
  letter-spacing: -.06em;
  text-align: center;
}

.network {
  padding: 5rem 5vw;
  display: grid;
  grid-template-columns: .9fr 1fr auto;
  gap: 3rem;
  align-items: center;
}

.network a {
  min-width: 220px;
  height: 58px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 18px;
  color: white;
  text-decoration: none;
  font-weight: 800;
  background: linear-gradient(135deg, #8c0b25, #c51338, #72071d);
  box-shadow: 0 20px 60px rgba(120,8,28,.28);
}

@media (max-width: 980px) {
  .editorial,
  .cards,
  .network {
    grid-template-columns: 1fr;
  }

  .intro {
    padding: 9rem 1.3rem 4rem;
  }

  .editorial,
  .quote,
  .network {
    padding: 4rem 1.3rem;
  }

  .cards {
    padding: 0 1.3rem 4rem;
  }
}
