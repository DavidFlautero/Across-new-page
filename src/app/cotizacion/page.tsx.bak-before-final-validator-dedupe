function getCountryOptions(locale: Locale) {
  const localeMap: Record<Locale, string> = {
    es: "es",
    en: "en",
    zh: "zh-Hans",
  };

  const displayNames = new Intl.DisplayNames([localeMap[locale], "en"], {
    type: "region",
  });

  return countryCodes
    .map((code) => ({
      id: code,
      label: displayNames.of(code) || code,
    }))
    .sort((a, b) => a.label.localeCompare(b.label, localeMap[locale]));
}

function getCountryCodeFromValue(value: string, countryOptions: Array<{ id: string; label: string }>) {
  const normalized = value.trim().toLowerCase();

  return (
    countryOptions.find(
      (country) =>
        country.id.toLowerCase() === normalized ||
        country.label.toLowerCase() === normalized
    )?.id || ""
  );
}

function getAirportCountryKey(value: string, countryOptions: Array<{ id: string; label: string }>) {
  const code = getCountryCodeFromValue(value, countryOptions);
  return airportCountryAliases[code] || code;
}

