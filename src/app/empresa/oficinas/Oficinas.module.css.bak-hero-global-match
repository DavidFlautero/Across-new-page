.page {
  min-height: 100vh;
  background: #f4f1eb;
  color: #080b10;
  overflow: hidden;
}

/* =========================
   HERO GLOBAL PREMIUM
   ========================= */

.intro {
  position: absolute;
  z-index: 20;
  top: 15.2rem;
  left: 6vw;
  width: min(920px, 88vw);
  padding: 0;
  background: transparent;
  color: #fff;
}

.intro span {
  display: block;
  margin-bottom: 1rem;
  color: #ed1b2f;
  font-size: .78rem;
  font-weight: 950;
  letter-spacing: .2em;
  text-transform: uppercase;
}

.intro h1 {
  max-width: 920px;
  margin: 0;
  color: #fff;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3.4rem, 5.6vw, 6.7rem);
  font-weight: 900;
  line-height: .9;
  letter-spacing: -.065em;
  text-shadow: 0 22px 70px rgba(0,0,0,.62);
}

.intro h1::after {
  content: ".";
  color: #ed1b2f;
}

.intro p {
  max-width: 720px;
  margin: 1.35rem 0 0;
  color: rgba(255,255,255,.84);
  font-size: clamp(1rem, 1.08vw, 1.15rem);
  line-height: 1.65;
  text-shadow: 0 10px 30px rgba(0,0,0,.48);
}

.introActions {
  display: flex;
  flex-wrap: wrap;
  gap: .9rem;
  margin-top: 1.85rem;
}

.introActions a {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.55rem;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .04em;
}

.introActions a:first-child {
  background: #ed1b2f;
  color: #fff;
  box-shadow: 0 18px 42px rgba(237, 27, 47, .22);
}

.introActions a:first-child::after {
  content: "→";
  margin-left: .75rem;
}

.introActions a:last-child {
  color: #fff;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.28);
}

.heroStrip {
  position: relative;
  z-index: 1;
  height: 720px;
  margin: 0;
  overflow: hidden;
  background: #050609;
}

.heroImage {
  object-fit: cover;
  object-position: center;
  transform: scale(1.03);
  filter: brightness(.88) contrast(1.08) saturate(1.06);
}

.heroOverlay,
.heroStrip::before {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.heroStrip::before {
  content: "";
  z-index: 4;
  background:
    radial-gradient(circle at 72% 42%, rgba(237, 27, 47, .12), transparent 28rem),
    linear-gradient(90deg, rgba(2,4,8,.97) 0%, rgba(2,4,8,.82) 34%, rgba(2,4,8,.44) 62%, rgba(2,4,8,.30) 100%),
    linear-gradient(180deg, rgba(0,0,0,.08) 0%, rgba(0,0,0,.38) 62%, rgba(0,0,0,.72) 100%);
}

.heroOverlay {
  z-index: 3;
  background:
    radial-gradient(circle at 82% 20%, rgba(237, 27, 47, .10), transparent 30rem),
    linear-gradient(180deg, transparent 0%, #f4f1eb 100%);
}

/* =========================
   OFICINAS EN FONDO CLARO
   ========================= */

.grid {
  position: relative;
  z-index: 10;
  padding: clamp(4rem, 6vw, 6rem) 6vw clamp(4.5rem, 6vw, 6.5rem);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1.15rem;
  background:
    radial-gradient(circle at 86% 0%, rgba(237, 27, 47, .07), transparent 28rem),
    linear-gradient(180deg, #f4f1eb 0%, #fbfaf7 100%);
  border-top: 1px solid rgba(8, 11, 16, .08);
}

.card {
  position: relative;
  min-height: 360px;
  overflow: hidden;
  color: #fff;
  text-decoration: none;
  background: #080b10;
  border: 1px solid rgba(8, 11, 16, .10);
  box-shadow:
    0 22px 60px rgba(8, 11, 16, .12),
    inset 0 1px 0 rgba(255,255,255,.08);
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}

.card::after {
  content: "";
  position: absolute;
  left: 1.2rem;
  right: 1.2rem;
  bottom: 0;
  height: 2px;
  z-index: 3;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(237,27,47,.85), transparent);
  box-shadow: 0 0 18px rgba(237,27,47,.35);
  opacity: .55;
}

.card:hover {
  transform: translateY(-7px);
  border-color: rgba(237, 27, 47, .34);
  box-shadow:
    0 34px 90px rgba(8, 11, 16, .18),
    0 0 0 1px rgba(237, 27, 47, .14);
}

.cardImage {
  object-fit: cover;
  transition: transform .6s ease;
}

.card:hover .cardImage {
  transform: scale(1.06);
}

.cardOverlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(circle at 82% 18%, rgba(237,27,47,.18), transparent 15rem),
    linear-gradient(180deg, rgba(0,0,0,.06) 0%, rgba(0,0,0,.42) 38%, rgba(0,0,0,.92) 100%);
}

.cardContent {
  position: absolute;
  inset: auto 0 0;
  z-index: 2;
  padding: 1.45rem;
}

.cardContent small {
  display: block;
  color: #d5a85b;
  font-size: .62rem;
  font-weight: 850;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.cardContent h2 {
  margin: .65rem 0 .65rem;
  color: #fff;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(1.5rem, 1.6vw, 2rem);
  font-weight: 900;
  line-height: 1;
  letter-spacing: -.05em;
  text-shadow: 0 8px 26px rgba(0,0,0,.55);
}

.cardContent p {
  max-height: 4.4em;
  overflow: hidden;
  margin: 0;
  color: rgba(255,255,255,.76);
  font-size: .84rem;
  line-height: 1.48;
  text-shadow: 0 5px 18px rgba(0,0,0,.45);
}

.cardContent strong {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 34px;
  margin-top: .85rem;
  padding: .5rem .8rem;
  color: #fff;
  background: rgba(0,0,0,.62);
  border: 1px solid rgba(255,255,255,.22);
  font-size: .78rem;
  line-height: 1;
  white-space: nowrap;
  backdrop-filter: blur(12px);
}

.cardContent span {
  display: inline-flex;
  margin-left: .55rem;
  margin-top: .9rem;
  color: #ff2d58;
  font-weight: 850;
  font-size: .78rem;
  text-shadow: 0 0 18px rgba(255,45,88,.45);
}

/* =========================
   CTA FINAL GLOBAL
   ========================= */

.networkCta {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto 5.8rem;
  padding: clamp(2rem, 4vw, 3.2rem);
  background:
    radial-gradient(circle at 88% 22%, rgba(237,27,47,.18), transparent 22rem),
    linear-gradient(135deg, #100711 0%, #2b1020 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: 0 24px 80px rgba(0,0,0,.20);
}

.networkCta span {
  display: block;
  margin-bottom: .65rem;
  color: #ed1b2f;
  font-size: .7rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.networkCta h2 {
  max-width: 780px;
  margin: 0;
  color: #fff;
  font-size: clamp(2rem, 3.1vw, 3.6rem);
  line-height: .95;
  letter-spacing: -.055em;
}

.networkCta h2::after {
  content: ".";
  color: #ed1b2f;
}

.networkCta p {
  max-width: 720px;
  margin: .9rem 0 0;
  color: rgba(255,255,255,.74);
  font-size: .95rem;
  line-height: 1.58;
}

.networkCtaActions {
  display: flex;
  align-items: center;
  gap: .75rem;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.networkCtaActions a {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.2rem;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .035em;
}

.networkCtaActions a:first-child {
  background: #ed1b2f;
  color: #fff;
}

.networkCtaActions a:first-child::after {
  content: "→";
  margin-left: .7rem;
}

.networkCtaActions a:last-child {
  color: #fff;
  background: rgba(255,255,255,.10);
  border: 1px solid rgba(255,255,255,.16);
}

/* =========================
   DETALLE OFICINA
   ========================= */

.detail {
  padding: 12rem 5vw 6rem;
  background: #f4f1eb;
  color: #080b10;
}

.back {
  display: inline-flex;
  margin-bottom: 2rem;
  color: #ed1b2f;
  text-decoration: none;
  font-weight: 850;
}

.detail span {
  color: #ed1b2f;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.detail h1 {
  max-width: 980px;
  margin: 1rem 0 0;
  color: #080b10;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3rem, 6vw, 6.6rem);
  font-weight: 900;
  line-height: .92;
  letter-spacing: -.075em;
}

.detailCard {
  max-width: 980px;
  margin-top: 2.5rem;
  padding: 2rem;
  background: rgba(255,255,255,.72);
  border: 1px solid rgba(8,11,16,.08);
  box-shadow:
    0 30px 90px rgba(8,11,16,.10),
    inset 0 1px 0 rgba(255,255,255,.86);
}

.detailCard small {
  color: #a9823e;
  font-weight: 850;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.detailCard p {
  margin: .6rem 0 1.4rem;
  color: rgba(8,11,16,.68);
  line-height: 1.7;
  font-size: 1.05rem;
}

.actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 1.4rem;
}

.actions a {
  min-width: 210px;
  height: 50px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .035em;
}

.actions a:first-child {
  color: #fff;
  background: #ed1b2f;
}

.actions a:last-child {
  color: #080b10;
  border: 1px solid rgba(8,11,16,.12);
  background: rgba(255,255,255,.72);
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 1200px) {
  .grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .intro {
    top: 9.5rem;
    left: 1.2rem;
    width: calc(100vw - 2.4rem);
  }

  .intro h1 {
    font-size: clamp(3rem, 13vw, 4.55rem);
    line-height: .93;
  }

  .intro p {
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.55;
  }

  .heroStrip {
    height: 620px;
  }

  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 3.5rem 1.2rem 4rem;
  }

  .networkCta {
    width: calc(100% - 2.4rem);
    margin-bottom: 4rem;
    flex-direction: column;
    align-items: flex-start;
  }

  .networkCtaActions {
    width: 100%;
  }

  .networkCtaActions a {
    flex: 1;
    min-width: min(100%, 160px);
  }
}

@media (max-width: 560px) {
  .intro {
    top: 8.4rem;
  }

  .intro span {
    font-size: .58rem;
    letter-spacing: .17em;
  }

  .intro h1 {
    font-size: clamp(2.35rem, 11.5vw, 3.25rem);
  }

  .intro p {
    margin-top: 1rem;
    font-size: .86rem;
    line-height: 1.5;
  }

  .introActions {
    display: grid;
    grid-template-columns: 1fr;
    gap: .65rem;
    margin-top: 1.2rem;
  }

  .introActions a {
    width: 100%;
    min-height: 44px;
    font-size: .66rem;
    border-radius: 999px;
  }

  .heroStrip {
    height: 560px;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: .9rem;
    padding: 3rem 18px 3.5rem;
  }

  .card {
    min-height: 310px;
  }

  .cardContent {
    padding: 1.2rem;
  }

  .networkCta {
    width: calc(100% - 2rem);
    padding: 1.45rem;
    margin-bottom: 3.5rem;
  }

  .networkCta h2 {
    font-size: clamp(1.9rem, 9vw, 2.6rem);
  }

  .networkCtaActions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .networkCtaActions a {
    width: 100%;
  }
}
