.page {
  min-height: 100vh;
  background: #f4f1eb;
  color: #080b10;
}

.hero {
  position: relative;
  min-height: clamp(590px, calc(100svh - 28px), 760px);
  padding: clamp(6.8rem, 9vh, 8rem) 6vw clamp(3.2rem, 5vh, 4.6rem);
  display: flex;
  align-items: center;
  overflow: hidden;
  color: #fff;
  background:
    radial-gradient(circle at 72% 42%, rgba(237, 27, 47, .13), transparent 28rem),
    linear-gradient(90deg, rgba(2,4,8,.97) 0%, rgba(2,4,8,.86) 34%, rgba(2,4,8,.50) 62%, rgba(2,4,8,.30) 100%),
    linear-gradient(180deg, rgba(0,0,0,.08) 0%, rgba(0,0,0,.34) 58%, rgba(0,0,0,.72) 100%),
    url("/images/traking/mapahero-deskto.png") center center / cover no-repeat;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(circle at 72% 42%, rgba(237, 27, 47, .10), transparent 28rem),
    linear-gradient(90deg, rgba(2,4,8,.80) 0%, rgba(2,4,8,.62) 42%, rgba(2,4,8,.22) 100%);
}

.heroContent {
  position: relative;
  z-index: 2;
  width: min(820px, 100%);
  color: #fff;
}

.heroContent > span {
  display: block;
  margin-bottom: 1rem;
  color: #ed1b2f;
  font-size: .78rem;
  font-weight: 950;
  letter-spacing: .20em;
  text-transform: uppercase;
}

.heroContent h1 {
  max-width: 820px;
  margin: 0;
  color: #fff;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3.25rem, 5vw, 5.9rem);
  font-weight: 950;
  line-height: .9;
  letter-spacing: -.045em;
}

.heroContent h1::after {
  content: ".";
  color: #ed1b2f;
}

.heroContent > p {
  max-width: 650px;
  margin: 1.35rem 0 0;
  color: rgba(255,255,255,.84);
  font-size: clamp(1rem, 1.08vw, 1.13rem);
  font-weight: 400;
  line-height: 1.68;
}

.searchBox {
  margin-top: 2rem;
  width: min(760px, 100%);
  padding: 1rem;
  border-radius: 26px;
  background: rgba(255,255,255,.11);
  border: 1px solid rgba(255,255,255,.16);
  backdrop-filter: blur(18px);
}

.searchBox label {
  display: grid;
  gap: .65rem;
  color: rgba(255,255,255,.86);
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.searchBox label > div {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: .7rem;
}

.searchBox input {
  min-height: 58px;
  border: 0;
  border-radius: 18px;
  padding: 0 1rem;
  background: rgba(255,255,255,.94);
  color: #111;
  font: inherit;
  outline: none;
  text-transform: uppercase;
}

.searchBox input:focus {
  box-shadow: 0 0 0 4px rgba(225, 19, 67, .22);
}

.searchBox button {
  min-height: 58px;
  border: 0;
  border-radius: 18px;
  padding: 0 1.25rem;
  cursor: pointer;
  color: #fff;
  font-weight: 900;
  background: linear-gradient(135deg, #9d0b28, #e11343);
  box-shadow: 0 20px 48px rgba(140, 8, 30, .32);
}

.searchBox p {
  margin: .75rem 0 0;
  color: #fff;
  font-weight: 800;
}

.trackingShell {
  width: min(1240px, calc(100% - 48px));
  margin: clamp(4rem, 6vw, 6rem) auto clamp(5rem, 7vw, 7rem);
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 1.4rem;
  align-items: start;
}

.mapCard {
  position: relative;
  min-height: 620px;
  overflow: hidden;
  border-radius: 0;
  background: #050609;
  border: 1px solid rgba(8,11,16,.10);
  box-shadow:
    0 32px 100px rgba(8,11,16,.18),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.mapCard iframe {
  display: block;
  width: 100%;
  height: 660px;
  border: 0;
  background: #050609;
}

.helpCard {
  padding: 1.5rem;
  border-radius: 30px;
  background:
    radial-gradient(circle at 100% 0%, rgba(225, 19, 67, .11), transparent 16rem),
    #fff;
  box-shadow: 0 26px 80px rgba(0,0,0,.12);
  border: 1px solid rgba(0,0,0,.07);
}

.helpCard span {
  color: #e11343;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.helpCard h2 {
  margin: .8rem 0 0;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(1.6rem, 2.4vw, 2.25rem);
  font-weight: 950;
  line-height: .95;
  letter-spacing: -.045em;
}

.helpCard p {
  margin: 1rem 0 0;
  color: rgba(0,0,0,.62);
  line-height: 1.6;
}

.helpCard a {
  min-height: 48px;
  margin-top: 1.2rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0 1.1rem;
  color: #fff;
  font-weight: 900;
  text-decoration: none;
  background: #e11343;
}

@media (max-width: 1020px) {
  .trackingShell {
    grid-template-columns: 1fr;
  }

  .helpCard {
    order: -1;
  }
}

@media (max-width: 760px) {
  .hero {
    min-height: auto;
    padding: 5.4rem 22px 2.7rem;
    display: block;
    background:
      radial-gradient(circle at 72% 42%, rgba(237, 27, 47, .13), transparent 22rem),
      linear-gradient(180deg, rgba(2,4,8,.92) 0%, rgba(2,4,8,.68) 50%, rgba(2,4,8,.88) 100%),
      url("/images/traking/mpaa-mobile.png") center center / cover no-repeat;
  }

  .heroContent h1 {
    max-width: 420px;
    font-size: clamp(2.18rem, 9.8vw, 3.1rem);
    line-height: .95;
    letter-spacing: -.04em;
  }

  .heroContent > p {
    max-width: 420px;
    font-size: .9rem;
    line-height: 1.52;
  }

  .searchBox label > div {
    grid-template-columns: 1fr;
  }

  .trackingShell {
    width: calc(100% - 36px);
    margin: 3.2rem auto 5rem;
  }

  .mapCard {
    min-height: 560px;
  }

  .mapCard iframe {
    height: 600px;
  }

  .helpCard {
    border-radius: 24px;
  }
}

@media (max-width: 380px) {
  .hero {
    padding: 5rem 18px 2.4rem;
  }

  .heroContent h1 {
    font-size: clamp(1.9rem, 10vw, 2.4rem);
    letter-spacing: -.035em;
  }

  .heroContent > p {
    font-size: .82rem;
  }

  .trackingShell {
    width: calc(100% - 28px);
  }

  .mapCard iframe {
    height: 560px;
  }
}
