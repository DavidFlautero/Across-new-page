          fill
          priority
          className={`${styles.heroMap} ${styles.heroMapMobile}`}
          sizes="100vw"
        />

        <div className={styles.heroOverlay} />

        <div className={styles.heroContent}>
          <span>{t.eyebrow}</span>
          <h1>{t.title}</h1>
          <p>{t.text}</p>

          <div className={styles.heroActions}>
            <a href="#tracking-panel">{t.primary}</a>
            <Link href="/contacto">{t.secondary}</Link>
          </div>
        </div>
      </section>

      <main className={styles.trackingShell} id="tracking-panel">
        <section className={styles.mapCard}>
          <div className={styles.mapVisual}>
            <Image
