.page {
  min-height: 100vh;
  background: #f4f1eb;
  color: #111;
}

.hero {
  position: relative;
  min-height: 62vh;
  display: flex;
  align-items: center;
  padding: 10rem 5vw 8rem;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(3, 4, 8, 0.94), rgba(3, 4, 8, 0.62), rgba(44, 4, 18, 0.24)),
    url("/images/hero/contactoimagen.png") center / cover no-repeat;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 82% 20%, rgba(225, 19, 67, 0.26), transparent 32rem),
    linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.72));
}

.heroContent {
  position: relative;
  z-index: 2;
  width: min(920px, 100%);
  color: #fff;
}

.heroContent > span {
  color: #ff405e;
  font-size: 0.75rem;
  font-weight: 900;
  letter-spacing: 0.26em;
  text-transform: uppercase;
}

.heroContent h1 {
  max-width: 860px;
  margin: 1rem 0 0;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3rem, 6vw, 6.8rem);
  font-weight: 380;
  line-height: 0.96;
  letter-spacing: -0.05em;
}

.heroContent > p {
  max-width: 650px;
  margin: 1.35rem 0 0;
  color: rgba(255, 255, 255, 0.76);
  font-size: 1.05rem;
  line-height: 1.7;
}

.searchBox {
  margin-top: 2rem;
  width: min(760px, 100%);
  padding: 1rem;
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.11);
  border: 1px solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(18px);
}

.searchBox label {
  display: grid;
  gap: 0.65rem;
  color: rgba(255, 255, 255, 0.86);
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.searchBox label > div {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.7rem;
}

.searchBox input {
  min-height: 58px;
  border: 0;
  border-radius: 18px;
  padding: 0 1rem;
  background: rgba(255, 255, 255, 0.94);
  color: #111;
  font: inherit;
  outline: none;
  text-transform: uppercase;
}

.searchBox input:focus {
  box-shadow: 0 0 0 4px rgba(225, 19, 67, 0.22);
}

.searchBox button {
  min-height: 58px;
  border: 0;
  border-radius: 18px;
  padding: 0 1.25rem;
  cursor: pointer;
  color: #fff;
  font-weight: 900;
  background: linear-gradient(135deg, #9d0b28, #e11343f2);
  box-shadow: 0 20px 48px rgba(140, 8, 30, 0.32);
}

.searchBox p {
  margin: 0.75rem 0 0;
  color: #fff;
  font-weight: 800;
}

.trackingShell {
  width: min(1420px, calc(100% - 7vw));
  margin: -5rem auto 6rem;
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 1.4rem;
  align-items: start;
}

.mapCard {
  min-height: 560px;
  border-radius: 34px;
  overflow: hidden;
  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 38px 110px rgba(20, 16, 12, 0.22);
}

.mapCard iframe {
  display: block;
  width: 100%;
  height: 620px;
  border: 0;
}

.helpCard {
  padding: 1.5rem;
  border-radius: 30px;
  background:
    radial-gradient(circle at 100% 0%, rgba(225, 19, 67, 0.11), transparent 16rem),
    #fff;
  box-shadow: 0 26px 80px rgba(0, 0, 0, 0.12);
  border: 1px solid rgba(0, 0, 0, 0.07);
}

.helpCard span {
  color: #e11343f2;
  font-size: 0.72rem;
  font-weight: 950;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.helpCard h2 {
  margin: 0.8rem 0 0;
  font-size: clamp(1.6rem, 2.4vw, 2.25rem);
  line-height: 1;
  letter-spacing: -0.045em;
}

.helpCard p {
  margin: 1rem 0 0;
  color: rgba(0, 0, 0, 0.62);
  line-height: 1.6;
}

.helpCard a {
  min-height: 48px;
  margin-top: 1.2rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0 1.1rem;
  color: #fff;
  font-weight: 900;
  text-decoration: none;
  background: #e11343f2;
}

@media (max-width: 1020px) {
  .trackingShell {
    grid-template-columns: 1fr;
  }

  .helpCard {
    order: -1;
  }
}

@media (max-width: 700px) {
  .hero {
    min-height: 68vh;
    padding: 8rem 1rem 7rem;
  }

  .heroContent h1 {
    font-size: clamp(2.55rem, 13vw, 4.2rem);
    letter-spacing: -0.038em;
  }

  .searchBox label > div {
    grid-template-columns: 1fr;
  }

  .trackingShell {
    width: calc(100% - 1.2rem);
    margin-top: -3.8rem;
  }

  .mapCard {
    min-height: 500px;
    border-radius: 24px;
  }

  .mapCard iframe {
    height: 560px;
  }

  .helpCard {
    border-radius: 24px;
  }
}
