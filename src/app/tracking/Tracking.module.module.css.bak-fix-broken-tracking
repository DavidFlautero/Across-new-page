    font-size: clamp(1.9rem, 10vw, 2.4rem) !important;
  }

  .heroContent p {
    font-size: .82rem !important;
  }
}


/* === TRACKING HERO - aire sutil entre letras del título === */
.heroContent h1 {
  letter-spacing: -.045em !important;
}

/* En mobile menos aire para que no se rompan las líneas */
@media (max-width: 760px) {
  .heroContent h1 {
    letter-spacing: -.04em !important;
  }
}

@media (max-width: 380px) {
  .heroContent h1 {
    letter-spacing: -.035em !important;
  }
}

/* =====================================================
   HERO IMAGE STARTS AT TOP UNDER HEADER
   La imagen del hero empieza desde top:0.
   El header queda encima. El padding solo mueve el texto, no la imagen.
   ===================================================== */

@media (max-width: 760px) {
  .hero {
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
    background: #050609 !important;
  }

  .heroImage,
  .heroImageDesktop,
  .heroImageMobile {
    position: absolute !important;
    inset: 0 !important;

    width: 100% !important;
    height: 100% !important;

    object-fit: cover !important;
    object-position: center top !important;

    z-index: 0 !important;
    transform: none !important;
    translate: none !important;
  }

  .heroImageDesktop {
    display: none !important;
  }

  .heroImageMobile {
    display: block !important;
  }

  .heroOverlay {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    pointer-events: none !important;
  }

  .heroInner,
  .heroContent,
  .actions {
    position: relative !important;
    z-index: 2 !important;
  }
}

/* END HERO IMAGE STARTS AT TOP UNDER HEADER */


