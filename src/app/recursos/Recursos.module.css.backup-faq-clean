/* === FAQ REDISEÑO FINAL START === */

/*
  FAQ de Recursos:
  ancho limpio, jerarquía clara y sin elementos negros duplicados.
*/

.faqSection {
  width: min(1120px, calc(100% - 48px)) !important;
  max-width: 1120px !important;
  margin: 0 auto !important;
  padding: clamp(4rem, 7vw, 7rem) 0 !important;
  display: block !important;
}

/* Encabezado */
.faqSection > span,
.faqSection > div > span {
  color: #b80d2f !important;
  font-size: .7rem !important;
  line-height: 1 !important;
  font-weight: 950 !important;
  letter-spacing: .18em !important;
  text-transform: uppercase !important;
}

.faqSection h2 {
  width: 100% !important;
  max-width: 760px !important;
  margin: 0 0 2.5rem !important;
  padding: 0 !important;

  color: #090b10 !important;
  font-size: clamp(2.8rem, 5vw, 5rem) !important;
  line-height: .92 !important;
  letter-spacing: -.06em !important;
  font-weight: 950 !important;
  text-align: left !important;
  text-wrap: balance !important;
}

/* Cada pregunta pasa a ser una fila limpia */
.faqSection details {
  position: relative !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  border: 0 !important;
  border-top: 1px solid rgba(8, 11, 16, .16) !important;
  border-radius: 0 !important;

  background: transparent !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.faqSection details:last-of-type {
  border-bottom: 1px solid rgba(8, 11, 16, .16) !important;
}

/* Fila de pregunta */
.faqSection summary {
  position: relative !important;

  width: 100% !important;
  min-height: 86px !important;

  margin: 0 !important;
  padding: 1.25rem 4.5rem 1.25rem 0 !important;

  display: grid !important;
  grid-template-columns: 46px minmax(0, 1fr) !important;
  align-items: center !important;
  gap: 1rem !important;

  list-style: none !important;
  cursor: pointer !important;
  box-sizing: border-box !important;
}

.faqSection summary::-webkit-details-marker {
  display: none !important;
}

/*
  Usa el número que ya existe en el JSX.
  No genera otro número con ::before.
*/
.faqSection summary > :first-child {
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #b80d2f !important;
  font-size: .67rem !important;
  line-height: 1 !important;
  letter-spacing: .12em !important;
  font-weight: 950 !important;
  text-align: left !important;
}

/* Texto de la pregunta */
.faqSection summary h3,
.faqSection summary p,
.faqSection summary > span:not(:first-child):not(:empty),
.faqSection summary > strong {
  width: auto !important;
  max-width: 850px !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #090b10 !important;
  font-size: clamp(1rem, 1.35vw, 1.2rem) !important;
  line-height: 1.25 !important;
  letter-spacing: -.02em !important;
  font-weight: 850 !important;

  white-space: normal !important;
  word-break: normal !important;
  overflow-wrap: normal !important;
  text-align: left !important;
}

/*
  Elimina los spans/i/b vacíos que producían
  las barras y cuadrados negros sobrantes.
*/
.faqSection summary > span:empty,
.faqSection summary > i:empty,
.faqSection summary > b:empty,
.faqSection summary > em:empty {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  min-width: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
}

/* Botón propio + / − */
.faqSection summary::after {
  content: "+" !important;

  position: absolute !important;
  right: 0 !important;
  top: 50% !important;
  transform: translateY(-50%) !important;

  width: 38px !important;
  height: 38px !important;

  display: grid !important;
  place-items: center !important;

  border: 0 !important;
  border-radius: 999px !important;

  background: #0b1118 !important;
  color: #fff !important;

  font-size: 1rem !important;
  line-height: 1 !important;
  font-weight: 900 !important;
}

.faqSection details[open] summary::after {
  content: "−" !important;
}

/* Respuesta */
.faqSection details > p,
.faqSection details > div {
  max-width: 820px !important;

  margin: 0 0 1.6rem 62px !important;
  padding: 0 !important;

  color: rgba(8, 11, 16, .7) !important;
  font-size: .96rem !important;
  line-height: 1.65 !important;
}

/* Evita que alguna regla vieja vuelva a dibujar iconos */
.faqSection details::before,
.faqSection details::after,
.faqSection summary > *::before,
.faqSection summary > *::after {
  box-shadow: none !important;
}

/* Responsive */
@media (max-width: 700px) {
  .faqSection {
    width: calc(100% - 32px) !important;
    padding: 3.5rem 0 !important;
  }

  .faqSection h2 {
    margin-bottom: 1.7rem !important;
    font-size: clamp(2.4rem, 12vw, 3.4rem) !important;
  }

  .faqSection summary {
    min-height: 76px !important;
    padding: 1rem 3.2rem 1rem 0 !important;
    grid-template-columns: 34px minmax(0, 1fr) !important;
    gap: .65rem !important;
  }

  .faqSection summary > :first-child {
    font-size: .58rem !important;
  }

  .faqSection summary h3,
  .faqSection summary p,
  .faqSection summary > span:not(:first-child):not(:empty),
  .faqSection summary > strong {
    font-size: .96rem !important;
  }

  .faqSection summary::after {
    width: 32px !important;
    height: 32px !important;
  }

  .faqSection details > p,
  .faqSection details > div {
    margin-left: 40px !important;
    font-size: .9rem !important;
  }
}

/* === FAQ REDISEÑO FINAL END === */

