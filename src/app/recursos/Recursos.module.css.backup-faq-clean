.page {
  width: 100%;
  overflow: hidden;
  background: #f4f1eb;
  color: #080b10;
}

.content {
  width: min(1240px, calc(100% - 48px));
  margin: 0 auto;
  padding: clamp(4rem, 6vw, 6rem) 0;
}

/* =========================
   FAQ ENTERPRISE
   ========================= */

.faqSection {
  position: relative;
}

.sectionHead {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(340px, .65fr);
  gap: clamp(2rem, 5vw, 5rem);
  align-items: end;
}

.sectionHead h2,
.downloadCopy h2,
.contactCta h2 {
  margin: 0;
  color: #080b10;
  font-size: clamp(2.4rem, 4vw, 4.8rem);
  line-height: .96;
  letter-spacing: -.06em;
}

.sectionHead h2::after,
.downloadCopy h2::after {
  content: ".";
  color: #ed1b2f;
}

.faqGrid {
  margin-top: 2.4rem;
  display: grid;
  gap: .8rem;
}

.faqItem {
  background: rgba(255,255,255,.76);
  border: 1px solid rgba(8,11,16,.08);
  box-shadow:
    0 18px 55px rgba(8,11,16,.06),
    inset 0 1px 0 rgba(255,255,255,.80);
  overflow: hidden;
}

.faqItem summary {
  cursor: pointer;
  list-style: none;
  min-height: 84px;
  padding: 1.2rem 1.35rem;
  display: grid;
  grid-template-columns: 62px 1fr 38px;
  gap: 1rem;
  align-items: center;
}

.faqItem summary::-webkit-details-marker {
  display: none;
}

.faqItem summary strong {
  color: #ed1b2f;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .16em;
}

.faqItem h3 {
  margin: 0;
  color: #080b10;
  font-size: clamp(1.05rem, 1.6vw, 1.35rem);
  line-height: 1.15;
  letter-spacing: -.035em;
}

.faqItem summary span {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  background: #080b10;
  color: #fff;
  font-weight: 950;
  transition: transform .2s ease, background .2s ease;
}

.faqItem[open] summary span {
  transform: rotate(45deg);
  background: #ed1b2f;
}

.faqItem p {
  margin: 0;
  padding: 0 1.35rem 1.45rem calc(62px + 2.35rem);
  color: rgba(8,11,16,.66);
  font-size: .95rem;
  line-height: 1.72;
}

/* =========================
   DOWNLOADS
   ========================= */

.downloads {
  margin-top: clamp(4.5rem, 7vw, 7rem);
  display: grid;
  grid-template-columns: minmax(360px, .9fr) minmax(0, 1.1fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: stretch;
}

.downloadImage {
  position: relative;
  min-height: 620px;
  overflow: hidden;
  background: #080b10;
  border: 1px solid rgba(8,11,16,.08);
  box-shadow: 0 28px 90px rgba(8,11,16,.15);
}

.secondImage {
  object-fit: cover;
  filter: brightness(.88) contrast(1.06) saturate(1.04);
}

.downloadCopy {
  padding: clamp(2rem, 4vw, 3.5rem);
  background:
    radial-gradient(circle at 90% 0%, rgba(237,27,47,.08), transparent 28rem),
    rgba(255,255,255,.82);
  border: 1px solid rgba(8,11,16,.08);
  box-shadow:
    0 26px 80px rgba(8,11,16,.10),
    inset 0 1px 0 rgba(255,255,255,.85);
}

.downloadCopy h2 {
  max-width: 720px;
}

.originalResources {
  margin-top: 2.4rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(1.6rem, 3vw, 2.6rem);
}

.resourceColumn h3 {
  margin: 0 0 1.25rem;
  color: #080b10;
  font-size: .78rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.resourceColumn a {
  min-height: 72px;
  padding: 1.05rem 0;
  border-bottom: 1px solid rgba(237,27,47,.42);
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1.2rem;
  align-items: center;
  color: #080b10;
  text-decoration: none;
  transition: border-color .2s ease, color .2s ease;
}

.resourceColumn a span {
  color: #080b10;
  font-size: .98rem;
  line-height: 1.25;
  font-weight: 850;
}

.resourceColumn a strong {
  color: #ed1b2f;
  font-size: .78rem;
  font-weight: 950;
  white-space: nowrap;
}

.resourceColumn a:hover {
  border-color: #080b10;
}

.resourceColumn a:hover span {
  color: #ed1b2f;
}

.downloadCards {
  margin-top: 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.downloadCard {
  min-height: 190px;
  padding: 1.4rem;
  background: #fff;
  color: #080b10;
  text-decoration: none;
  border: 1px solid rgba(8,11,16,.08);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.downloadBadge {
  width: fit-content;
  display: inline-flex;
  padding: .38rem .6rem;
  background: #ed1b2f;
  color: #fff;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .12em;
}

/* =========================
   CTA CONTACTO
   ========================= */

.contactCta {
  margin-top: clamp(4.5rem, 7vw, 7rem);
  padding: clamp(2.2rem, 4.5vw, 3.7rem);
  display: grid;
  grid-template-columns: 1fr;
  align-items: start;
  background:
    radial-gradient(circle at 84% 0%, rgba(237,27,47,.20), transparent 30rem),
    linear-gradient(135deg, #08090d 0%, #250713 100%);
  color: #fff;
  box-shadow: 0 28px 90px rgba(8,11,16,.18);
}

.contactCta span {
  color: #ed1b2f;
}

.contactCta h2 {
  max-width: 760px;
  color: #fff;
}

.contactCta h2::after {
  content: ".";
  color: #ed1b2f;
}

.contactCta p {
  max-width: 760px;
  margin: 1rem 0 0;
  color: rgba(255,255,255,.76);
  font-size: .98rem;
  line-height: 1.65;
}

.phoneGrid {
  width: 100%;
  margin-top: 2rem;
  margin-bottom: 1.8rem;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .9rem;
}

.phoneGrid article {
  padding: 1.1rem;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.11);
}

.phoneGrid small,
.phoneGrid strong {
  display: block;
}

.phoneGrid small {
  color: rgba(255,255,255,.62);
  font-size: .68rem;
  font-weight: 950;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.phoneGrid strong {
  margin-top: .45rem;
  color: #fff;
  font-size: .95rem;
}

.contactCta > a {
  width: fit-content;
  min-width: 260px;
  margin-top: 0;
  justify-self: start;
}

/* =========================
   CTA BUTTONS LOCAL
   ========================= */

.finalActions a,
.darkBandActions a,
.contactCta > a {
  min-height: 54px;
  padding: 0 1.65rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .65rem;
  border-radius: 999px;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: .075em;
  font-size: .78rem;
  font-weight: 950;
  line-height: 1;
  transition:
    transform .22s ease,
    box-shadow .22s ease,
    border-color .22s ease,
    background .22s ease,
    color .22s ease;
}

.finalActions a:first-child,
.darkBandActions a:first-child,
.contactCta > a {
  color: #fff;
  background:
    linear-gradient(135deg, #f0183d 0%, #d70c31 52%, #b70627 100%);
  border: 1px solid rgba(255,255,255,.08);
  box-shadow:
    0 22px 52px rgba(225, 19, 67, .28),
    inset 0 1px 0 rgba(255,255,255,.22);
}

.finalActions a:last-child,
.darkBandActions a:last-child {
  color: rgba(255,255,255,.94);
  background:
    linear-gradient(135deg, rgba(255,255,255,.08), rgba(255,255,255,.035));
  border: 1px solid rgba(255,255,255,.24);
  box-shadow:
    0 18px 42px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.10);
  backdrop-filter: blur(8px);
}

.finalActions a:first-child::after,
.darkBandActions a:first-child::after {
  content: "→";
  font-size: .95rem;
  line-height: 1;
  transform: translateY(-1px);
}

@media (hover: hover) {
  .finalActions a:hover,
  .darkBandActions a:hover,
  .contactCta > a:hover {
    transform: translateY(-2px);
  }

  .finalActions a:first-child:hover,
  .darkBandActions a:first-child:hover,
  .contactCta > a:hover {
    box-shadow:
      0 28px 70px rgba(225, 19, 67, .36),
      inset 0 1px 0 rgba(255,255,255,.26);
  }

  .finalActions a:last-child:hover,
  .darkBandActions a:last-child:hover {
    border-color: rgba(255,255,255,.42);
    background:
      linear-gradient(135deg, rgba(255,255,255,.13), rgba(255,255,255,.055));
  }
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 1100px) {
  .sectionHead,
  .downloads {
    grid-template-columns: 1fr;
  }

  .downloadImage {
    min-height: 360px;
  }

  .phoneGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 761px) and (max-width: 1180px) {
  .phoneGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem;
  }

  .contactCta > a {
    margin-top: .35rem;
  }
}

@media (max-width: 760px) {
  .content {
    width: calc(100% - 36px);
    padding: 3.2rem 0;
  }

  .sectionHead h2,
  .downloadCopy h2,
  .contactCta h2 {
    font-size: clamp(1.95rem, 8.8vw, 2.75rem);
  }

  .faqItem summary {
    min-height: auto;
    grid-template-columns: 42px 1fr 34px;
    gap: .8rem;
    padding: 1rem;
  }

  .faqItem summary strong {
    font-size: .68rem;
  }

  .faqItem h3 {
    font-size: .94rem;
  }

  .faqItem p {
    padding: 0 1rem 1.1rem;
    font-size: .84rem;
    line-height: 1.55;
  }

  .downloadImage {
    min-height: 240px;
    height: 240px;
  }

  .downloadCopy {
    padding: 1.45rem;
  }

  .originalResources {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .resourceColumn a {
    grid-template-columns: 1fr;
    align-items: flex-start;
    gap: .35rem;
  }

  .downloadCards {
    grid-template-columns: 1fr;
  }

  .contactCta {
    padding: 1.55rem;
  }

  .phoneGrid {
    grid-template-columns: 1fr;
    margin-bottom: 1.4rem;
  }

  .contactCta > a {
    width: 100%;
    min-width: 0;
    justify-self: stretch;
    margin-top: 1.4rem;
  }

  .finalActions,
  .darkBandActions {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: .75rem;
  }

  .finalActions a,
  .darkBandActions a {
    width: 100%;
    min-height: 52px;
    padding: 0 1.2rem;
    font-size: .74rem;
    letter-spacing: .065em;
  }
}

@media (max-width: 380px) {
  .content {
    width: calc(100% - 28px);
  }

  .finalActions a,
  .darkBandActions a {
    min-height: 50px;
    font-size: .7rem;
  }
}

