.page {
  background: #f4f4f4;
  color: #090b10;
  overflow: hidden;
}

.hero {
  position: relative;
  min-height: 78vh;
  display: flex;
  align-items: center;
  padding: 8.5rem 6vw 5.5rem;
  isolation: isolate;
  background: #05070b;
  color: #fff;
  overflow: hidden;
}

.heroImage {
  object-fit: cover;
  z-index: -3;
}

.heroImageMobile {
  display: none;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(90deg, rgba(2, 4, 8, .96) 0%, rgba(2, 4, 8, .82) 34%, rgba(2, 4, 8, .28) 72%, rgba(2, 4, 8, .14) 100%),
    linear-gradient(180deg, rgba(0, 0, 0, .14) 0%, rgba(0, 0, 0, .68) 100%);
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 90px;
  background: linear-gradient(180deg, transparent, #07101a);
  z-index: -1;
}

.heroInner {
  width: min(1180px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 3rem;
  align-items: center;
}

.heroContent {
  max-width: 760px;
}

.eyebrow {
  display: inline-flex;
  margin-bottom: 1rem;
  color: #173247;
  font-size: .78rem;
  font-weight: 950;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.heroContent h1 {
  margin: 0;
  max-width: 760px;
  font-size: clamp(2.6rem, 5.5vw, 5.6rem);
  line-height: .92;
  letter-spacing: -.065em;
  font-weight: 950;
}

.heroContent p {
  max-width: 650px;
  margin: 1.45rem 0 0;
  color: rgba(255, 255, 255, .82);
  font-size: clamp(1rem, 1.3vw, 1.14rem);
  line-height: 1.72;
}

.actions,
.finalActions {
  display: flex;
  flex-wrap: wrap;
  gap: .9rem;
  margin-top: 2rem;
}

.actions a,
.finalActions a,
.overviewCopy a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 1.25rem;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .78rem;
  letter-spacing: .03em;
  font-weight: 950;
}

.actions a:first-child,
.finalActions a:first-child,
.overviewCopy a {
  background: #173247;
  color: #fff;
  box-shadow: 0 18px 42px rgba(23, 50, 71, .28);
}

.actions a:first-child::after,
.finalActions a:first-child::after,
.overviewCopy a::after {
  content: "→";
  margin-left: .7rem;
}

.actions a:last-child,
.finalActions a:last-child {
  color: #fff;
  border: 1px solid rgba(255, 255, 255, .34);
  background: rgba(255, 255, 255, .06);
  backdrop-filter: blur(12px);
}

.operationCard {
  justify-self: end;
  width: min(100%, 340px);
  padding: 2rem;
  background: rgba(255, 255, 255, .96);
  color: #080b10;
  border: 1px solid rgba(255, 255, 255, .5);
  box-shadow: 0 28px 90px rgba(0, 0, 0, .28);
}

.operationCard > span {
  display: inline-flex;
  margin-bottom: 1rem;
  color: #173247;
  font-size: .7rem;
  font-weight: 950;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.operationCard > span::before {
  content: "✈";
  margin-right: .65rem;
  color: #070a10;
}

.operationCard strong {
  display: block;
  font-size: 1.75rem;
  line-height: 1;
  letter-spacing: -.04em;
}

.operationCard p {
  margin: 1.35rem 0;
  color: #161a22;
  font-weight: 650;
}

.operationCard div {
  display: flex;
  align-items: center;
  gap: .8rem;
  margin-top: .7rem;
}

.operationCard small {
  color: #4b5563;
  font-weight: 800;
}

.operationCard b,
.operationCard em {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 0 .65rem;
  border-radius: 999px;
  font-size: .72rem;
  font-style: normal;
  font-weight: 950;
}

.operationCard b {
  background: #173247;
  color: #fff;
}

.operationCard em {
  background: #080b10;
  color: #fff;
}

.trustBar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #07101a;
  color: #fff;
  border-top: 1px solid rgba(255, 255, 255, .08);
  border-bottom: 1px solid rgba(255, 255, 255, .08);
}

.trustBar div {
  min-height: 96px;
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.3rem 6vw;
  border-right: 1px solid rgba(255, 255, 255, .16);
}

.trustBar div:last-child {
  border-right: 0;
}

.trustBar i {
  display: inline-grid;
  place-items: center;
  width: 36px;
  height: 36px;
  color: #173247;
  border: 1px solid rgba(23, 50, 71, .55);
  border-radius: 999px;
  font-style: normal;
  font-weight: 900;
}

.trustBar strong,
.trustBar small {
  display: block;
}

.trustBar strong {
  text-transform: uppercase;
  font-size: .78rem;
  letter-spacing: .05em;
}

.trustBar small {
  margin-top: .22rem;
  color: rgba(255, 255, 255, .72);
  font-size: .82rem;
}

.overview {
  width: min(1180px, calc(100% - 40px));
  margin: 5rem auto;
  display: grid;
  grid-template-columns: .88fr 1.12fr;
  gap: 4rem;
  align-items: center;
}

.overviewCopy h2,
.sectionHead h2,
.darkBandContent h2,
.finalCta h2 {
  margin: 0;
  color: #080b10;
  font-size: clamp(2rem, 3.5vw, 3.7rem);
  line-height: 1;
  letter-spacing: -.055em;
  font-weight: 950;
}

.overviewCopy p {
  margin: 1.35rem 0 0;
  color: rgba(8, 11, 16, .74);
  font-size: 1rem;
  line-height: 1.72;
}

.overviewCopy a {
  margin-top: 1.8rem;
}

.pillars {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  align-items: stretch;
}

.pillars article {
  min-height: 220px;
  padding: 1.6rem 1.25rem;
  border-left: 1px solid rgba(8, 11, 16, .12);
  text-align: center;
}

.pillars i,
.serviceGrid i,
.useCaseGrid i {
  display: inline-grid;
  place-items: center;
  width: 48px;
  height: 48px;
  margin-bottom: 1.1rem;
  color: #173247;
  border: 1px solid rgba(23, 50, 71, .5);
  border-radius: 999px;
  font-style: normal;
  font-size: 1.3rem;
  font-weight: 900;
}

.pillars h3,
.serviceGrid h3,
.useCaseGrid h3,
.processGrid h3 {
  margin: 0;
  color: #080b10;
  font-size: 1rem;
  line-height: 1.15;
  letter-spacing: -.025em;
  font-weight: 950;
}

.pillars p,
.serviceGrid p,
.useCaseGrid p,
.processGrid p {
  margin: .8rem 0 0;
  color: rgba(8, 11, 16, .68);
  font-size: .92rem;
  line-height: 1.58;
}

.services,
.useCases,
.process {
  width: min(1180px, calc(100% - 40px));
  margin: 5.2rem auto;
}

.sectionHead {
  max-width: 780px;
  margin: 0 auto 2.2rem;
  text-align: center;
}

.serviceGrid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  border: 1px solid rgba(8, 11, 16, .12);
  background: #fff;
  box-shadow: 0 22px 80px rgba(0, 0, 0, .055);
}

.serviceGrid article {
  min-height: 260px;
  padding: 1.7rem 1.25rem;
  text-align: center;
  border-right: 1px solid rgba(8, 11, 16, .1);
}

.serviceGrid article:last-child {
  border-right: 0;
}

.useCaseGrid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 0;
}

.useCaseGrid article {
  min-height: 210px;
  padding: 1.5rem 1rem;
  text-align: center;
  border-right: 1px solid rgba(8, 11, 16, .11);
}

.useCaseGrid article:last-child {
  border-right: 0;
}

.process {
  padding-top: 1rem;
}

.processGrid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 0;
  position: relative;
}

.processGrid::before {
  content: "";
  position: absolute;
  top: 28px;
  left: 6%;
  right: 6%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(8, 11, 16, .22), transparent);
}

.processGrid article {
  position: relative;
  min-height: 170px;
  padding: 0 1rem;
  text-align: left;
}

.processGrid strong {
  position: relative;
  z-index: 2;
  display: inline-grid;
  place-items: center;
  width: 56px;
  height: 56px;
  margin-bottom: 1rem;
  border-radius: 999px;
  background: #173247;
  color: #fff;
  font-weight: 950;
  box-shadow: 0 14px 38px rgba(23, 50, 71, .24);
}

.darkBand {
  width: 100%;
  min-height: 360px;
  display: grid;
  grid-template-columns: .48fr .52fr;
  background: #07101a;
  color: #fff;
  overflow: hidden;
}

.darkBandImage {
  position: relative;
  min-height: 360px;
}

.darkBandImage img {
  object-fit: cover;
  filter: brightness(.66) contrast(1.08) saturate(1.05);
}

.darkBandContent {
  padding: clamp(3rem, 5vw, 5rem) 6vw;
  align-self: center;
}

.darkBandContent h2 {
  color: #fff;
  max-width: 680px;
}

.darkBandContent p {
  max-width: 680px;
  margin: 1.25rem 0 0;
  color: rgba(255, 255, 255, .76);
  font-size: 1rem;
  line-height: 1.72;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  margin-top: 2.4rem;
}

.stats article {
  padding: 0 1.2rem;
  border-right: 1px solid rgba(255, 255, 255, .16);
}

.stats article:first-child {
  padding-left: 0;
}

.stats article:last-child {
  border-right: 0;
}

.stats strong {
  display: block;
  color: #173247;
  text-transform: uppercase;
  font-size: .86rem;
  line-height: 1.15;
  letter-spacing: .06em;
}

.stats span {
  display: block;
  margin-top: .7rem;
  color: rgba(255, 255, 255, .78);
  font-size: .82rem;
  line-height: 1.45;
  font-weight: 700;
}

.finalCta {
  width: 100%;
  min-height: 360px;
  display: grid;
  grid-template-columns: .52fr .48fr;
  background: #fff;
}

.finalCta > div:first-child {
  padding: clamp(3rem, 5vw, 5rem) 6vw;
  align-self: center;
}

.finalCta p {
  max-width: 620px;
  margin: 1.1rem 0 0;
  color: rgba(8, 11, 16, .72);
  line-height: 1.65;
}

.finalActions a:last-child {
  color: #080b10;
  border-color: rgba(8, 11, 16, .18);
  background: #fff;
}

.finalImage {
  position: relative;
  min-height: 360px;
  overflow: hidden;
}

.finalImage img {
  object-fit: cover;
  filter: brightness(1.03) contrast(1.04) saturate(1.02);
}

@media (max-width: 1180px) {
  .heroInner {
    grid-template-columns: 1fr;
  }

  .operationCard {
    justify-self: start;
  }

  .overview {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .pillars {
    grid-template-columns: repeat(2, 1fr);
  }

  .serviceGrid,
  .useCaseGrid,
  .processGrid {
    grid-template-columns: repeat(3, 1fr);
  }

  .serviceGrid article:nth-child(3),
  .serviceGrid article:nth-child(6),
  .useCaseGrid article:nth-child(3),
  .useCaseGrid article:nth-child(6) {
    border-right: 0;
  }

  .processGrid {
    gap: 1.6rem;
  }

  .processGrid::before {
    display: none;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .stats article {
    border-right: 0;
    padding: 0;
  }
}

@media (max-width: 900px) {
  .hero {
    min-height: 74vh;
    padding: 7rem 22px 4rem;
  }

  .heroImageDesktop {
    display: none;
  }

  .heroImageMobile {
    display: block;
  }

  .heroOverlay {
    background:
      linear-gradient(180deg, rgba(2, 4, 8, .78) 0%, rgba(2, 4, 8, .94) 70%, rgba(2, 4, 8, .98) 100%);
  }

  .operationCard {
    display: none;
  }

  .trustBar {
    grid-template-columns: 1fr 1fr;
  }

  .trustBar div {
    min-height: 88px;
    padding: 1.1rem 20px;
  }

  .overview,
  .services,
  .useCases,
  .process {
    width: min(100% - 28px, 720px);
    margin: 3.7rem auto;
  }

  .pillars,
  .serviceGrid,
  .useCaseGrid,
  .processGrid,
  .darkBand,
  .finalCta {
    grid-template-columns: 1fr;
  }

  .pillars article,
  .serviceGrid article,
  .useCaseGrid article {
    border-right: 0;
    border-left: 0;
    border-bottom: 1px solid rgba(8, 11, 16, .1);
  }

  .serviceGrid article,
  .useCaseGrid article {
    min-height: auto;
    padding: 1.6rem 1.2rem;
  }

  .processGrid article {
    min-height: auto;
    padding: 0;
  }

  .darkBandImage,
  .finalImage {
    min-height: 260px;
  }

  .finalImage {
    order: -1;
  }
}

@media (max-width: 560px) {
  .heroContent h1 {
    font-size: clamp(2.25rem, 13vw, 3.55rem);
  }

  .heroContent p {
    font-size: .96rem;
  }

  .actions,
  .finalActions {
    width: 100%;
  }

  .actions a,
  .finalActions a,
  .overviewCopy a {
    width: 100%;
  }

  .trustBar {
    grid-template-columns: 1fr;
  }

  .trustBar div {
    border-right: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .12);
  }

  .overviewCopy h2,
  .sectionHead h2,
  .darkBandContent h2,
  .finalCta h2 {
    font-size: clamp(2rem, 10vw, 3rem);
  }

  .stats {
    grid-template-columns: 1fr;
  }
}

/* === REAL SVG ICON SYSTEM === */
.trustBar i svg,
.pillars i svg,
.serviceGrid i svg,
.useCaseGrid i svg,
.processGrid i svg {
  width: 100%;
  height: 100%;
  display: block;
}

.pillars i,
.serviceGrid i,
.useCaseGrid i {
  background: rgba(23, 50, 71, .035);
}

.trustBar i {
  background: rgba(23, 50, 71, .06);
}

.processGrid i {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  margin-bottom: .8rem;
  color: #111827;
}

.processGrid article {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.processGrid strong {
  margin-bottom: .8rem;
}

/* Desktop: que los 6 servicios respiren mejor */
@media (min-width: 1181px) {
  .serviceGrid article {
    min-height: 245px;
  }

  .useCaseGrid article {
    min-height: 205px;
  }

  .serviceGrid h3,
  .useCaseGrid h3 {
    max-width: 150px;
    margin-left: auto;
    margin-right: auto;
  }

  .serviceGrid p,
  .useCaseGrid p {
    max-width: 170px;
    margin-left: auto;
    margin-right: auto;
  }
}

/* Laptop: no apretar 6 columnas */
@media (max-width: 1180px) and (min-width: 901px) {
  .serviceGrid,
  .useCaseGrid,
  .processGrid {
    grid-template-columns: repeat(3, 1fr);
  }

  .serviceGrid article,
  .useCaseGrid article {
    border-bottom: 1px solid rgba(8, 11, 16, .1);
  }
}

/* iPhone SE: proceso vertical real */
@media (max-width: 430px) {
  .processGrid i {
    grid-column: 2;
    width: 28px;
    height: 28px;
    margin: 0 0 .45rem;
    color: #173247;
  }

  .processGrid article {
    display: grid;
    grid-template-columns: 44px 1fr;
  }

  .processGrid strong {
    grid-row: span 3;
  }
}

