.modalities {
  width: 100%;
  padding: clamp(4.2rem, 7vw, 7rem) 0;
  background: #f4f1eb;
  color: #080b10;
  overflow: hidden;
}

.inner {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.head {
  max-width: 760px;
  margin-bottom: 2.4rem;
}

.head span {
  display: inline-flex;
  margin-bottom: .9rem;
  color: #173247;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.head h2 {
  margin: 0;
  max-width: 820px;
  color: #080b10;
  font-size: clamp(2.15rem, 4.5vw, 4.8rem);
  line-height: .92;
  letter-spacing: -.065em;
  font-weight: 950;
  text-wrap: balance;
}

.head p {
  max-width: 680px;
  margin: 1.15rem 0 0;
  color: rgba(8, 11, 16, .68);
  font-size: 1rem;
  line-height: 1.72;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.card {
  position: relative;
  min-height: 280px;
  display: flex;
  flex-direction: column;
  padding: 1.55rem;
  background:
    linear-gradient(180deg, rgba(255,255,255,.86), rgba(255,255,255,.62));
  border: 1px solid rgba(8, 11, 16, .10);
  box-shadow: 0 22px 70px rgba(0, 0, 0, .055);
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 90% 0%, rgba(23, 50, 71, .12), transparent 34%),
    linear-gradient(180deg, transparent, rgba(23, 50, 71, .035));
  pointer-events: none;
}

.card > * {
  position: relative;
  z-index: 2;
}

.card small {
  display: inline-flex;
  align-self: flex-start;
  margin-bottom: 1.1rem;
  color: #173247;
  font-size: .66rem;
  font-weight: 950;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.cardNumber {
  width: 42px;
  height: 42px;
  display: inline-grid;
  place-items: center;
  margin-bottom: 1.25rem;
  border: 1px solid rgba(23, 50, 71, .25);
  border-radius: 999px;
  color: #173247;
  font-size: .8rem;
  font-weight: 950;
}

.card h3 {
  margin: 0;
  max-width: 230px;
  color: #080b10;
  font-size: clamp(1.25rem, 1.7vw, 1.65rem);
  line-height: 1;
  letter-spacing: -.045em;
  font-weight: 950;
}

.card p {
  margin: .95rem 0 0;
  color: rgba(8, 11, 16, .68);
  font-size: .94rem;
  line-height: 1.58;
}

.cardLink {
  display: inline-flex;
  align-items: center;
  margin-top: auto;
  padding-top: 1.25rem;
  color: #173247;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .72rem;
  line-height: 1.2;
  letter-spacing: .04em;
  font-weight: 950;
}

.cardLink::after {
  content: "→";
  margin-left: .55rem;
}

.moreButton {
  display: none;
}

.footer {
  margin-top: 1.1rem;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 1rem;
  align-items: center;
  padding: 1.35rem 1.45rem;
  background: #07101a;
  color: #fff;
}

.footer p {
  max-width: 720px;
  margin: 0;
  color: rgba(255,255,255,.74);
  line-height: 1.55;
  font-size: .95rem;
}

.footer a {
  min-height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.25rem;
  background: #173247;
  color: #fff;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .72rem;
  letter-spacing: .04em;
  font-weight: 950;
  white-space: nowrap;
}

.footer a::after {
  content: "→";
  margin-left: .65rem;
}

@media (max-width: 1180px) {
  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .modalities {
    padding: 3.2rem 0;
    background: #f4f1eb;
  }

  .inner {
    width: min(100% - 28px, 720px);
  }

  .head {
    margin-bottom: 1.45rem;
  }

  .head span {
    font-size: .64rem;
    letter-spacing: .16em;
    margin-bottom: .75rem;
  }

  .head h2 {
    max-width: 360px;
    font-size: clamp(2rem, 9.2vw, 3rem);
    line-height: .94;
    letter-spacing: -.055em;
  }

  .head p {
    max-width: 420px;
    margin-top: .9rem;
    font-size: .92rem;
    line-height: 1.55;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .card {
    min-height: auto;
    padding: 1.25rem;
  }

  .card[data-mobile-hidden="true"] {
    display: none;
  }

  .cardNumber {
    width: 36px;
    height: 36px;
    margin-bottom: .95rem;
    font-size: .72rem;
  }

  .card h3 {
    max-width: 100%;
    font-size: 1.28rem;
  }

  .card p {
    margin-top: .65rem;
    font-size: .9rem;
    line-height: 1.5;
  }

  .cardLink {
    padding-top: .95rem;
    font-size: .68rem;
  }

  .moreButton {
    width: 100%;
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: .9rem;
    border: 1px solid rgba(8, 11, 16, .14);
    background: rgba(255,255,255,.58);
    color: #080b10;
    text-transform: uppercase;
    font-size: .7rem;
    letter-spacing: .04em;
    font-weight: 950;
  }

  .footer {
    grid-template-columns: 1fr;
    margin-top: .9rem;
    padding: 1.2rem;
  }

  .footer p {
    font-size: .88rem;
  }

  .footer a {
    width: 100%;
    min-height: 46px;
    border-radius: 999px;
  }
}

/* === FIX VISUAL PREMIUM / CONTRASTE FINAL === */

.modalities {
  position: relative !important;
  padding: clamp(4rem, 6vw, 5.8rem) 0 !important;
  background:
    radial-gradient(circle at 78% 8%, rgba(23, 50, 71, .10), transparent 32rem),
    linear-gradient(180deg, #f4f1eb 0%, #eee8dd 100%) !important;
}

.inner {
  position: relative !important;
  z-index: 2 !important;
}

.head {
  max-width: 820px !important;
  margin-bottom: 2.2rem !important;
}

.head span {
  color: #173247 !important;
}

.head h2 {
  color: #05070b !important;
  max-width: 760px !important;
}

.head p {
  color: rgba(8, 11, 16, .72) !important;
  max-width: 720px !important;
  font-weight: 600 !important;
}

.grid {
  gap: 16px !important;
}

.card {
  min-height: 285px !important;
  padding: 1.65rem !important;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .96), rgba(250, 247, 241, .92)) !important;
  border: 1px solid rgba(8, 11, 16, .14) !important;
  box-shadow: 0 20px 55px rgba(8, 11, 16, .08) !important;
}

.card::before {
  background:
    radial-gradient(circle at 92% 0%, rgba(23, 50, 71, .13), transparent 38%),
    linear-gradient(180deg, transparent, rgba(23, 50, 71, .04)) !important;
}

.card small {
  color: #173247 !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

.cardNumber {
  color: #173247 !important;
  background: rgba(23, 50, 71, .06) !important;
  border-color: rgba(23, 50, 71, .28) !important;
}

.card h3 {
  color: #05070b !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

.card p {
  color: rgba(8, 11, 16, .72) !important;
  opacity: 1 !important;
  text-shadow: none !important;
  font-weight: 600 !important;
}

.cardLink {
  width: fit-content !important;
  min-height: 42px !important;
  margin-top: auto !important;
  padding: 0 1rem !important;
  border-radius: 999px !important;
  background: #173247 !important;
  color: #fff !important;
  box-shadow: 0 14px 32px rgba(23, 50, 71, .25) !important;
  text-shadow: none !important;
}

.footer {
  margin-top: 1rem !important;
  background:
    linear-gradient(135deg, #07101a 0%, #10283b 100%) !important;
  border: 1px solid rgba(255, 255, 255, .10) !important;
  box-shadow: 0 22px 60px rgba(8, 11, 16, .14) !important;
}

.footer p {
  color: rgba(255, 255, 255, .78) !important;
  opacity: 1 !important;
  text-shadow: none !important;
  font-weight: 600 !important;
}

.footer a {
  background: #173247 !important;
  color: #fff !important;
  border-radius: 999px !important;
  box-shadow: 0 14px 32px rgba(0, 0, 0, .22) !important;
}

@media (max-width: 900px) {
  .modalities {
    padding: 3rem 0 !important;
  }

  .head {
    margin-bottom: 1.35rem !important;
  }

  .card {
    min-height: auto !important;
    padding: 1.2rem !important;
  }

  .footer {
    margin-top: .9rem !important;
  }
}
