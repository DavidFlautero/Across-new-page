"use client";

import { useState } from "react";
import Link from "next/link";
import styles from "./ServiceModalities.module.css";

export type ServiceModality = {
  eyebrow?: string;
  title: string;
  text: string;
  cta?: string;
  href?: string;
};

type ServiceModalitiesProps = {
  eyebrow: string;
  title: string;
  description: string;
  items: ServiceModality[];
  finalText?: string;
  finalCta?: string;
  finalHref?: string;
  mobileInitialItems?: number;
};

export default function ServiceModalities({
  eyebrow,
  title,
  description,
  items,
  finalText = "¿No sabe qué modalidad necesita? Nuestro equipo puede revisar urgencia, destino, tipo de carga y presupuesto.",
  finalCta = "Definir modalidad",
  finalHref = "/cotizacion",
  mobileInitialItems = 4,
}: ServiceModalitiesProps) {
  const [showAll, setShowAll] = useState(false);

  return (
    <section className={styles.modalities} aria-labelledby="service-modalities-title">
      <div className={styles.inner}>
        <div className={styles.head}>
          <span>{eyebrow}</span>
          <h2 id="service-modalities-title">{title}</h2>
          <p>{description}</p>
        </div>

        <div className={styles.grid}>
          {items.map((item, index) => {
            const isHiddenOnMobile = index >= mobileInitialItems && !showAll;

            return (
              <article
                key={item.title}
                className={styles.card}
                data-mobile-hidden={isHiddenOnMobile ? "true" : "false"}
              >
                {item.eyebrow ? <small>{item.eyebrow}</small> : null}

                <div className={styles.cardNumber}>
                  {String(index + 1).padStart(2, "0")}
                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                {item.cta ? (
                  <Link href={item.href || finalHref} className={styles.cardLink}>
                    {item.cta}
                  </Link>
                ) : null}
              </article>
            );
          })}
        </div>

        {items.length > mobileInitialItems ? (
          <button
            type="button"
            className={styles.moreButton}
            onClick={() => setShowAll((value) => !value)}
            aria-expanded={showAll}
          >
            {showAll ? "Ver menos modalidades" : "Ver más modalidades aéreas"}
          </button>
        ) : null}

        <div className={styles.footer}>
          <p>{finalText}</p>
          <Link href={finalHref}>{finalCta}</Link>
        </div>
      </div>
    </section>
  );
}
