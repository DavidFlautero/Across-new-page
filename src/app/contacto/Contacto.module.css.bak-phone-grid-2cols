.contactPage {
  width: 100%;
  min-height: 100vh;
  padding: clamp(7rem, 10vw, 9rem) 5vw 0;
  background:
    radial-gradient(circle at 12% 0%, rgba(180, 0, 45, .08), transparent 28rem),
    linear-gradient(180deg, #f4f1eb 0%, #eee8df 100%);
  color: #111;
  overflow: hidden;
}

.contactGrid {
  width: min(1220px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, .92fr) minmax(420px, 1.08fr);
  gap: clamp(2rem, 5vw, 5rem);
  align-items: start;
}

.contactIntro {
  padding-top: clamp(.5rem, 2vw, 2rem);
}

.eyebrow {
  display: inline-flex;
  margin-bottom: 1rem;
  color: #b40032;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .22em;
  text-transform: uppercase;
}

.contactTitle {
  max-width: 680px;
  margin: 0;
  color: #111;
  font-size: clamp(3rem, 5.4vw, 6rem);
  line-height: .9;
  letter-spacing: -.075em;
  font-weight: 950;
}

.contactText {
  max-width: 580px;
  margin: 1.35rem 0 0;
  color: rgba(0, 0, 0, .66);
  font-size: clamp(1rem, 1.2vw, 1.15rem);
  line-height: 1.7;
}

.phonesGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .9rem;
  margin-top: 2rem;
}

.phoneCard {
  min-width: 0;
  padding: 1.05rem;
  border-radius: 24px;
  background: rgba(255,255,255,.9);
  color: #111;
  text-decoration: none;
  border: 1px solid rgba(0,0,0,.06);
  box-shadow: 0 18px 55px rgba(0,0,0,.08);
  transition: transform .25s ease, box-shadow .25s ease;
}

.phoneCard:hover {
  transform: translateY(-4px);
  box-shadow: 0 28px 75px rgba(0,0,0,.12);
}

.phoneLabel,
.phoneCta {
  display: block;
  color: #b40032;
  font-size: .68rem;
  font-weight: 950;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.phoneNumber {
  display: block;
  margin-top: .45rem;
  color: #111;
  font-size: clamp(.95rem, 1.2vw, 1.08rem);
  line-height: 1.2;
  word-break: break-word;
}

.phoneCta {
  margin-top: .7rem;
  color: rgba(0,0,0,.48);
  letter-spacing: 0;
  text-transform: none;
}

.contactForm {
  width: 100%;
  min-width: 0;
  padding: clamp(1.3rem, 2.3vw, 2.25rem);
  border-radius: 34px;
  background: rgba(255,255,255,.96);
  border: 1px solid rgba(0,0,0,.06);
  box-shadow: 0 30px 90px rgba(0,0,0,.14);
  display: grid;
  gap: 1rem;
}

.formTitle {
  margin: 0 0 .4rem;
  color: #111;
  font-size: clamp(1.75rem, 3vw, 2.8rem);
  line-height: .95;
  letter-spacing: -.055em;
}

.twoCols {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .9rem;
}

.formControl {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  border-radius: 18px;
  padding: 1rem 1.05rem;
  background: #ece7de;
  color: #111;
  font: inherit;
  font-size: .95rem;
  font-weight: 750;
  box-sizing: border-box;
}

.formControl::placeholder {
  color: rgba(0,0,0,.46);
}

.formControl:focus {
  box-shadow:
    0 0 0 2px rgba(180,0,50,.16),
    0 12px 34px rgba(0,0,0,.08);
  background: #f1ede6;
}

.messageBox {
  min-height: 150px;
  resize: vertical;
}

.legalText {
  margin: .25rem 0 0;
  color: rgba(0,0,0,.56);
  font-size: .78rem;
  line-height: 1.55;
}

.checkRow {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: .7rem;
  align-items: start;
  color: rgba(0,0,0,.68);
  font-size: .86rem;
  line-height: 1.45;
}

.checkRow input {
  width: 18px;
  height: 18px;
  margin-top: .12rem;
  accent-color: #b40032;
}

.submitButton {
  width: 100%;
  min-height: 58px;
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, #9c0b29, #e11343);
  color: #fff;
  font-weight: 950;
  cursor: pointer;
  box-shadow: 0 24px 70px rgba(180,0,45,.28);
  transition: transform .25s ease, box-shadow .25s ease, opacity .25s ease;
}

.submitButton:hover {
  transform: translateY(-2px);
  box-shadow: 0 32px 85px rgba(180,0,45,.34);
}

.submitButton:disabled {
  opacity: .72;
  cursor: wait;
}

.success,
.fail {
  margin: 0;
  font-weight: 900;
  font-size: .92rem;
}

.success {
  color: #0a7a3b;
}

.fail {
  color: #b40032;
}

/* OFICINAS */
.contactOfficesSection {
  position: relative;
  width: 100%;
  padding: 4.5rem 5vw 6rem;
  margin-top: clamp(3rem, 6vw, 5rem);
  background: #f4f1eb;
  color: #111;
  overflow: hidden;
}

.contactOfficesHead {
  width: min(1220px, 100%);
  margin: 0 auto 2rem;
}

.contactOfficesHead span {
  color: #b40032;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.contactOfficesHead h2 {
  margin: .8rem 0 0;
  color: #111;
  font-size: clamp(2.4rem, 5vw, 5.2rem);
  line-height: .9;
  letter-spacing: -.08em;
}

.contactOfficesGrid {
  width: min(1220px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.contactOfficeCard {
  position: relative;
  min-height: 280px;
  overflow: hidden;
  border-radius: 28px;
  background: #111;
  border: 1px solid rgba(0,0,0,.08);
  box-shadow: 0 24px 70px rgba(0,0,0,.14);
  isolation: isolate;
  text-decoration: none;
  transition: transform .28s ease, box-shadow .28s ease;
}

.contactOfficeCard:hover {
  transform: translateY(-7px);
  box-shadow: 0 38px 95px rgba(0,0,0,.2);
}

.contactOfficeImage {
  object-fit: cover;
  filter: brightness(.9) contrast(1.06) saturate(1.06);
  transition: transform .45s ease;
}

.contactOfficeCard:hover .contactOfficeImage {
  transform: scale(1.06);
}

.contactOfficeOverlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(0,0,0,.04) 0%, rgba(0,0,0,.2) 45%, rgba(0,0,0,.82) 100%),
    radial-gradient(circle at 85% 10%, rgba(190,18,55,.25), transparent 15rem);
}

.contactOfficeContent {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 1.35rem;
  color: #fff;
}

.contactOfficeContent small {
  color: #d5a85b;
  font-size: .68rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.contactOfficeContent h2,
.contactOfficeContent h3 {
  margin: .45rem 0;
  color: #fff;
  font-size: 1.55rem;
  line-height: 1;
  letter-spacing: -.05em;
}

.contactOfficeContent p {
  margin: 0 0 .7rem;
  color: rgba(255,255,255,.78);
  font-size: .78rem;
  line-height: 1.35;
}

.contactOfficeContent strong {
  display: inline-flex;
  width: fit-content;
  padding: .38rem .62rem;
  border-radius: 999px;
  background: rgba(255,255,255,.14);
  border: 1px solid rgba(255,255,255,.18);
  color: #fff;
  font-size: .72rem;
}

.contactOfficeContent span {
  display: block;
  margin-top: .55rem;
  color: #e11343;
  font-weight: 900;
  font-size: .78rem;
}

/* TABLET */
@media (max-width: 1024px) {
  .contactPage {
    padding-top: 7rem;
  }

  .contactGrid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .contactIntro {
    padding-top: 0;
  }

  .contactTitle {
    max-width: 820px;
    font-size: clamp(2.8rem, 8vw, 5.2rem);
  }

  .contactText {
    max-width: 760px;
  }

  .phonesGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .contactForm {
    max-width: 820px;
  }

  .contactOfficesGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* MOBILE */
@media (max-width: 640px) {
  .contactPage {
    padding: 6.4rem 1rem 0;
  }

  .contactGrid {
    gap: 1.4rem;
  }

  .eyebrow {
    font-size: .68rem;
    letter-spacing: .18em;
  }

  .contactTitle {
    font-size: clamp(2.35rem, 13vw, 3.65rem);
    line-height: .92;
    letter-spacing: -.07em;
  }

  .contactText {
    margin-top: 1rem;
    font-size: .95rem;
    line-height: 1.55;
  }

  .phonesGrid {
    grid-template-columns: 1fr;
    gap: .75rem;
    margin-top: 1.4rem;
  }

  .phoneCard {
    padding: .9rem;
    border-radius: 20px;
  }

  .contactForm {
    padding: 1rem;
    border-radius: 24px;
    gap: .78rem;
  }

  .formTitle {
    font-size: 1.9rem;
  }

  .twoCols {
    grid-template-columns: 1fr;
    gap: .78rem;
  }

  .formControl {
    min-height: 50px;
    border-radius: 15px;
    padding: .9rem .95rem;
    font-size: .9rem;
  }

  .messageBox {
    min-height: 130px;
  }

  .legalText {
    font-size: .72rem;
    line-height: 1.45;
  }

  .checkRow {
    font-size: .76rem;
    line-height: 1.35;
    gap: .58rem;
  }

  .submitButton {
    min-height: 52px;
  }

  .contactOfficesSection {
    padding: 3rem 1rem 4rem;
    margin-top: 3rem;
  }

  .contactOfficesHead h2 {
    font-size: clamp(2.2rem, 12vw, 3.5rem);
  }

  .contactOfficesGrid {
    grid-template-columns: 1fr;
  }

  .contactOfficeCard {
    min-height: 250px;
    border-radius: 22px;
  }
}

/* MOBILE PEQUEÑO */
@media (max-width: 390px) {
  .contactPage {
    padding-inline: .75rem;
  }

  .contactTitle {
    font-size: clamp(2.05rem, 12vw, 3.2rem);
  }

  .contactForm {
    padding: .85rem;
  }

  .formControl {
    font-size: .86rem;
  }
}
