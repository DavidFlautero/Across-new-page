.contactPage {
  width: 100%;
  min-height: 100vh;
  padding: clamp(6.5rem, 8vw, 8.5rem) 5vw clamp(4rem, 6vw, 6rem);
  background:
    radial-gradient(circle at 12% 0%, rgba(180, 0, 45, .08), transparent 28rem),
    linear-gradient(180deg, #f4f1eb 0%, #eee8df 100%);
  color: #111;
  overflow: hidden;
}

.contactShell {
  width: min(1180px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(320px, .62fr);
  gap: clamp(1.5rem, 4vw, 3.5rem);
  align-items: start;
}

/* =========================
   FORMULARIO LIMPIO
   ========================= */

.contactForm {
  width: 100%;
  min-width: 0;
  padding: clamp(1.25rem, 2.5vw, 2.3rem);
  border-radius: 30px;
  background: rgba(255,255,255,.97);
  border: 1px solid rgba(0,0,0,.06);
  box-shadow: 0 30px 90px rgba(0,0,0,.13);
  display: grid;
  gap: .95rem;
}

.formTitle {
  margin: 0 0 .45rem;
  color: #111;
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  line-height: .95;
  letter-spacing: -.055em;
  font-weight: 950;
}

.twoCols {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .85rem;
}

.formControl {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  border-radius: 16px;
  padding: .95rem 1rem;
  background: #ece7de;
  color: #111;
  font: inherit;
  font-size: .94rem;
  font-weight: 750;
  box-sizing: border-box;
}

.formControl::placeholder {
  color: rgba(0,0,0,.46);
}

.formControl:focus {
  box-shadow:
    0 0 0 2px rgba(180,0,50,.16),
    0 12px 34px rgba(0,0,0,.08);
  background: #f1ede6;
}

.messageBox {
  min-height: 135px;
  resize: vertical;
}

.legalText {
  margin: .15rem 0 0;
  color: rgba(0,0,0,.56);
  font-size: .76rem;
  line-height: 1.5;
}

.checkRow {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: .65rem;
  align-items: start;
  color: rgba(0,0,0,.68);
  font-size: .83rem;
  line-height: 1.4;
}

.checkRow input {
  width: 18px;
  height: 18px;
  margin-top: .12rem;
  accent-color: #b40032;
}

.submitButton {
  width: 100%;
  min-height: 56px;
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, #9c0b29, #e11343);
  color: #fff;
  font-weight: 950;
  cursor: pointer;
  box-shadow: 0 24px 70px rgba(180,0,45,.28);
  transition: transform .25s ease, box-shadow .25s ease, opacity .25s ease;
}

.submitButton:hover {
  transform: translateY(-2px);
  box-shadow: 0 32px 85px rgba(180,0,45,.34);
}

.submitButton:disabled {
  opacity: .72;
  cursor: wait;
}

.success,
.fail {
  margin: 0;
  font-weight: 900;
  font-size: .9rem;
}

.success {
  color: #0a7a3b;
}

.fail {
  color: #b40032;
}

/* =========================
   SEMÁFORO LATERAL
   ========================= */

.signalPanel {
  position: sticky;
  top: 6.5rem;
  min-width: 0;
  padding: clamp(1.35rem, 2.2vw, 2rem);
  border-radius: 30px;
  color: #fff;
  background:
    radial-gradient(circle at 92% 0%, rgba(225,19,67,.20), transparent 22rem),
    linear-gradient(135deg, #080b10 0%, #121823 58%, #290713 100%);
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 30px 90px rgba(0,0,0,.16);
  overflow: hidden;
}

.signalPanel::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px),
    linear-gradient(180deg, rgba(255,255,255,.018) 1px, transparent 1px);
  background-size: 72px 72px;
  opacity: .22;
}

.signalPanel > * {
  position: relative;
  z-index: 1;
}

.signalEyebrow {
  display: inline-flex;
  margin-bottom: .85rem;
  color: #e11343;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .2em;
  text-transform: uppercase;
}

.signalTitle {
  margin: 0;
  color: #fff;
  font-size: clamp(2rem, 3.2vw, 3.4rem);
  line-height: .92;
  letter-spacing: -.065em;
  font-weight: 950;
}

.signalText {
  margin: 1rem 0 0;
  color: rgba(255,255,255,.72);
  font-size: .94rem;
  line-height: 1.55;
}

.signalList {
  margin-top: 1.6rem;
  display: grid;
  gap: .8rem;
}

.signalItem {
  display: grid;
  grid-template-columns: 20px 1fr;
  gap: .85rem;
  align-items: start;
  padding: .95rem;
  border-radius: 20px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.10);
}

.signalItem i {
  width: 14px;
  height: 14px;
  margin-top: .25rem;
  border-radius: 999px;
  box-shadow: 0 0 0 5px rgba(255,255,255,.06);
}

.signalItem[data-tone="green"] i {
  background: #00c46a;
  box-shadow: 0 0 0 5px rgba(0,196,106,.12), 0 0 22px rgba(0,196,106,.42);
}

.signalItem[data-tone="amber"] i {
  background: #f0b429;
  box-shadow: 0 0 0 5px rgba(240,180,41,.12), 0 0 22px rgba(240,180,41,.42);
}

.signalItem[data-tone="red"] i {
  background: #e11343;
  box-shadow: 0 0 0 5px rgba(225,19,67,.13), 0 0 22px rgba(225,19,67,.42);
}

.signalItem strong {
  display: block;
  color: #fff;
  font-size: .95rem;
  line-height: 1.2;
  font-weight: 950;
}

.signalItem p {
  margin: .35rem 0 0;
  color: rgba(255,255,255,.68);
  font-size: .82rem;
  line-height: 1.45;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 980px) {
  .contactShell {
    grid-template-columns: 1fr;
  }

  .signalPanel {
    position: relative;
    top: auto;
  }
}

@media (max-width: 640px) {
  .contactPage {
    padding: 5.7rem 1rem 3.5rem;
  }

  .contactShell {
    gap: 1rem;
  }

  .contactForm {
    order: 1;
    padding: 1rem;
    border-radius: 24px;
    gap: .78rem;
  }

  .signalPanel {
    order: 2;
    padding: 1rem;
    border-radius: 24px;
  }

  .formTitle {
    font-size: 1.9rem;
  }

  .twoCols {
    grid-template-columns: 1fr;
    gap: .78rem;
  }

  .formControl {
    min-height: 50px;
    border-radius: 15px;
    padding: .9rem .95rem;
    font-size: .9rem;
  }

  .messageBox {
    min-height: 120px;
  }

  .legalText {
    font-size: .72rem;
    line-height: 1.45;
  }

  .checkRow {
    font-size: .76rem;
    line-height: 1.35;
    gap: .58rem;
  }

  .submitButton {
    min-height: 52px;
  }

  .signalTitle {
    font-size: clamp(1.85rem, 9vw, 2.5rem);
  }

  .signalText {
    font-size: .86rem;
  }

  .signalList {
    margin-top: 1.1rem;
    gap: .65rem;
  }

  .signalItem {
    padding: .78rem;
    border-radius: 18px;
  }
}

@media (max-width: 390px) {
  .contactPage {
    padding-inline: .75rem;
  }

  .contactForm,
  .signalPanel {
    padding: .85rem;
  }

  .formControl {
    font-size: .86rem;
  }
}
