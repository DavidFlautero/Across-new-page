/* FINAL CLEAN FLAGS + CTA ALIGN */
.language button,
.mobileLang button {
  width: 36px;
  height: 36px;
  min-width: 36px;
  display: grid;
  place-items: center;
  padding: 0;
}

.language button svg,
.mobileLang button svg {
  width: 20px;
  height: 20px;
  display: block;
  border-radius: 999px;
  box-shadow: 0 2px 8px rgba(0,0,0,.24);
}

.nav > a:last-child {
  transform: translateY(1px);
}

