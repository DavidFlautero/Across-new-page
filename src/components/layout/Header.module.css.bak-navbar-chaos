  position: absolute;
  left: 38px;
  right: 38px;
  bottom: -1px;
  height: 1px;
  border-radius: 999px;

  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(190,0,46,.12) 12%,
      rgba(228,18,68,.78) 50%,
      rgba(190,0,46,.12) 88%,
      transparent 100%
    ) !important;

