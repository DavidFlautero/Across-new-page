.wrapper {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 1000;
  padding: 1.2rem 2rem;
  pointer-events: none;
}

.header {
  pointer-events: auto;
  max-width: 1680px;
  margin: 0 auto;
  height: 78px;
  display: flex;
  align-items: center;
  gap: 1.3rem;
  padding: 0 1.6rem;
  border-radius: 999px;
  backdrop-filter: blur(20px);
  background: linear-gradient(135deg, rgba(10,10,14,.88), rgba(22,22,30,.62));
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: 0 20px 70px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.08);
}

.logo {
  display: flex;
  flex: 0 0 auto;
}

.logo img {
  width: 190px;
  height: auto;
}

.nav {
  display: flex;
  align-items: center;
  gap: 1.75rem;
  margin-left: auto;
}

.nav a,
.dropdownTrigger {
  color: rgba(255,255,255,.9);
  text-decoration: none;
  background: transparent;
  border: 0;
  cursor: pointer;
  font-size: .9rem;
  font-weight: 800;
  white-space: nowrap;
}

.nav a:hover,
.dropdownTrigger:hover {
  color: #ff2b57;
}

.divider {
  width: 1px;
  height: 26px;
  background: rgba(255,255,255,.14);
}

.dropdown {
  position: relative;
}

.dropdownTrigger {
  display: flex;
  align-items: center;
  gap: .4rem;
}

.dropdownMenu {
  position: absolute;
  top: calc(100% + 1.2rem);
  left: 50%;
  transform: translateX(-50%) translateY(12px);
  width: 340px;
  padding: .75rem;
  border-radius: 24px;
  opacity: 0;
  visibility: hidden;
  transition: .25s ease;
  backdrop-filter: blur(20px);
  background: linear-gradient(145deg, rgba(8,8,12,.97), rgba(18,18,24,.9));
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: 0 35px 90px rgba(0,0,0,.55);
}

.dropdownVisible {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.dropdownMenu a {
  display: flex;
  align-items: center;
  min-height: 48px;
  padding: 0 1rem;
  border-radius: 14px;
  border-bottom: 1px solid rgba(255,255,255,.07);
}

.dropdownMenu a:last-child {
  border-bottom: 0;
}

.dropdownMenu a:hover {
  background: linear-gradient(90deg, rgba(210,12,52,.26), rgba(255,255,255,.03));
}

.language {
  display: flex;
  align-items: center;
  gap: .35rem;
  padding-left: 1rem;
  border-left: 1px solid rgba(255,255,255,.1);
}

.language button {
  height: 36px;
  padding: 0 .6rem;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.09);
  background: rgba(255,255,255,.045);
  color: rgba(255,255,255,.78);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: .74rem;
  font-weight: 900;
}

.languageActive {
  background: rgba(255,255,255,.15) !important;
  color: white !important;
}

.mobileButton,
.mobileLang,
.mobileBackdrop,
.mobilePanel {
  display: none;
}

@media (max-width: 1100px) {
  .wrapper {
    padding: .9rem 1rem;
  }

  .header {
    height: 74px;
    padding: 0 .75rem 0 .9rem;
    gap: .55rem;
  }

  .logo img {
    width: 170px;
  }

  .nav,
  .language {
    display: none;
  }

  .mobileLang {
    display: flex;
    align-items: center;
    gap: .35rem;
    margin-left: auto;
  }

  .mobileLang button {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.06);
    color: white;
    cursor: pointer;
    font-size: .72rem;
  }

  .mobileButton {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 17px;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(135deg, rgba(20,20,26,.95), rgba(10,10,14,.88));
    color: white;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .mobileBackdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: rgba(0,0,0,.48);
    backdrop-filter: blur(8px);
    transition: .25s ease;
  }

  .mobileBackdropVisible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobilePanel {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1002;
    width: min(360px, 86vw);
    height: 100vh;
    padding: 1.4rem;
    transform: translateX(-105%);
    transition: transform .32s ease;
    border-left: 1px solid rgba(255,255,255,.12);
    background:
      radial-gradient(circle at 85% 10%, rgba(190,18,50,.24), transparent 18rem),
      linear-gradient(145deg, rgba(10,10,15,.88), rgba(6,7,10,.78));
    backdrop-filter: blur(26px) saturate(1.2);
    box-shadow: -30px 0 80px rgba(0,0,0,.42);
  }

  .mobilePanelVisible {
    transform: translateX(0);
  }

  .closeButton {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.06);
    color: white;
    font-size: 1.7rem;
    cursor: pointer;
  }

  .mobileLogo {
    width: 185px;
    height: auto;
    margin-bottom: 2rem;
  }

  .mobileLinks {
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }

  .mobileLinks a {
    min-height: 54px;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    border-radius: 18px;
    color: rgba(255,255,255,.92);
    text-decoration: none;
    font-weight: 800;
    background: rgba(255,255,255,.045);
    border: 1px solid rgba(255,255,255,.07);
  }

  .mobileLinks a:hover {
    background: linear-gradient(90deg, rgba(210,12,52,.28), rgba(255,255,255,.06));
  }
}

@media (max-width: 430px) {
  .wrapper {
    padding: .8rem .85rem;
