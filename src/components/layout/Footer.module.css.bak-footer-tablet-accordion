.footer {
  width: 100%;
  overflow-x: hidden;
  background: linear-gradient(180deg, #0c0d12 0%, #05060a 100%);
  color: #e5e7eb;
  padding: clamp(2rem, 4vw, 3.5rem) 5vw 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  font-family: inherit;
}

.inner {
  width: min(1380px, 100%);
  margin: 0 auto;
}

/* Desktop */
.top {
  display: grid;
  grid-template-columns:
    minmax(180px, 220px)
    minmax(300px, 2.1fr)
    repeat(4, minmax(130px, 1fr));
  gap: clamp(1.1rem, 2vw, 2rem);
  align-items: start;
}

/* Brand */
.brand {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.95rem;
}

.brand img {
  width: min(180px, 100%);
  height: auto;
}

.socials {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.socials a {
  width: 30px;
  height: 30px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #e5e7eb;
  text-decoration: none;
  font-size: 0.78rem;
  font-weight: 800;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  transition: background 0.2s ease, transform 0.2s ease;
}

.socials a:hover {
  background: #e11343f2;
  transform: translateY(-2px);
}

.email {
  color: #cbd5e1;
  font-size: 0.78rem;
  line-height: 1.35;
  text-decoration: none;
  word-break: break-word;
}

.email:hover {
  color: #fff;
}

/* Sections */
.section {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.section h3 {
  width: fit-content;
  margin: 0 0 0.35rem;
  padding-bottom: 0.42rem;
  border-bottom: 1px solid rgba(225, 19, 67, 0.65);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.sectionContent {
  min-width: 0;
}

.officesGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(115px, 1fr));
  gap: 0.55rem 0.9rem;
}

.officesGrid p {
  min-width: 0;
  margin: 0;
  color: #cbd5e1;
  font-size: 0.72rem;
  line-height: 1.35;
}

.officesGrid strong {
  display: block;
  color: #f8fafc;
  font-weight: 850;
  overflow-wrap: anywhere;
}

.officesGrid span {
  display: block;
  margin-top: 0.14rem;
  color: #94a3b8;
  font-size: 0.68rem;
  overflow-wrap: anywhere;
}

.linksList {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.48rem;
}

.linksList a {
  color: #cbd5e1;
  text-decoration: none;
  font-size: 0.74rem;
  line-height: 1.35;
  overflow-wrap: anywhere;
  transition: color 0.2s ease;
}

.linksList a:hover {
  color: #fff;
  text-decoration: underline;
  text-decoration-color: #e11343f2;
  text-underline-offset: 3px;
}

.bottom {
  margin-top: clamp(1.6rem, 3vw, 2.4rem);
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  color: #94a3b8;
  font-size: 0.68rem;
  line-height: 1.45;
}


/* Laptop / small desktop */
@media (max-width: 1280px) {
  .top {
    grid-template-columns:
      minmax(170px, 220px)
      minmax(260px, 1.6fr)
      repeat(4, minmax(110px, 1fr));
    gap: 1.2rem;
  }

  .officesGrid {
    grid-template-columns: repeat(2, minmax(110px, 1fr));
  }
}

/* Tablet / intermedio: acordeón en 2 columnas */
@media (max-width: 1100px) {
  .footer {
    padding: 2.2rem 1.4rem 1rem;
  }

  .top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem;
  }

  .brand {
    grid-column: 1 / -1;
    grid-row: auto;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    margin-bottom: .2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .brand img {
    width: 165px;
  }

  .socials {
    justify-content: flex-end;
  }

  .section {
    min-width: 0;
    border-radius: 18px;
    padding: 0 .95rem;
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.08);
  }

  .section:first-of-type {
    grid-column: 1 / -1;
  }

  .section h3 {
    width: 100%;
    min-height: 54px;
    margin: 0;
    padding: 0;
    border-bottom: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: .8rem;
  }

  .section h3::after {
    content: "⌄";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex: 0 0 26px;
    border-radius: 999px;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    font-size: .95rem;
    line-height: 1;
    transition: transform .22s ease, background .22s ease;
  }

  .section.open h3::after {
    transform: rotate(180deg);
    background: #e11343f2;
  }

  .sectionContent {
    max-height: 0;
    overflow: hidden;
    transition: max-height .32s ease, padding .32s ease;
  }

  .section.open .sectionContent {
    max-height: 1500px;
    padding-bottom: 1rem;
  }

  .officesGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .7rem;
  }

  .officesGrid p {
    padding: .72rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, .045);
    border: 1px solid rgba(255, 255, 255, .06);
    font-size: .76rem;
  }

  .officesGrid span {
    font-size: .72rem;
  }

  .linksList {
    gap: .2rem;
  }

  .linksList a {
    min-height: 40px;
    display: flex;
    align-items: center;
    padding: .38rem 0;
    font-size: .84rem;
  }

  .bottom {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    margin-top: 1.3rem;
    text-align: center;
    font-size: .72rem;
  }
}

/* Mobile: acordeón en 1 columna */
@media (max-width: 640px) {
  .footer {
    padding: 1.7rem 1rem 1rem;
  }

  .top {
    grid-template-columns: 1fr;
    gap: .65rem;
  }

  .brand {
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: .3rem;
    padding-bottom: 1.2rem;
  }

  .brand img {
    width: 148px;
  }

  .socials {
    justify-content: center;
  }

  .email {
    font-size: .82rem;
  }

  .section:first-of-type {
    grid-column: auto;
  }

  .section {
    border-radius: 16px;
    padding: 0 .85rem;
  }

  .officesGrid {
    grid-template-columns: 1fr;
  }

  .officesGrid p {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .officesGrid strong,
  .officesGrid span {
    margin: 0;
  }
}

/* Ultra small */
@media (max-width: 360px) {
  .brand img {
    width: 132px;
  }

  .socials a {
    width: 28px;
    height: 28px;
  }

  .section h3 {
    font-size: .78rem;
  }

  .linksList a {
    font-size: .82rem;
  }

  .bottom {
    font-size: .68rem;
  }
}
