"use client";

import { useEffect } from "react";

export default function HomeDesktopFinalFixer() {
  useEffect(() => {
    const STYLE_ID = "home-desktop-final-fix-real";

    document.getElementById(STYLE_ID)?.remove();

    document
      .querySelectorAll(
        "[data-home-hero-final], [data-home-services-final], [data-home-cert-final], [data-home-visual-card-final]"
      )
      .forEach((el) => {
        el.removeAttribute("data-home-hero-final");
        el.removeAttribute("data-home-services-final");
        el.removeAttribute("data-home-cert-final");
        el.removeAttribute("data-home-visual-card-final");
      });

    const findSectionByHeading = (text: string, attr: string) => {
      const headings = [...document.querySelectorAll("h1, h2, h3")];

      const heading = headings.find((el) =>
        (el.textContent || "").replace(/\s+/g, " ").trim().includes(text)
      );

      if (!heading) return null;

      const section = heading.closest("section");
      if (!section) return null;

      section.setAttribute(attr, "true");
      return section;
    };

    const findVisualCardByHeading = (text: string) => {
      const headings = [...document.querySelectorAll("h1, h2, h3, strong")];

      const heading = headings.find((el) =>
        (el.textContent || "").replace(/\s+/g, " ").trim().includes(text)
      );

      if (!heading) return null;

      const card =
        heading.closest("article") ||
        heading.closest("[class*='card']") ||
        heading.closest("[class*='Card']") ||
        heading.closest("[class*='visual']") ||
        heading.closest("[class*='Visual']");

      if (!card) return null;

      card.setAttribute("data-home-visual-card-final", "true");
      return card;
    };

    findSectionByHeading("Su operación logística", "data-home-hero-final");

    findSectionByHeading(
      "Servicios logísticos internacionales",
      "data-home-services-final"
    );

    findSectionByHeading(
      "Experiencia, certificaciones",
      "data-home-cert-final"
    );

    findVisualCardByHeading("De origen a destino");

    const style = document.createElement("style");
    style.id = STYLE_ID;

    style.textContent = `
      @media (min-width: 901px) {
        header,
        [class*="Header_header"] {
          z-index: 9999 !important;
        }

        /* ============================= */
        /* SERVICIOS LOGÍSTICOS HOME */
        /* ============================= */

        [data-home-services-final="true"] {
          position: relative !important;
          z-index: 1 !important;
          overflow: visible !important;
          background: #f3efe8 !important;
          padding-top: 7.4rem !important;
          margin-top: 0 !important;
        }

        [data-home-services-final="true"] h2 {
          max-width: 820px !important;
          margin-top: 0 !important;
          padding-top: 0 !important;
          line-height: .92 !important;
          letter-spacing: -0.055em !important;
        }

        [data-home-services-final="true"] a[href],
        [data-home-services-final="true"] button {
          opacity: 1 !important;
          visibility: visible !important;
          pointer-events: auto !important;
          position: relative !important;
          z-index: 5 !important;
        }

        [data-home-services-final="true"] * {
          box-sizing: border-box !important;
        }

        [data-home-services-final="true"] [class*="card"],
        [data-home-services-final="true"] [class*="panel"],
        [data-home-services-final="true"] [class*="visual"] {
          overflow: visible !important;
        }

        /* ============================= */
        /* CERTIFICACIONES / MAPA HOME */
        /* ============================= */

        [data-home-cert-final="true"] {
          position: relative !important;
          z-index: 1 !important;
          overflow: hidden !important;
          padding-top: 7.4rem !important;
          margin-top: 0 !important;
        }

        [data-home-cert-final="true"] h2 {
          max-width: 690px !important;
          line-height: .94 !important;
          letter-spacing: -0.055em !important;
        }

        [data-home-cert-final="true"] article,
        [data-home-cert-final="true"] [class*="card"],
        [data-home-cert-final="true"] [class*="item"],
        [data-home-cert-final="true"] [class*="panel"] {
          padding-left: 1.45rem !important;
          padding-right: 1.45rem !important;
          box-sizing: border-box !important;
        }

        [data-home-cert-final="true"] article h3,
        [data-home-cert-final="true"] article strong,
        [data-home-cert-final="true"] [class*="card"] h3,
        [data-home-cert-final="true"] [class*="card"] strong {
          margin-left: 0 !important;
          padding-left: 0 !important;
          line-height: 1.15 !important;
        }

        [data-home-cert-final="true"] article p,
        [data-home-cert-final="true"] [class*="card"] p {
          margin-left: 0 !important;
          padding-left: 0 !important;
          line-height: 1.5 !important;
        }

        /* ============================= */
        /* CUADRO AZUL OPERACIÓN INTEGRADA */
        /* ============================= */

        [data-home-visual-card-final="true"] {
          position: relative !important;
          overflow: hidden !important;
          border-radius: 14px !important;
          border: 1px solid rgba(255,255,255,.16) !important;
          box-shadow:
            0 30px 90px rgba(0,0,0,.20),
            inset 0 1px 0 rgba(255,255,255,.10) !important;
        }

        [data-home-visual-card-final="true"]::after {
          content: "" !important;
          position: absolute !important;
          inset: 0 !important;
          pointer-events: none !important;
          background:
            linear-gradient(90deg, rgba(0,0,0,.50) 0%, rgba(0,0,0,.22) 52%, rgba(0,0,0,.06) 100%),
            linear-gradient(180deg, rgba(0,0,0,.08) 0%, rgba(0,0,0,.34) 100%) !important;
          z-index: 1 !important;
        }

        [data-home-visual-card-final="true"] > * {
          position: relative !important;
          z-index: 2 !important;
        }

        [data-home-visual-card-final="true"] h2,
        [data-home-visual-card-final="true"] h3,
        [data-home-visual-card-final="true"] strong {
          text-shadow: 0 4px 20px rgba(0,0,0,.62) !important;
        }

        [data-home-visual-card-final="true"] h2,
        [data-home-visual-card-final="true"] h3 {
          max-width: 420px !important;
          line-height: .98 !important;
          letter-spacing: -.045em !important;
        }

        [data-home-visual-card-final="true"] i,
        [data-home-visual-card-final="true"] span:empty,
        [data-home-visual-card-final="true"] [class*="dot"],
        [data-home-visual-card-final="true"] [class*="Dot"],
        [data-home-visual-card-final="true"] [class*="circle"],
        [data-home-visual-card-final="true"] [class*="Circle"] {
          position: relative !important;
          width: 28px !important;
          height: 28px !important;
          min-width: 28px !important;
          min-height: 28px !important;
          display: inline-grid !important;
          place-items: center !important;
          border-radius: 999px !important;
          background: rgba(5,31,55,.78) !important;
          border: 1px solid rgba(210,164,92,.72) !important;
          box-shadow:
            0 10px 24px rgba(0,0,0,.28),
            inset 0 1px 0 rgba(255,255,255,.12) !important;
        }

        [data-home-visual-card-final="true"] i::before,
        [data-home-visual-card-final="true"] span:empty::before,
        [data-home-visual-card-final="true"] [class*="dot"]::before,
        [data-home-visual-card-final="true"] [class*="Dot"]::before,
        [data-home-visual-card-final="true"] [class*="circle"]::before,
        [data-home-visual-card-final="true"] [class*="Circle"]::before {
          content: "" !important;
          width: 7px !important;
          height: 7px !important;
          border-radius: 999px !important;
          background: #d2a45c !important;
          box-shadow: 0 0 18px rgba(210,164,92,.85) !important;
        }

        [data-home-visual-card-final="true"] li,
        [data-home-visual-card-final="true"] article,
        [data-home-visual-card-final="true"] [class*="item"],
        [data-home-visual-card-final="true"] [class*="Item"],
        [data-home-visual-card-final="true"] [class*="step"],
        [data-home-visual-card-final="true"] [class*="Step"] {
          gap: .9rem !important;
        }

        [data-home-visual-card-final="true"] a[href] {
          margin-top: 1.35rem !important;
          min-height: 48px !important;
          padding: 0 1.45rem !important;
          border-radius: 999px !important;
          background: rgba(5,31,55,.72) !important;
          border: 1px solid rgba(210,164,92,.62) !important;
          color: #fff !important;
          box-shadow:
            0 16px 36px rgba(0,0,0,.26),
            inset 0 1px 0 rgba(255,255,255,.12) !important;
        }
      }

      /* ============================= */
      /* TABLET HERO: BOTONES EN FILA SIN TOCARSE */
      /* ============================= */

      @media (min-width: 761px) and (max-width: 1180px) {
        [data-home-hero-final="true"] [class*="actions"],
        [data-home-hero-final="true"] [class*="Actions"] {
          display: flex !important;
          flex-direction: row !important;
          flex-wrap: nowrap !important;
          align-items: stretch !important;
          justify-content: flex-start !important;
          gap: 1rem !important;
          width: min(100%, 560px) !important;
          max-width: 560px !important;
        }

        [data-home-hero-final="true"] [class*="actions"] a,
        [data-home-hero-final="true"] [class*="Actions"] a,
        [data-home-hero-final="true"] [class*="actions"] button,
        [data-home-hero-final="true"] [class*="Actions"] button {
          flex: 1 1 0 !important;
          min-width: 0 !important;
          width: auto !important;
          max-width: none !important;
          margin: 0 !important;
          padding-left: .95rem !important;
          padding-right: .95rem !important;
          white-space: normal !important;
          text-align: center !important;
          line-height: 1.08 !important;
          font-size: clamp(.62rem, .95vw, .76rem) !important;
        }
      }

      /* ============================= */
      /* TABLET HOME SECTIONS: BOTONES EN FILA SIN TOCARSE */
      /* ============================= */

      @media (min-width: 761px) and (max-width: 1180px) {
        [data-home-services-final="true"] [class*="actions"],
        [data-home-services-final="true"] [class*="Actions"],
        [data-home-services-final="true"] [class*="cta"],
        [data-home-services-final="true"] [class*="Cta"],
        [data-home-cert-final="true"] [class*="actions"],
        [data-home-cert-final="true"] [class*="Actions"],
        [data-home-cert-final="true"] [class*="cta"],
        [data-home-cert-final="true"] [class*="Cta"] {
          display: flex !important;
          flex-direction: row !important;
          flex-wrap: nowrap !important;
          align-items: center !important;
          justify-content: flex-start !important;
          gap: 1rem !important;
          width: 100% !important;
        }

        [data-home-services-final="true"] [class*="actions"] a,
        [data-home-services-final="true"] [class*="Actions"] a,
        [data-home-services-final="true"] [class*="cta"] a,
        [data-home-services-final="true"] [class*="Cta"] a,
        [data-home-cert-final="true"] [class*="actions"] a,
        [data-home-cert-final="true"] [class*="Actions"] a,
        [data-home-cert-final="true"] [class*="cta"] a,
        [data-home-cert-final="true"] [class*="Cta"] a,
        [data-home-services-final="true"] [class*="actions"] button,
        [data-home-services-final="true"] [class*="Actions"] button,
        [data-home-cert-final="true"] [class*="actions"] button,
        [data-home-cert-final="true"] [class*="Actions"] button {
          flex: 0 0 auto !important;
          width: auto !important;
          min-width: max-content !important;
          white-space: nowrap !important;
          margin: 0 !important;
        }
      }
    `;

    document.head.appendChild(style);

    return () => {
      document.getElementById(STYLE_ID)?.remove();
      document
        .querySelectorAll(
          "[data-home-hero-final], [data-home-services-final], [data-home-cert-final], [data-home-visual-card-final]"
        )
        .forEach((el) => {
          el.removeAttribute("data-home-hero-final");
          el.removeAttribute("data-home-services-final");
          el.removeAttribute("data-home-cert-final");
          el.removeAttribute("data-home-visual-card-final");
        });
    };
  }, []);

  return null;
}
