.floating {
  position: fixed;
  right: 18px;
  bottom: 20px;
  z-index: 9999;

  border: 0;
  background: transparent;
  padding: 0;

  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;

  cursor: pointer;
}

.chatBubble {
  position: relative;

  max-width: 190px;
  padding: 10px 14px;

  border: 1px solid rgba(255,255,255,.18);
  border-radius: 18px 18px 5px 18px;

  background:
    linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.07));

  color: rgba(255,255,255,.94);
  font-size: 12px;
  font-weight: 750;
  letter-spacing: -.01em;

  backdrop-filter: blur(18px) saturate(1.2);
  box-shadow:
    0 14px 34px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.18);

  animation: floatBubble 2.8s ease-in-out infinite;
}

.callPill {
  min-width: 176px;
  height: 58px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  padding: 0 18px 0 10px;

  border: 1px solid rgba(255,255,255,.16);
  border-radius: 999px;

  background:
    linear-gradient(145deg, rgba(122,9,28,.56), rgba(255,255,255,.08));

  color: rgba(255,255,255,.96);
  font-size: 13px;
  font-weight: 850;
  letter-spacing: -.01em;

  backdrop-filter: blur(22px) saturate(1.22);

  box-shadow:
    0 18px 46px rgba(0,0,0,.30),
    0 12px 34px rgba(180,12,45,.20),
    inset 0 1px 0 rgba(255,255,255,.18);

  transition: transform .22s ease, background .22s ease, border-color .22s ease;
}

.floating:hover .callPill {
  transform: translateY(-2px);
  border-color: rgba(255,255,255,.26);
  background:
    linear-gradient(145deg, rgba(156,12,38,.66), rgba(255,255,255,.11));
}

.iconCircle {
  width: 40px;
  height: 40px;
  border-radius: 50%;

  display: grid;
  place-items: center;

  background:
    radial-gradient(circle at 35% 25%, rgba(255,255,255,.42), rgba(255,255,255,.10) 38%, rgba(135,9,31,.52) 100%);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.30),
    0 8px 22px rgba(0,0,0,.24);
}

.iconCircle svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: white;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(0,0,0,.54);
  backdrop-filter: blur(10px);
}

.modal {
  position: relative;
  width: min(460px, 100%);
  padding: 34px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 28px;
  background:
    radial-gradient(circle at 85% 0%, rgba(190,18,50,.22), transparent 18rem),
    linear-gradient(145deg, rgba(15,16,20,.96), rgba(5,6,9,.96));
  color: white;
  box-shadow: 0 30px 90px rgba(0,0,0,.45);
}

.close {
  position: absolute;
  top: 16px;
  right: 18px;
  border: 0;
  background: transparent;
  color: white;
  font-size: 28px;
  cursor: pointer;
}

.modalEyebrow {
  color: #ff4968;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .16em;
}

.modal h2 {
  margin: 12px 0 10px;
  font-size: 30px;
  line-height: 1;
}

.modal p {
  color: rgba(255,255,255,.72);
  line-height: 1.55;
}

.modalCta {
  margin-top: 22px;
  height: 54px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24px;
  border-radius: 999px;
  background: linear-gradient(135deg, #9d0b28, #d51743);
  color: white;
  font-weight: 850;
  text-decoration: none;
}

@keyframes floatBubble {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-4px);
  }
}

@media (max-width: 640px) {
  .floating {
    right: 14px;
    bottom: 18px;
  }

  .chatBubble {
    font-size: 11px;
    padding: 8px 12px;
  }

  .callPill {
    min-width: 0;
    width: 62px;
    height: 62px;
    padding: 0;
  }

  .callPill > span:last-child {
    display: none;
  }

  .iconCircle {
    width: 48px;
    height: 48px;
  }
}

