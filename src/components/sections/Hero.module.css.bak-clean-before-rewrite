.hero {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #050505;
  display: flex;
  align-items: center;
  padding: 9.5rem 4.5rem 7.5rem;
}

.video,
.overlay,
.redGlow {
  position: absolute;
  inset: 0;
}

.video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(1.02) saturate(1.08) contrast(1.08);
}

.overlay {
  background:
    linear-gradient(90deg, rgba(4,6,10,.82) 0%, rgba(4,6,10,.28) 48%, rgba(4,6,10,.10) 100%),
    linear-gradient(180deg, rgba(0,0,0,.14) 0%, rgba(0,0,0,.28) 100%);
}

.redGlow {
  background:
    radial-gradient(circle at 88% 18%, rgba(193,18,47,.22), transparent 34rem),
    linear-gradient(110deg, transparent 0%, transparent 62%, rgba(193,18,47,.16) 100%);
  pointer-events: none;
}

.content {
  position: relative;
  z-index: 5;
  width: min(1120px, calc(100% - 64px));
  margin: 0 auto;
  padding-top: clamp(95px, 11vh, 125px);
  padding-bottom: 72px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.titleWrap {
  position: relative;
  max-width: 1120px;
}

.title {
  position: relative;
  inset: auto;
  margin: 0;
  max-width: 960px;
  color: #fff;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(2.7rem, 4.1vw, 4.9rem);
  line-height: .96;
  font-weight: 300;
  letter-spacing: -.055em;
  text-shadow: 0 16px 44px rgba(0,0,0,.42);
  opacity: 1;
  transform: none;
}

.titleActive {
  opacity: 1;
  transform: none;
}

.line {
  width: min(720px, 48vw);
  height: 1px;
  margin-top: 1.15rem;
  background:
    linear-gradient(
      90deg,
      rgba(255,0,76,0) 0%,
      rgba(255,0,76,.14) 10%,
      rgba(255,45,82,.72) 50%,
      rgba(255,0,76,.14) 90%,
      rgba(255,0,76,0) 100%
    );
  opacity: .45;
  box-shadow:
    0 0 10px rgba(255,45,82,.18),
    0 0 24px rgba(255,45,82,.08);
}

.actions {
  display: flex;
  align-items: center;
  gap: .85rem;
  margin-top: 1.65rem;
  flex-wrap: wrap;
}

.primaryBtn,
.secondaryBtn {
  min-width: 244px;
  height: 56px;
  border-radius: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.55rem;
  text-decoration: none;
  color: white;
  font-family: var(--font-manrope), system-ui, sans-serif;
  font-size: .9rem;
  font-weight: 650;
  letter-spacing: -.01em;
  backdrop-filter: blur(16px) saturate(1.18);
  transition: transform .24s ease, box-shadow .24s ease, background .24s ease;
}

.primaryBtn {
  border: 1px solid rgba(255,70,105,.34);
  background:
    linear-gradient(
      135deg,
      rgba(120,8,24,.96) 0%,
      rgba(165,12,38,.92) 45%,
      rgba(92,6,20,.96) 100%
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.12),
    0 10px 28px rgba(120,8,24,.34),
    0 0 22px rgba(180,18,50,.18);
}

.primaryBtn:hover {
  transform: translateY(-2px);
  background:
    linear-gradient(
      135deg,
      rgba(150,10,32,.98) 0%,
      rgba(210,22,58,.95) 50%,
      rgba(110,8,24,.98) 100%
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.16),
    0 16px 38px rgba(120,8,24,.44),
    0 0 30px rgba(210,22,58,.24);
}

.secondaryBtn {
  border: 1px solid rgba(255,255,255,.16);
  background:
    linear-gradient(
      135deg,
      rgba(12,12,12,.48),
      rgba(28,18,18,.32)
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 16px 45px rgba(0,0,0,.22);
}

.secondaryBtn:hover {
  transform: translateY(-2px);
  border-color: rgba(255,82,112,.32);
  background:
    linear-gradient(
      135deg,
      rgba(38,14,20,.50),
      rgba(15,10,12,.40)
    );
}

.commandBar {
  position: absolute;
  left: 4.5rem;
  right: 4.5rem;
  bottom: 1.8rem;
  z-index: 5;
  height: 72px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(6,6,6,.58);
  backdrop-filter: blur(18px);
  box-shadow:
    0 -20px 50px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.03);
}

.commandItem {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: .9rem;
  padding: 0 1.3rem;
  color: white;
  text-decoration: none;
  border-right: 1px solid rgba(255,255,255,.10);
  transition: background .25s ease, transform .25s ease, border-color .25s ease;
}

.commandItem:last-child {
  border-right: 0;
}

.commandItem:hover {
  transform: translateY(-2px);
  background:
    linear-gradient(90deg, rgba(193,18,47,.16), rgba(255,255,255,.045));
  box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
}

.commandItem svg {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  fill: none;
  stroke: rgba(255,255,255,.86);
  stroke-width: 1.45;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.commandItem:hover svg {
  stroke: #ff405e;
}

.commandItem span {
  display: block;
  color: #fff;
  font-size: .9rem;
  font-weight: 750;
  margin-bottom: .18rem;
}

.commandItem small {
  display: block;
  color: rgba(255,255,255,.58);
  font-size: .72rem;
  line-height: 1.25;
}

@media (max-width: 980px) {
  .hero {
    padding: 9rem 1.4rem 10rem;
  }

  .content {
    width: 100%;
  }

  .commandBar {
    left: 1rem;
    right: 1rem;
    height: auto;
    grid-template-columns: repeat(2, 1fr);
  }

  .commandItem {
    min-height: 76px;
  }
}

@media (max-width: 640px) {
  .title {
    font-size: 2.7rem;
  }

  .actions {
    flex-direction: column;
  }

  .primaryBtn,
  .secondaryBtn {
    width: 100%;
  }

  .commandBar {
    left: 0;
    right: 0;
    bottom: 0;

    width: 100%;
    height: 88px;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    border-left: 0;
    border-right: 0;
    border-bottom: 0;

    border-radius: 0;

    background: rgba(5,5,8,.92);
    backdrop-filter: blur(18px);
  }

  .commandItem {
    min-height: 88px;
    padding: 10px 6px;
    gap: 8px;

    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .commandItem svg {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }

  .commandItem span {
    font-size: 11px;
    margin: 0;
  }

  .commandItem small {
    font-size: 9px;
    line-height: 1.1;
  }
}

