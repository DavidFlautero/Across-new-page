/* =====================================================
   HOME PREMIUM BLUE ACCENT
   Quita rojo visual y lo reemplaza por azul corporativo.
   ===================================================== */

:root {
  --across-premium-blue: #0f3d5e;
  --across-premium-blue-soft: #1f6f94;
}


/* =====================================================
   HOME SECTION PREMIUM INK REBRAND
   Reemplaza rojo agresivo por azul tinta + champagne.
   Aplica dentro de la sección sin romper CSS Modules.
   ===================================================== */

.section {
  --section-ink: #081521;
  --section-ink-soft: #13283b;
  --section-blue: #173247;
  --section-steel: #5d6b78;
  --section-champagne: #cdbb8d;
  --section-paper: #f7f4ee;
}

/* Eyebrows / labels */
.section :where(.eyebrow, .kicker, .label) {
  color: var(--section-blue) !important;
  letter-spacing: .22em !important;
  font-weight: 900 !important;
}

/* Si el label está como texto simple dentro de otro bloque */
.section :where(span, small) {
  border-color: rgba(205, 187, 141, .34) !important;
}

/* Títulos más premium */
.section :where(h1, h2, h3) {
  color: var(--section-ink) !important;
  letter-spacing: -0.055em !important;
  line-height: .94 !important;
  font-weight: 900 !important;
}

/* Punto/acento del título: de rojo a champagne/ink */
.section :where(h1, h2, h3) span,
.section :where(h1, h2, h3) strong {
  color: var(--section-blue) !important;
}

/* Párrafos */
.section :where(p) {
  color: rgba(8, 21, 33, .72) !important;
  line-height: 1.72 !important;
  font-weight: 500 !important;
}

/* Bullets / puntos */
.section :where(li)::marker {
  color: var(--section-blue) !important;
}

.section :where(li) {
  color: rgba(8, 21, 33, .82) !important;
  font-weight: 800 !important;
}

/* Dots decorativos comunes */
.section :where(i, b)::before,
.section :where(i, b)::after {
  background: var(--section-blue) !important;
}

/* Links tipo "Conocer más" */
.section :where(a) {
  color: var(--section-blue) !important;
  text-decoration: none !important;
  letter-spacing: .14em !important;
  font-weight: 900 !important;
}

.section :where(a:hover) {
  color: var(--section-ink) !important;
}

/* Cards / imagen */
.section :where(img) {
  filter:
    saturate(.92)
    contrast(1.02)
    brightness(.98) !important;
}

/* Mobile: título más fino y menos brutal */
@media (max-width: 760px) {
  .section :where(h1, h2, h3) {
    font-size: clamp(2.25rem, 10vw, 3.15rem) !important;
    line-height: .96 !important;
    letter-spacing: -0.06em !important;
  }

  .section :where(p) {
    font-size: .98rem !important;
    line-height: 1.74 !important;
  }

  .section :where(a) {
    font-size: .78rem !important;
  }
}

