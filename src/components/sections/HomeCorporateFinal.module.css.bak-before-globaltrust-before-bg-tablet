/* === SOLUTIONS PANEL REAL LAYERS PREMIUM START === */
/* Panel derecho de soluciones usando capas reales:
   solutionsPanelBgImg / BlueLayer / TextureLayer / Content / Stats / Cta
*/

.solutionsPanel {
  position: relative !important;
  overflow: hidden !important;
  isolation: isolate !important;

  border-radius: 10px !important;
  border: 1px solid rgba(214, 192, 141, .42) !important;

  box-shadow:
    0 30px 80px rgba(7, 17, 29, .20),
    inset 0 1px 0 rgba(255, 255, 255, .12) !important;
}

/* imagen real */
.solutionsPanelBgImg {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;

  object-fit: cover !important;
  object-position: center center !important;

  filter: saturate(.92) contrast(1.04) brightness(.86) !important;
  z-index: 0 !important;
}

/* capa azul elegante */
.solutionsPanelBlueLayer {
  position: absolute !important;
  inset: 0 !important;
  z-index: 1 !important;
  pointer-events: none !important;

  background:
    linear-gradient(
      90deg,
      rgba(7, 17, 29, .82) 0%,
      rgba(7, 17, 29, .58) 48%,
      rgba(7, 17, 29, .22) 100%
    ),
    linear-gradient(
      180deg,
      rgba(7, 17, 29, .14) 0%,
      rgba(7, 17, 29, .04) 48%,
      rgba(7, 17, 29, .38) 100%
    ) !important;

  opacity: 1 !important;
}

/* textura fina */
.solutionsPanelTextureLayer {
  position: absolute !important;
  inset: 0 !important;
  z-index: 2 !important;
  pointer-events: none !important;

  background:
    radial-gradient(circle at 14% 18%, rgba(214, 192, 141, .26) 0 1px, transparent 2px),
    radial-gradient(circle at 78% 22%, rgba(255, 255, 255, .12) 0 1px, transparent 2px),
    linear-gradient(90deg, rgba(214, 192, 141, .075) 1px, transparent 1px),
    linear-gradient(180deg, rgba(214, 192, 141, .055) 1px, transparent 1px) !important;

  background-size:
    38px 38px,
    52px 52px,
    100% 100%,
    100% 100% !important;

  opacity: .46 !important;
  mix-blend-mode: screen !important;
}

/* contenido arriba de las capas */
.solutionsPanelContent,
.panelStats,
.solutionsPanelCta {
  position: relative !important;
  z-index: 5 !important;
}

/* bloque superior */
.solutionsPanelContent {
  max-width: 86% !important;
}

.solutionsPanelContent span {
  color: #d6c08d !important;
  -webkit-text-fill-color: #d6c08d !important;
  letter-spacing: .34em !important;
  text-shadow: 0 8px 20px rgba(0, 0, 0, .52) !important;
}

.solutionsPanelContent h1,
.solutionsPanelContent h2,
.solutionsPanelContent h3,
.solutionsPanelContent strong {
  color: #f4efe4 !important;
  -webkit-text-fill-color: #f4efe4 !important;
  text-shadow: 0 14px 34px rgba(0, 0, 0, .70) !important;
}

/* items */
.panelStats {
  gap: 18px !important;
}

.panelStats h3,
.panelStats strong {
  color: #f4efe4 !important;
  -webkit-text-fill-color: #f4efe4 !important;
  text-shadow: 0 12px 28px rgba(0, 0, 0, .66) !important;
}

.panelStats p,
.panelStats small,
.panelStats span {
  color: rgba(244, 239, 228, .88) !important;
  -webkit-text-fill-color: rgba(244, 239, 228, .88) !important;
  text-shadow: 0 9px 22px rgba(0, 0, 0, .60) !important;
}

/* círculos / iconos del panel */
.solutionsPanel [class*="icon"],
.solutionsPanel [class*="Icon"],
.solutionsPanel [class*="bullet"],
.solutionsPanel [class*="Bullet"],
.solutionsPanel [class*="circle"],
.solutionsPanel [class*="Circle"] {
  border: 1px solid rgba(214, 192, 141, .72) !important;
  background: rgba(214, 192, 141, .10) !important;

  box-shadow:
    0 0 0 1px rgba(214, 192, 141, .18),
    0 0 20px rgba(214, 192, 141, .24),
    inset 0 1px 0 rgba(255, 255, 255, .12) !important;

  opacity: 1 !important;
}

/* botón */
.solutionsPanelCta {
  background:
    radial-gradient(circle at 18% 0, rgba(255, 255, 255, .16), transparent 34%),
    linear-gradient(135deg, #07111d 0%, #0d1c2b 48%, #14344a 100%) !important;

  color: #f4efe4 !important;
  -webkit-text-fill-color: #f4efe4 !important;

  border: 1px solid rgba(214, 192, 141, .58) !important;
  border-radius: 999px !important;

  box-shadow:
    0 18px 38px rgba(0, 0, 0, .30),
    0 0 24px rgba(214, 192, 141, .10),
    inset 0 1px 0 rgba(255, 255, 255, .16) !important;

  font-weight: 950 !important;
  letter-spacing: .08em !important;
  text-transform: uppercase !important;
}

.solutionsPanelCta::after {
  color: #d6c08d !important;
  -webkit-text-fill-color: #d6c08d !important;
}

/* Mobile: que no se rompa */
@media (max-width: 768px) {
  .solutionsPanelContent {
    max-width: 92% !important;
  }

  .panelStats {
    gap: 14px !important;
  }

  .solutionsPanelBlueLayer {
    background:
      linear-gradient(
        90deg,
        rgba(7, 17, 29, .86) 0%,
        rgba(7, 17, 29, .62) 52%,
        rgba(7, 17, 29, .32) 100%
      ),
      linear-gradient(
        180deg,
        rgba(7, 17, 29, .18) 0%,
        rgba(7, 17, 29, .08) 48%,
        rgba(7, 17, 29, .42) 100%
      ) !important;
  }

  .solutionsPanelBgImg {
    filter: saturate(.90) contrast(1.04) brightness(.82) !important;
  }
}
/* === SOLUTIONS PANEL REAL LAYERS PREMIUM END === */

/* === HOME SOLUTIONS PANEL PREMIUM FINAL === */
@media (min-width: 901px) {
  .solutionsPanel {
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
    min-height: 455px !important;
    padding: 36px 34px 28px !important;
    overflow: hidden !important;
    border-radius: 14px !important;
    border: 1px solid rgba(255, 255, 255, .14) !important;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, .22),
      inset 0 1px 0 rgba(255, 255, 255, .10) !important;
  }

  .solutionsPanel h2,
  .solutionsPanel h3 {
    max-width: 420px !important;
    margin-bottom: 1.2rem !important;
    color: #fff !important;
    line-height: .98 !important;
    letter-spacing: -.045em !important;
    text-shadow: 0 5px 22px rgba(0, 0, 0, .72) !important;
  }

  .panelStats {
    display: grid !important;
    gap: .72rem !important;
    margin: 0 0 .9rem !important;
    padding: 0 !important;
  }

  .panelStats > div {
    position: relative !important;
    display: grid !important;
    grid-template-columns: 34px minmax(0, 1fr) !important;
    column-gap: .82rem !important;
    align-items: center !important;
    padding: .72rem .86rem !important;
    border-radius: 14px !important;

    background:
      linear-gradient(
        180deg,
        rgba(5, 31, 55, .74),
        rgba(5, 20, 34, .58)
      ) !important;

    border: 1px solid rgba(210, 164, 92, .26) !important;

    box-shadow:
      0 14px 32px rgba(0, 0, 0, .24),
      inset 0 1px 0 rgba(255, 255, 255, .10) !important;

    backdrop-filter: blur(10px) saturate(135%) !important;
    -webkit-backdrop-filter: blur(10px) saturate(135%) !important;
  }

  .panelStats > div::before {
    grid-column: 1 !important;
    grid-row: 1 / span 2 !important;
    width: 28px !important;
    height: 28px !important;
    display: grid !important;
    place-items: center !important;
    border-radius: 999px !important;
    background: rgba(2, 9, 16, .92) !important;
    border: 1px solid rgba(210, 164, 92, .72) !important;
    color: #d2a45c !important;
    font-size: .82rem !important;
    font-weight: 950 !important;
    line-height: 1 !important;
    box-shadow:
      0 8px 20px rgba(0, 0, 0, .32),
      inset 0 1px 0 rgba(255, 255, 255, .10) !important;
  }

  .panelStats > div:nth-child(1)::before {
    content: "⇄" !important;
  }

  .panelStats > div:nth-child(2)::before {
    content: "✓" !important;
  }

  .panelStats > div:nth-child(3)::before {
    content: "⌖" !important;
  }

  .panelStats > div::after {
    display: none !important;
    content: none !important;
  }

  .panelStats strong {
    grid-column: 2 !important;
    display: block !important;
    margin: 0 0 .16rem !important;
    color: #ffffff !important;
    font-size: .98rem !important;
    line-height: 1.08 !important;
    text-shadow: 0 3px 14px rgba(0, 0, 0, .66) !important;
  }

  .panelStats small {
    grid-column: 2 !important;
    display: block !important;
    color: rgba(255, 255, 255, .84) !important;
    font-size: .71rem !important;
    line-height: 1.25 !important;
    font-weight: 800 !important;
    text-shadow: 0 3px 12px rgba(0, 0, 0, .58) !important;
  }

  .solutionsPanel a[href] {
    align-self: flex-start !important;
    margin-top: .35rem !important;
    min-height: 44px !important;
    padding: 0 1.45rem !important;
    border-radius: 999px !important;
    background: rgba(5, 31, 55, .94) !important;
    border: 1px solid rgba(210, 164, 92, .76) !important;
    color: #fff !important;
    box-shadow:
      0 14px 32px rgba(0, 0, 0, .30),
      inset 0 1px 0 rgba(255, 255, 255, .14) !important;
    text-shadow: none !important;
    white-space: nowrap !important;
  }

  .solutionsPanel a[href]:hover {
    background: rgba(8, 40, 66, .98) !important;
    border-color: rgba(210, 164, 92, .96) !important;
    transform: translateY(-1px) !important;
  }
}

@media (min-width: 1181px) {
  .solutionsPanel {
    min-height: 445px !important;
    padding-top: 34px !important;
    padding-bottom: 26px !important;
  }

  .panelStats {
    gap: .68rem !important;
    margin-bottom: .78rem !important;
  }

  .panelStats > div {
    padding-top: .64rem !important;
    padding-bottom: .64rem !important;
  }

  .solutionsPanel a[href] {
    margin-top: .2rem !important;
  }
}

