.integrated,
.services {
  position: relative;
  overflow: hidden;
  color: #111;
  background:
    radial-gradient(circle at 12% 4%, rgba(180, 0, 50, .07), transparent 28rem),
    linear-gradient(180deg, #f7f4ee 0%, #eee9df 100%);
}

.integrated::before,
.services::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,0,0,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,.025) 1px, transparent 1px);
  background-size: 86px 86px;
  opacity: .24;
  pointer-events: none;
}

.integrated {
  padding: clamp(4.8rem, 8vw, 7rem) 0 clamp(4rem, 7vw, 6rem);
}

.services {
  padding: clamp(4.5rem, 7.5vw, 6.8rem) 0;
  border-top: 1px solid rgba(0,0,0,.08);
}

.integratedInner,
.servicesInner {
  position: relative;
  z-index: 1;
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.integratedInner {
  display: grid;
  grid-template-columns: minmax(0, .82fr) minmax(430px, 1.18fr);
  gap: clamp(2.5rem, 5vw, 5.5rem);
  align-items: center;
}

.copy span,
.servicesHead span {
  display: inline-flex;
  margin-bottom: .9rem;
  color: #b40032;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.copy h2,
.servicesHead h2 {
  max-width: 760px;
  margin: 0;
  color: #111;
  font-size: clamp(2.55rem, 5.2vw, 5.65rem);
  line-height: .9;
  letter-spacing: -.078em;
}

.copy h2::after,
.servicesHead h2::after {
  content: ".";
  color: #b40032;
}

.copy p {
  max-width: 560px;
  margin: 1.3rem 0 0;
  color: rgba(0,0,0,.66);
  font-size: clamp(1rem, 1.2vw, 1.1rem);
  line-height: 1.72;
}

.copy ul {
  margin: 1.55rem 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: .72rem;
}

.copy li {
  position: relative;
  padding-left: 1.45rem;
  color: rgba(0,0,0,.74);
  font-size: .95rem;
  font-weight: 800;
}

.copy li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .43rem;
  width: .55rem;
  height: .55rem;
  border-radius: 999px;
  background: #b40032;
  box-shadow: 0 0 0 5px rgba(180,0,50,.08);
}

.copy a {
  width: fit-content;
  margin-top: 1.75rem;
  display: inline-flex;
  color: #b40032;
  text-decoration: none;
  font-size: .8rem;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.heroImage {
  position: relative;
  min-height: 430px;
  overflow: hidden;
  border-radius: 28px;
  background: #090a0d;
  box-shadow: 0 34px 105px rgba(0,0,0,.16);
  isolation: isolate;
}

.heroImage img {
  object-fit: cover;
  filter: brightness(.9) contrast(1.05) saturate(1.04);
  transform: scale(1.02);
}

.heroImage::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0,0,0,.02), rgba(0,0,0,.18)),
    radial-gradient(circle at 84% 12%, rgba(180,0,50,.16), transparent 18rem);
  pointer-events: none;
}

.servicesHead {
  max-width: 850px;
  margin-bottom: clamp(2rem, 4vw, 3rem);
}

.servicesLayout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  gap: clamp(2rem, 4vw, 4rem);
  align-items: start;
}

.serviceList {
  border-top: 1px solid rgba(0,0,0,.13);
}

.serviceRow {
  min-height: 76px;
  display: grid;
  grid-template-columns: 44px 42px minmax(0, 1fr) 34px;
  gap: 1rem;
  align-items: center;
  padding: .85rem 0;
  border-bottom: 1px solid rgba(0,0,0,.12);
  color: #111;
  text-decoration: none;
  transition: transform .22s ease, border-color .22s ease;
}

.serviceRow strong {
  color: #b40032;
  font-size: .86rem;
  font-weight: 950;
  letter-spacing: .08em;
}

.serviceIcon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  color: rgba(0, 0, 0, .78);
}

.serviceIcon svg {
  width: 28px;
  height: 28px;
  display: block;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: transform .22s ease, color .22s ease;
}

.serviceRow h3 {
  margin: 0;
  color: #111;
  font-size: clamp(1rem, 1.15vw, 1.18rem);
  line-height: 1.08;
  letter-spacing: -.035em;
}

.serviceRow p {
  max-width: 460px;
  margin: .28rem 0 0;
  color: rgba(0,0,0,.58);
  font-size: .86rem;
  line-height: 1.42;
}

.serviceRow i {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: #b40032;
  background: rgba(180,0,50,.06);
  font-style: normal;
  font-weight: 900;
}

.serviceRow:hover {
  transform: translateX(4px);
  border-color: rgba(180,0,50,.34);
}

.serviceRow:hover .serviceIcon {
  color: #b40032;
}

.serviceRow:hover .serviceIcon svg {
  transform: translateX(2px);
}

.solutionsPanel {
  position: sticky;
  top: 110px;
  min-height: 470px;
  padding: 34px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 8px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(5, 6, 9, .62) 0%, rgba(5, 6, 9, .88) 100%),
    radial-gradient(circle at 88% 0%, rgba(180, 0, 50, .34), transparent 220px),
    url("/images/sectores/transporteterrestre.png") center / cover no-repeat;
  color: #fff;
  box-shadow:
    0 32px 90px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.solutionsPanel::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 42px 42px;
  opacity: .18;
}

.solutionsPanel > * {
  position: relative;
  z-index: 1;
}

.solutionsPanel span {
  display: inline-flex;
  margin-bottom: 14px;
  color: #d8ab62;
  font-size: 10px;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.solutionsPanel h3 {
  max-width: 270px;
  margin: 0;
  color: #fff;
  font-size: 26px;
  line-height: 1.12;
  letter-spacing: -.045em;
  font-weight: 850;
}

.solutionsPanel p {
  max-width: 275px;
  margin: 22px 0 0;
  color: rgba(255,255,255,.78);
  font-size: 13px;
  line-height: 1.72;
}

.panelStats {
  display: grid;
  gap: 0;
  margin-top: 28px;
}

.panelStats div {
  position: relative;
  min-height: 68px;
  padding: 18px 0 0 44px;
  border-top: 1px solid rgba(255,255,255,.16);
}

.panelStats div::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18px;
  width: 24px;
  height: 24px;
  border-radius: 999px;
  border: 1px solid rgba(216,171,98,.55);
  background: radial-gradient(circle, rgba(180,0,50,.35), transparent 58%);
}

.panelStats strong {
  display: block;
  color: #fff;
  font-size: 18px;
  line-height: 1;
  font-weight: 950;
  letter-spacing: -.04em;
}

.panelStats small {
  display: block;
  margin-top: 5px;
  color: rgba(255,255,255,.62);
  font-size: 11px;
  line-height: 1.35;
}

@media (max-width: 1020px) {
  .integratedInner,
  .servicesLayout {
    grid-template-columns: 1fr;
  }

  .solutionsPanel {
    position: relative;
    top: auto;
    max-width: none;
    min-height: 320px;
  }

  .panelStats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
}

@media (max-width: 640px) {
  .integrated,
  .services {
    padding: 4rem 0;
  }

  .integratedInner,
  .servicesInner {
    width: calc(100% - 28px);
  }

  .copy h2,
  .servicesHead h2 {
    font-size: clamp(2.1rem, 10vw, 3.1rem);
    line-height: .93;
  }

  .heroImage {
    min-height: 230px;
    border-radius: 24px;
  }

  .serviceRow {
    min-height: auto;
    grid-template-columns: 34px 32px minmax(0, 1fr) 30px;
    gap: .8rem;
    padding: 1rem 0;
  }

  .serviceIcon {
    width: 30px;
    height: 30px;
  }

  .serviceIcon svg {
    width: 24px;
    height: 24px;
  }

  .serviceRow h3 {
    font-size: 1.02rem;
  }

  .serviceRow p {
    font-size: .82rem;
  }

  .solutionsPanel {
    min-height: auto;
    padding: 24px 20px;
    border-radius: 10px;
  }

  .solutionsPanel h3 {
    max-width: 280px;
    font-size: 24px;
  }

  .solutionsPanel p {
    max-width: 300px;
  }

  .panelStats {
    grid-template-columns: 1fr;
    margin-top: 24px;
  }
}

/* GLOBAL TRUST MAP SECTION */
.globalTrust {
  position: relative;
  overflow: hidden;
  padding: clamp(4.8rem, 7vw, 6.8rem) 0;
  background:
    radial-gradient(circle at 72% 18%, rgba(180, 0, 50, .18), transparent 34rem),
    linear-gradient(180deg, #08090d 0%, #030406 100%);
  color: #fff;
}

.globalTrust::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 74px 74px;
  opacity: .18;
}

.globalInner {
  position: relative;
  z-index: 1;
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.globalHeader {
  max-width: 720px;
  margin-bottom: clamp(2rem, 4vw, 3.2rem);
}

.globalHeader span {
  display: inline-flex;
  margin-bottom: .9rem;
  color: #b40032;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.globalHeader h2 {
  margin: 0;
  max-width: 720px;
  color: #fff;
  font-size: clamp(2.35rem, 4.6vw, 4.9rem);
  line-height: .92;
  letter-spacing: -.072em;
}

.globalHeader h2::after {
  content: ".";
  color: #b40032;
}

.globalBody {
  display: grid;
  grid-template-columns: minmax(260px, .38fr) minmax(0, 1fr);
  gap: clamp(2rem, 4vw, 4rem);
  align-items: center;
}

.globalStats {
  display: grid;
  gap: 1rem;
}

.globalStats div {
  padding: 1.1rem 0;
  border-top: 1px solid rgba(255,255,255,.12);
}

.globalStats strong {
  display: block;
  color: #fff;
  font-size: 1.05rem;
  font-weight: 950;
  letter-spacing: -.025em;
}

.globalStats p {
  max-width: 310px;
  margin: .45rem 0 0;
  color: rgba(255,255,255,.64);
  font-size: .9rem;
  line-height: 1.55;
}

.mapPanel {
  position: relative;
  min-height: 390px;
  border-radius: 28px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 45%, rgba(180,0,50,.12), transparent 28rem),
    linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.015));
  border: 1px solid rgba(255,255,255,.08);
  box-shadow:
    0 34px 110px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.worldSvg {
  position: absolute;
  inset: 8% 4%;
  width: 92%;
  height: 84%;
  opacity: .42;
  filter: drop-shadow(0 0 18px rgba(180,0,50,.12));
}

.worldSvg path {
  fill: rgba(255,255,255,.12);
  stroke: rgba(255,255,255,.08);
  stroke-width: 1;
}

.mapPin {
  position: absolute;
  width: 18px;
  height: 18px;
  transform: translate(-50%, -50%);
  z-index: 4;
  text-decoration: none;
}

.pinDot {
  position: absolute;
  inset: 4px;
  border-radius: 999px;
  background: #b40032;
  box-shadow:
    0 0 0 5px rgba(180,0,50,.15),
    0 0 26px rgba(180,0,50,.62);
}

.pinDot::after {
  content: "";
  position: absolute;
  inset: -7px;
  border-radius: inherit;
  border: 1px solid rgba(180,0,50,.45);
  animation: pulsePin 2.4s ease-out infinite;
}

@keyframes pulsePin {
  0% {
    transform: scale(.65);
    opacity: .75;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}

.pinCard {
  position: absolute;
  left: 50%;
  bottom: 22px;
  width: 190px;
  padding: .85rem;
  border-radius: 14px;
  background: rgba(7,8,12,.94);
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 22px 60px rgba(0,0,0,.32);
  color: #fff;
  transform: translateX(-50%) translateY(8px);
  opacity: 0;
  pointer-events: none;
  transition: opacity .18s ease, transform .18s ease;
}

.mapPin:hover {
  z-index: 8;
}

.mapPin:hover .pinCard,
.mapPin:focus-visible .pinCard {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.pinCard strong {
  display: block;
  color: #fff;
  font-size: .95rem;
  font-weight: 950;
}

.pinCard small {
  display: block;
  margin-top: .2rem;
  color: rgba(255,255,255,.58);
  font-size: .78rem;
}

.pinCard em {
  display: block;
  margin-top: .55rem;
  color: rgba(255,255,255,.82);
  font-size: .8rem;
  font-style: normal;
}

.pinCard b {
  display: block;
  margin-top: .65rem;
  color: #d8ab62;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.certStrip {
  margin-top: 2rem;
  padding-top: 1.6rem;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: .85rem;
  border-top: 1px solid rgba(255,255,255,.12);
}

.certStrip span {
  min-height: 56px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: rgba(255,255,255,.045);
  border: 1px solid rgba(255,255,255,.08);
  color: rgba(255,255,255,.82);
  font-size: .8rem;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.mobileOffices {
  display: none;
}

@media (max-width: 1020px) {
  .globalBody {
    grid-template-columns: 1fr;
  }

  .globalStats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .mapPanel {
    min-height: 330px;
  }

  .certStrip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .globalTrust {
    padding: 4rem 0;
  }

  .globalInner {
    width: calc(100% - 28px);
  }

  .globalHeader h2 {
    font-size: clamp(2.1rem, 10vw, 3.1rem);
    line-height: .94;
  }

  .globalStats {
    grid-template-columns: 1fr;
  }

  .mapPanel {
    min-height: 250px;
    border-radius: 22px;
  }

  .pinCard {
    display: none;
  }

  .certStrip {
    grid-template-columns: 1fr;
  }

  .mobileOffices {
    margin-top: 1.3rem;
    display: grid;
    gap: .75rem;
  }

  .mobileOffices a {
    padding: 1rem;
    display: grid;
    gap: .22rem;
    border-radius: 16px;
    background: rgba(255,255,255,.055);
    border: 1px solid rgba(255,255,255,.09);
    color: #fff;
    text-decoration: none;
  }

  .mobileOffices strong {
    font-size: 1rem;
  }

  .mobileOffices small,
  .mobileOffices span {
    color: rgba(255,255,255,.62);
    font-size: .82rem;
  }
}

