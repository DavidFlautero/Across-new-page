    linear-gradient(90deg, rgba(5,6,9,.96) 0%, rgba(5,6,9,.82) 42%, rgba(5,6,9,.36) 100%),
    url("/images/operador/contacenter.png") center right / cover no-repeat,
    #050609;
  color: #fff;
}

.homeFinalCtaInner {
  width: min(1180px, calc(100% - 40px));
  min-height: inherit;
  margin: 0 auto;
  display: flex;
  align-items: center;
}

.homeFinalCta h2 {
  max-width: 520px;
  margin: 0;
  color: #fff;
  font-size: clamp(2rem, 3.8vw, 4rem);
  line-height: .94;
  letter-spacing: -.065em;
}

.homeFinalCta h2::after {
  content: ".";
  color: #b40032;
}

.homeFinalCta p {
  margin: .75rem 0 1.4rem;
  color: rgba(255,255,255,.76);
  font-size: 1rem;
}

.homeFinalCta a {
  min-height: 46px;
  padding: 0 1.35rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  background: #b40032;
  color: #fff;
  text-decoration: none;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .04em;
  text-transform: uppercase;
}

@media (max-width: 1020px) {
  .homeOfficesGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .allOfficesCard {
    min-height: 140px;
  }
}

@media (max-width: 640px) {
  .homeOffices {
    padding: 3.6rem 0;
  }

  .homeOfficesInner,
  .homeFinalCtaInner {
    width: calc(100% - 28px);
  }

  .homeOfficesGrid {
    grid-template-columns: 1fr;
  }

  .homeOfficeCard {
    min-height: auto;
  }

  .homeOfficeImage {
    height: 110px;
  }

  .homeFinalCta {
    min-height: 300px;
    background:
      linear-gradient(180deg, rgba(5,6,9,.92) 0%, rgba(5,6,9,.78) 48%, rgba(5,6,9,.96) 100%),
      url("/images/operador/contacenter.png") center / cover no-repeat,
      #050609;
  }

  .homeFinalCta h2 {
    max-width: 320px;
    font-size: clamp(2rem, 10vw, 3rem);
  }

  .homeFinalCta a {
    width: 100%;
  }
}
