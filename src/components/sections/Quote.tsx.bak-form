"use client";
import { useState } from "react";
import styles from "./Quote.module.css";

const steps = [
  "Datos de Contacto",
  "Operación",
  "Tipo de Carga",
  "Requerimientos Finales"
];

export default function Quote() {
  const [step, setStep] = useState(0);
  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(false);

  const [form, setForm] = useState({
    name: "",
    company: "",
    email: "",
    phone: "",
    origin: "",
    destination: "",
    operation: "",
    service: "",
    incoterm: "",
    cargo: "",
    weight: "",
    dimensions: "",
    condition: "",
    message: "",
    privacyAccepted: false,
  });

  const nextStep = () => {
    if (step < steps.length - 1) setStep(step + 1);
  };

  const prevStep = () => {
    if (step > 0) setStep(step - 1);
  };

  const submitQuote = async () => {
    if (!form.privacyAccepted || loading) return;
    try {
      setLoading(true);
      const response = await fetch("/api/cotizacion", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...form,
          country: "Colombia",
          website: window.location.origin,
          marketingAccepted: false,
        }),
      });

      if (response.ok) {
        setSuccess(true);
      } else {
        alert("Error al enviar. Inténtelo nuevamente.");
      }
    } catch (error) {
      alert("Error de conexión. Inténtelo nuevamente.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <section id="cotizacion" className={styles.section}>
      <div className={styles.shell}>
        <aside className={styles.sidebar}>
          <span>Cotización Express</span>
          <h1>Solicite su presupuesto logístico</h1>
          <p>Complete el formulario paso a paso. Nuestro equipo le enviará una propuesta personalizada.</p>
        </aside>

        <div className={styles.card}>
          <div className={styles.cardTop}>
            <small>Paso {step + 1} de {steps.length}</small>
            <strong>{steps[step]}</strong>
          </div>

          <form onSubmit={(e) => e.preventDefault()}>
            {/* Paso 1 */}
            {step === 0 && (
              <div className={styles.grid}>
                <input placeholder="Nombre completo *" value={form.name} onChange={(e) => setForm({...form, name: e.target.value})} required />
                <input placeholder="Empresa *" value={form.company} onChange={(e) => setForm({...form, company: e.target.value})} required />
                <input type="email" placeholder="Email *" value={form.email} onChange={(e) => setForm({...form, email: e.target.value})} required />
                <input placeholder="Teléfono *" value={form.phone} onChange={(e) => setForm({...form, phone: e.target.value})} required />
              </div>
            )}

            {/* Paso 2 */}
            {step === 1 && (
              <div className={styles.grid}>
                <input placeholder="Origen (Ciudad / Puerto) *" value={form.origin} onChange={(e) => setForm({...form, origin: e.target.value})} />
                <input placeholder="Destino (Ciudad / Puerto) *" value={form.destination} onChange={(e) => setForm({...form, destination: e.target.value})} />
                <select value={form.operation} onChange={(e) => setForm({...form, operation: e.target.value})}>
                  <option value="">Tipo de operación *</option>
                  <option>Importación</option>
                  <option>Exportación</option>
                  <option>Nacional</option>
                </select>
              </div>
            )}

            {/* Paso 3 */}
            {step === 2 && (
              <div className={styles.grid}>
                <select value={form.service} onChange={(e) => setForm({...form, service: e.target.value})}>
                  <option value="">Servicio requerido *</option>
                  <option>Transporte Aéreo</option>
                  <option>Transporte Marítimo</option>
                  <option>Cargas Especiales</option>
                  <option>Temperatura Controlada</option>
                  <option>Almacén y Distribución</option>
                  <option>Servicios de Aduanas</option>
                  <option>e-Commerce</option>
                </select>
                <input placeholder="Peso aproximado (Kg)" value={form.weight} onChange={(e) => setForm({...form, weight: e.target.value})} />
                <input placeholder="Volumen (m³)" value={form.dimensions} onChange={(e) => setForm({...form, dimensions: e.target.value})} />
              </div>
            )}

            {/* Paso 4 */}
            {step === 3 && (
              <div>
                <textarea 
                  placeholder="Describa su necesidad logística, fechas o requerimientos especiales..." 
                  value={form.message}
                  onChange={(e) => setForm({...form, message: e.target.value})}
                  rows={5}
                />
                <label>
                  <input 
                    type="checkbox" 
                    checked={form.privacyAccepted}
                    onChange={(e) => setForm({...form, privacyAccepted: e.target.checked})}
                  />
                  Acepto el tratamiento de mis datos para recibir respuesta comercial.
                </label>
              </div>
            )}

            <div className={styles.actions}>
              <button type="button" onClick={prevStep} disabled={step === 0}>Anterior</button>
              {step < steps.length - 1 ? (
                <button type="button" className={styles.primary} onClick={nextStep}>Siguiente</button>
              ) : (
                <button type="button" className={styles.primary} onClick={submitQuote} disabled={loading || !form.privacyAccepted}>
                  {loading ? "Enviando..." : "Solicitar Presupuesto"}
                </button>
              )}
            </div>
          </form>
        </div>
      </div>
    </section>
  );
}
