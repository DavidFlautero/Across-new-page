.integrated,
.services {
  position: relative;
  overflow: hidden;
  color: #111;
  background:
    radial-gradient(circle at 12% 4%, rgba(180, 0, 50, .07), transparent 28rem),
    linear-gradient(180deg, #f7f4ee 0%, #eee9df 100%);
}

.integrated::before,
.services::before,
.homeOffices::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,0,0,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,.025) 1px, transparent 1px);
  background-size: 86px 86px;
  opacity: .18;
  pointer-events: none;
}

.integrated {
  padding: clamp(4.8rem, 8vw, 7rem) 0 clamp(4rem, 7vw, 6rem);
}

.services {
  padding: clamp(4.5rem, 7.5vw, 6.8rem) 0;
  border-top: 1px solid rgba(0,0,0,.08);
}

.integratedInner,
.servicesInner,
.homeOfficesInner,
.homeFinalCtaInner {
  position: relative;
  z-index: 1;
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.integratedInner {
  display: grid;
  grid-template-columns: minmax(0, .82fr) minmax(430px, 1.18fr);
  gap: clamp(2.5rem, 5vw, 5.5rem);
  align-items: center;
}

.copy span,
.servicesHead span,
.homeOfficesHead span {
  display: inline-flex;
  margin-bottom: .9rem;
  color: #b40032;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.copy h2,
.servicesHead h2 {
  max-width: 760px;
  margin: 0;
  color: #111;
  font-size: clamp(2.55rem, 5.2vw, 5.65rem);
  line-height: .9;
  letter-spacing: -.078em;
}

.copy h2::after,
.servicesHead h2::after,
.homeOfficesHead h2::after,
.globalContent h2::after,
.homeFinalCta h2::after {
  content: ".";
  color: #b40032;
}

.copy p {
  max-width: 560px;
  margin: 1.3rem 0 0;
  color: rgba(0,0,0,.66);
  font-size: clamp(1rem, 1.2vw, 1.1rem);
  line-height: 1.72;
}

.copy ul {
  margin: 1.55rem 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: .72rem;
}

.copy li {
  position: relative;
  padding-left: 1.45rem;
  color: rgba(0,0,0,.74);
  font-size: .95rem;
  font-weight: 800;
}

.copy li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .43rem;
  width: .55rem;
  height: .55rem;
  border-radius: 999px;
  background: #b40032;
  box-shadow: 0 0 0 5px rgba(180,0,50,.08);
}

.copy a {
  width: fit-content;
  margin-top: 1.75rem;
  display: inline-flex;
  color: #b40032;
  text-decoration: none;
  font-size: .8rem;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.heroImage {
  position: relative;
  min-height: 430px;
  overflow: hidden;
  border-radius: 28px;
  background: #090a0d;
  box-shadow: 0 34px 105px rgba(0,0,0,.16);
  isolation: isolate;
}

.heroImage img {
  object-fit: cover;
  filter: brightness(.9) contrast(1.05) saturate(1.04);
  transform: scale(1.02);
}

.heroImage::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0,0,0,.02), rgba(0,0,0,.18)),
    radial-gradient(circle at 84% 12%, rgba(180,0,50,.16), transparent 18rem);
  pointer-events: none;
}

/* SERVICES */

.servicesHead {
  max-width: 850px;
  margin-bottom: clamp(2rem, 4vw, 3rem);
}

.servicesLayout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  gap: clamp(2rem, 4vw, 4rem);
  align-items: start;
}

.serviceList {
  border-top: 1px solid rgba(0,0,0,.13);
}

.serviceRow {
  min-height: 76px;
  display: grid;
  grid-template-columns: 44px 42px minmax(0, 1fr) 34px;
  gap: 1rem;
  align-items: center;
  padding: .85rem 0;
  border-bottom: 1px solid rgba(0,0,0,.12);
  color: #111;
  text-decoration: none;
  transition: transform .22s ease, border-color .22s ease;
}

.serviceRow strong {
  color: #b40032;
  font-size: .86rem;
  font-weight: 950;
  letter-spacing: .08em;
}

.serviceIcon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  color: rgba(0, 0, 0, .78);
}

.serviceIcon svg {
  width: 28px;
  height: 28px;
  display: block;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: transform .22s ease, color .22s ease;
}

.serviceRow h3 {
  margin: 0;
  color: #111;
  font-size: clamp(1rem, 1.15vw, 1.18rem);
  line-height: 1.08;
  letter-spacing: -.035em;
}

.serviceRow p {
  max-width: 460px;
  margin: .28rem 0 0;
  color: rgba(0,0,0,.58);
  font-size: .86rem;
  line-height: 1.42;
}

.serviceRow i {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: #b40032;
  background: rgba(180,0,50,.06);
  font-style: normal;
  font-weight: 900;
}

.serviceRow:hover {
  transform: translateX(4px);
  border-color: rgba(180,0,50,.34);
}

.serviceRow:hover .serviceIcon {
  color: #b40032;
}

.serviceRow:hover .serviceIcon svg {
  transform: translateX(2px);
}

.solutionsPanel {
  position: sticky;
  top: 110px;
  min-height: 470px;
  padding: 34px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 8px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(5, 6, 9, .62) 0%, rgba(5, 6, 9, .88) 100%),
    radial-gradient(circle at 88% 0%, rgba(180, 0, 50, .34), transparent 220px),
    url("/images/sectores/transporteterrestre.png") center / cover no-repeat;
  color: #fff;
  box-shadow:
    0 32px 90px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.solutionsPanel::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 42px 42px;
  opacity: .14;
}

.solutionsPanel > * {
  position: relative;
  z-index: 1;
}

.solutionsPanel span {
  display: inline-flex;
  margin-bottom: 18px;
  color: #d8ab62;
  font-size: 10px;
  font-weight: 950;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.solutionsPanel h3 {
  max-width: 270px;
  margin: 0;
  color: #fff;
  font-size: 26px;
  line-height: 1.12;
  letter-spacing: -.045em;
  font-weight: 850;
}

.solutionsPanel p {
  max-width: 275px;
  margin: 22px 0 0;
  color: rgba(255,255,255,.78);
  font-size: 13px;
  line-height: 1.72;
}

.panelStats {
  display: grid;
  gap: 0;
  margin-top: 34px;
}

.panelStats div {
  position: relative;
  min-height: 68px;
  padding: 18px 0 0 44px;
  border-top: 1px solid rgba(255,255,255,.16);
}

.panelStats div::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22px;
  width: 24px;
  height: 24px;
  border-radius: 999px;
  border: 1px solid rgba(216,171,98,.55);
  background: radial-gradient(circle, rgba(180,0,50,.35), transparent 58%);
}

.panelStats strong {
  display: block;
  color: #fff;
  font-size: 18px;
  line-height: 1.15;
  font-weight: 950;
  letter-spacing: -.025em;
}

.panelStats small {
  display: block;
  margin-top: 7px;
  color: rgba(255,255,255,.62);
  font-size: 11px;
  line-height: 1.5;
}

/* GLOBAL MAP */

.globalTrust {
  position: relative;
  isolation: isolate;
  min-height: clamp(540px, 47vw, 700px);
  padding: 0;
  overflow: hidden;
  color: #fff;
  background:
    linear-gradient(
      90deg,
      rgba(3, 4, 6, .98) 0%,
      rgba(3, 4, 6, .92) 24%,
      rgba(3, 4, 6, .50) 42%,
      rgba(3, 4, 6, .10) 68%,
      rgba(3, 4, 6, .18) 100%
    ),
    url("/images/mapa/mapa.png") center center / cover no-repeat;
}

.globalOverlay {
  width: min(1180px, calc(100% - 40px));
  min-height: inherit;
  margin: 0 auto;
  padding: clamp(4.5rem, 6vw, 6.5rem) 0 clamp(7rem, 9vw, 9rem);
  display: flex;
  align-items: center;
}

.globalContent {
  max-width: 440px;
  display: block;
}

.globalContent > span {
  display: inline-flex;
  margin-bottom: .8rem;
  color: #b40032;
  font-size: .68rem;
  font-weight: 950;
  letter-spacing: .26em;
  text-transform: uppercase;
}

.globalContent h2 {
  max-width: 430px;
  margin: 0;
  color: #fff;
  font-size: clamp(2.35rem, 3.55vw, 4.25rem);
  line-height: .96;
  letter-spacing: -.065em;
}

.globalCards {
  max-width: 390px;
  margin-top: 1.7rem;
  display: grid;
  gap: 0;
}

.globalCards div {
  padding: .9rem 0;
  border-top: 1px solid rgba(255, 255, 255, .16);
  background: transparent;
}

.globalCards strong {
  display: block;
  color: #fff;
  font-size: .92rem;
  font-weight: 950;
  letter-spacing: -.025em;
}

.globalCards p {
  max-width: 390px;
  margin: .45rem 0 0;
  color: rgba(255, 255, 255, .70);
  font-size: .82rem;
  line-height: 1.48;
}

/* OFFICES */

.homeOffices {
  position: relative;
  padding: clamp(4.2rem, 6vw, 5.8rem) 0;
  background:
    radial-gradient(circle at 8% 0%, rgba(180, 0, 50, .06), transparent 28rem),
    linear-gradient(180deg, #f7f4ee 0%, #eee9df 100%);
  color: #111;
  overflow: hidden;
}

.homeOfficesHead {
  max-width: 620px;
  margin-bottom: 1.8rem;
}

.homeOfficesHead h2 {
  margin: 0;
  color: #111;
  font-size: clamp(1.9rem, 3.2vw, 3.4rem);
  line-height: .98;
  letter-spacing: -.055em;
}

.homeOfficesGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1rem;
}

.homeOfficeCard,
.allOfficesCard {
  min-height: 166px;
  overflow: hidden;
  border-radius: 6px;
  background: rgba(255,255,255,.62);
  border: 1px solid rgba(0,0,0,.09);
  color: #111;
  text-decoration: none;
  box-shadow: 0 18px 46px rgba(0,0,0,.055);
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}

.homeOfficeCard:hover,
.allOfficesCard:hover {
  transform: translateY(-4px);
  border-color: rgba(180,0,50,.28);
  box-shadow: 0 24px 70px rgba(0,0,0,.1);
}

.homeOfficeImage {
  position: relative;
  height: 76px;
  background: #111217;
  overflow: hidden;
}

.homeOfficeImage img {
  object-fit: cover;
  filter: brightness(.82) contrast(1.05) saturate(1.04);
  transform: scale(1.02);
}

.homeOfficeImage::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,.18));
}

.homeOfficeBody {
  padding: .82rem .9rem .95rem;
}

.homeOfficeBody strong {
  display: block;
  color: #111;
  font-size: .86rem;
  font-weight: 950;
  letter-spacing: -.02em;
}

.homeOfficeBody small {
  display: block;
  margin-top: .18rem;
  color: rgba(0,0,0,.62);
  font-size: .76rem;
}

.homeOfficeBody p {
  margin: .48rem 0 0;
  color: rgba(0,0,0,.78);
  font-size: .78rem;
  font-weight: 750;
}

.allOfficesCard {
  padding: 1.1rem;
  display: grid;
  place-items: center;
  text-align: center;
  background: rgba(255,255,255,.44);
}

.allOfficesCard span {
  display: block;
  color: #111;
  font-size: 2rem;
  line-height: 1;
}

.allOfficesCard strong {
  display: block;
  margin-top: .65rem;
  font-size: .9rem;
  font-weight: 950;
}

.allOfficesCard small {
  display: block;
  margin-top: .2rem;
  color: rgba(0,0,0,.62);
  font-size: .72rem;
}

.allOfficesCard i {
  margin-top: .55rem;
  color: #b40032;
  font-style: normal;
  font-weight: 950;
}

/* FINAL CTA */

.homeFinalCta {
  position: relative;
  min-height: 280px;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(5,6,9,.96) 0%, rgba(5,6,9,.82) 42%, rgba(5,6,9,.36) 100%),
    url("/images/operador/contacenter.png") center right / cover no-repeat,
    #050609;
  color: #fff;
}

.homeFinalCtaInner {
  min-height: inherit;
  display: flex;
  align-items: center;
}

.homeFinalCta h2 {
  max-width: 520px;
  margin: 0;
  color: #fff;
  font-size: clamp(2rem, 3.8vw, 4rem);
  line-height: .94;
  letter-spacing: -.065em;
}

.homeFinalCta p {
  margin: .75rem 0 1.4rem;
  color: rgba(255,255,255,.76);
  font-size: 1rem;
}

.homeFinalCta a {
  min-height: 46px;
  padding: 0 1.35rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  background: #b40032;
  color: #fff;
  text-decoration: none;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .04em;
  text-transform: uppercase;
}

/* TABLET */

@media (max-width: 1020px) {
  .integratedInner,
  .servicesLayout {
    grid-template-columns: 1fr;
  }

  .solutionsPanel {
    position: relative;
    top: auto;
    min-height: auto;
  }

  .panelStats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .homeOfficesGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .allOfficesCard {
    min-height: 140px;
  }
}

/* MOBILE */

@media (max-width: 768px) {
  .globalTrust {
    min-height: 690px;
    background:
      linear-gradient(
        180deg,
        rgba(3, 4, 6, .94) 0%,
        rgba(3, 4, 6, .82) 36%,
        rgba(3, 4, 6, .50) 62%,
        rgba(3, 4, 6, .96) 100%
      ),
      url("/images/mapa/mapa-mobile.png") center top / cover no-repeat;
  }

  .globalOverlay {
    width: calc(100% - 28px);
    min-height: 690px;
    padding: 3.2rem 0 11rem;
    align-items: flex-start;
  }

  .globalContent {
    max-width: 100%;
  }

  .globalContent > span {
    font-size: .62rem;
    letter-spacing: .24em;
    margin-bottom: .8rem;
  }

  .globalContent h2 {
    max-width: 310px;
    font-size: clamp(1.9rem, 10.5vw, 2.65rem);
    line-height: .96;
    letter-spacing: -.06em;
  }

  .globalCards {
    max-width: 300px;
    margin-top: 1.45rem;
  }

  .globalCards div {
    padding: .78rem 0;
  }

  .globalCards strong {
    font-size: .88rem;
  }

  .globalCards p {
    font-size: .78rem;
    line-height: 1.45;
  }
}

@media (max-width: 640px) {
  .integrated,
  .services {
    padding: 4rem 0;
  }

  .integratedInner,
  .servicesInner,
  .homeOfficesInner,
  .homeFinalCtaInner {
    width: calc(100% - 28px);
  }

  .copy h2,
  .servicesHead h2 {
    font-size: clamp(2.1rem, 10vw, 3.1rem);
    line-height: .93;
  }

  .heroImage {
    min-height: 230px;
    border-radius: 24px;
  }

  .serviceRow {
    min-height: auto;
    grid-template-columns: 34px 32px minmax(0, 1fr) 30px;
    gap: .8rem;
    padding: 1rem 0;
  }

  .serviceIcon {
    width: 30px;
    height: 30px;
  }

  .serviceIcon svg {
    width: 24px;
    height: 24px;
  }

  .serviceRow h3 {
    font-size: 1.02rem;
  }

  .serviceRow p {
    font-size: .82rem;
  }

  .solutionsPanel {
    min-height: auto;
    padding: 24px 20px;
    border-radius: 10px;
  }

  .solutionsPanel h3 {
    max-width: 280px;
    font-size: 24px;
  }

  .solutionsPanel p {
    max-width: 300px;
  }

  .panelStats {
    grid-template-columns: 1fr;
    margin-top: 24px;
  }

  .homeOffices {
    padding: 3.6rem 0;
  }

  .homeOfficesHead h2 {
    font-size: clamp(2rem, 9vw, 2.9rem);
  }

  .homeOfficesGrid {
    grid-template-columns: 1fr;
  }

  .homeOfficeCard {
    min-height: auto;
  }

  .homeOfficeImage {
    height: 110px;
  }

  .homeFinalCta {
    min-height: 330px !important;
    background:
      linear-gradient(
        180deg,
        rgba(5,6,9,.95) 0%,
        rgba(5,6,9,.82) 45%,
        rgba(5,6,9,.96) 100%
      ),
      url("/images/operador/contacenter-mobile.png") center top / cover no-repeat,
      #050609 !important;
  }

  .homeFinalCta h2 {
    max-width: 320px;
    font-size: clamp(2rem, 10vw, 3rem);
  }

  .homeFinalCta a {
    width: 100%;
  }
}

/* FINAL POLISH: MAP LIGHT, OFFICES, CTA OPERATOR */

/* Mapa: más luz abajo/izquierda para que respire el texto */
.globalTrust {
  min-height: clamp(560px, 48vw, 720px) !important;
  background:
    radial-gradient(circle at 18% 82%, rgba(255,255,255,.12), transparent 18rem),
    radial-gradient(circle at 28% 72%, rgba(180,0,50,.10), transparent 20rem),
    linear-gradient(
      90deg,
      rgba(3, 4, 6, .96) 0%,
      rgba(3, 4, 6, .86) 25%,
      rgba(3, 4, 6, .46) 44%,
      rgba(3, 4, 6, .10) 70%,
      rgba(3, 4, 6, .20) 100%
    ),
    url("/images/mapa/mapa.png") center center / cover no-repeat !important;
}

.globalOverlay {
  padding: clamp(4.2rem, 5.6vw, 6rem) 0 clamp(6.5rem, 8vw, 8rem) !important;
}

.globalContent h2 {
  font-size: clamp(2.25rem, 3.4vw, 4rem) !important;
  line-height: .97 !important;
}

.globalCards {
  margin-top: 1.55rem !important;
}

.globalCards div {
  padding: .82rem 0 !important;
}

/* Oficinas: menos planas, más premium */
.homeOffices {
  padding: clamp(4.4rem, 6.2vw, 6rem) 0 !important;
  background:
    radial-gradient(circle at 12% 0%, rgba(180,0,50,.065), transparent 30rem),
    radial-gradient(circle at 88% 18%, rgba(216,171,98,.10), transparent 24rem),
    linear-gradient(180deg, #f8f5ef 0%, #eee9df 100%) !important;
}

.homeOfficesGrid {
  gap: 1.15rem !important;
}

.homeOfficeCard,
.allOfficesCard {
  border-radius: 14px !important;
  background: rgba(255,255,255,.72) !important;
  border: 1px solid rgba(0,0,0,.075) !important;
  box-shadow:
    0 24px 70px rgba(0,0,0,.07),
    inset 0 1px 0 rgba(255,255,255,.65) !important;
}

.homeOfficeImage {
  height: 86px !important;
}

.homeOfficeBody {
  padding: 1rem 1.05rem 1.05rem !important;
}

.homeOfficeBody strong {
  font-size: .95rem !important;
}

.homeOfficeBody small {
  font-size: .8rem !important;
}

.homeOfficeBody p {
  margin-top: .55rem !important;
  color: #111 !important;
  font-size: .82rem !important;
  font-weight: 850 !important;
}

.allOfficesCard {
  background:
    radial-gradient(circle at 50% 0%, rgba(180,0,50,.06), transparent 12rem),
    rgba(255,255,255,.62) !important;
}

/* CTA operador: que no corte media cara */
.homeFinalCta {
  min-height: 330px !important;
  background:
    linear-gradient(90deg, rgba(5,6,9,.98) 0%, rgba(5,6,9,.86) 38%, rgba(5,6,9,.40) 64%, rgba(5,6,9,.16) 100%),
    url("/images/operador/contacenter.png") right 42% center / cover no-repeat,
    #050609 !important;
}

.homeFinalCta h2 {
  max-width: 560px !important;
  font-size: clamp(2.15rem, 3.45vw, 3.8rem) !important;
  line-height: .96 !important;
}

.homeFinalCta p {
  font-size: 1.05rem !important;
}

/* Mobile: mapa más controlado */
@media (max-width: 768px) {
  .globalTrust {
    min-height: 650px !important;
    background:
      radial-gradient(circle at 18% 76%, rgba(255,255,255,.10), transparent 12rem),
      linear-gradient(
        180deg,
        rgba(3,4,6,.94) 0%,
        rgba(3,4,6,.82) 36%,
        rgba(3,4,6,.46) 62%,
        rgba(3,4,6,.96) 100%
      ),
      url("/images/mapa/mapa-mobile.png") center top / cover no-repeat !important;
  }

  .globalOverlay {
    min-height: 650px !important;
    padding: 3rem 0 9.5rem !important;
  }

