.page {
  width: 100%;
  overflow: hidden;
  background: #f4f1eb;
  color: #080b10;
}

/* HERO PREMIUM */
.hero {
  position: relative;
  min-height: clamp(590px, calc(100svh - 28px), 760px);
  padding: clamp(6.8rem, 9vh, 8rem) 6vw clamp(3.2rem, 5vh, 4.6rem);
  display: flex;
  align-items: center;
  isolation: isolate;
  overflow: hidden;
  background: #050609;
  color: #fff;
}

.heroImage,
.heroImageDesktop,
.heroImageMobile {
  position: absolute !important;
  inset: 0 !important;
  z-index: -3 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center 50% !important;
  filter: brightness(.86) contrast(1.08) saturate(1.08);
}

.heroImageMobile {
  display: none !important;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(circle at 72% 42%, rgba(237, 27, 47, .12), transparent 28rem),
    linear-gradient(90deg, rgba(2,4,8,.97) 0%, rgba(2,4,8,.86) 34%, rgba(2,4,8,.48) 62%, rgba(2,4,8,.26) 100%),
    linear-gradient(180deg, rgba(0,0,0,.08) 0%, rgba(0,0,0,.38) 62%, rgba(0,0,0,.62) 100%);
}

.heroContent {
  width: min(720px, 100%);
  position: relative;
  z-index: 2;
}

.heroContent > span,
.heroContent small {
  display: block;
  margin-bottom: 1rem;
  color: #ed1b2f;
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.heroContent h1 {
  max-width: 720px;
  margin: 0;
  color: #fff;
  font-size: clamp(3.4rem, 5vw, 6rem);
  line-height: .9;
  letter-spacing: -.06em;
}

.heroContent h1::after {
  content: ".";
  color: #ed1b2f;
}

.heroContent p {
  max-width: 610px;
  margin: 1.35rem 0 0;
  color: rgba(255,255,255,.84);
  font-size: clamp(1rem, 1.08vw, 1.13rem);
  line-height: 1.65;
}

/* BOTONES */
.actions,
.compactCtaActions {
  display: flex;
  flex-wrap: wrap;
  gap: .9rem;
  margin-top: 1.8rem;
}

.actions a,
.compactCtaActions a,
.cta a {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.55rem;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .04em;
}

.actions a:first-child,
.compactCtaActions a:first-child,
.cta a:first-child {
  background: #ed1b2f;
  color: #fff;
  box-shadow: 0 18px 42px rgba(237, 27, 47, .22);
}

.actions a:first-child::after,
.compactCtaActions a:first-child::after,
.cta a:first-child::after {
  content: "→";
  margin-left: .75rem;
}

.actions a:last-child,
.compactCtaActions a:last-child,
.cta a:last-child {
  color: #fff;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.28);
}

/* CONTENT BASE */
.content {
  background: #f4f1eb;
}

/* BLOQUE CLARO DE AUTORIDAD */
.block {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
  padding: clamp(4rem, 6vw, 6rem) 0;
}

.block > span,
.servicesCopy > span {
  display: block;
  margin-bottom: .9rem;
  color: #ed1b2f;
  font-size: .72rem;
  font-weight: 900;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.block h2,
.servicesCopy h2 {
  max-width: 760px;
  margin: 0;
  color: #080b10;
  font-size: clamp(2.4rem, 4vw, 5rem);
  line-height: .96;
  letter-spacing: -.055em;
}

.block p,
.servicesCopy p {
  max-width: 660px;
  margin: 1.15rem 0 0;
  color: rgba(8, 11, 16, .72);
  font-size: 1rem;
  line-height: 1.68;
}

/* PANELES DE SERVICIO */
.servicesPanel,
.servicesPanelReverse {
  width: 100vw;
  max-width: none;
  margin-left: 50%;
  margin-right: 50%;
  transform: translateX(-50%);
  padding: clamp(4rem, 6vw, 6rem) max(24px, calc((100vw - 1180px) / 2));
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(360px, 1fr);
  gap: clamp(2.2rem, 5vw, 5rem);
  align-items: center;
  background:
    radial-gradient(circle at 18% 18%, rgba(237,27,47,.14), transparent 24rem),
    linear-gradient(180deg, #08090e 0%, #050609 100%);
  color: #fff;
  overflow: hidden;
}

.servicesPanelReverse {
  grid-template-columns: minmax(360px, 1fr) minmax(0, .9fr);
}

.servicesPanelReverse .servicesCopy {
  order: 2;
}

.servicesPanelReverse .servicesImageWrap {
  order: 1;
}

.servicesPanel .servicesCopy h2,
.servicesPanelReverse .servicesCopy h2,
.servicesPanel .servicesCopy p,
.servicesPanelReverse .servicesCopy p {
  color: inherit;
}

.servicesPanel .servicesCopy h2,
.servicesPanelReverse .servicesCopy h2 {
  max-width: 680px;
  color: #fff;
}

.servicesPanel .servicesCopy p,
.servicesPanelReverse .servicesCopy p {
  color: rgba(255,255,255,.76);
}

.servicesImageWrap {
  position: relative;
  min-height: 360px;
  overflow: hidden;
  border-radius: 0;
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 28px 90px rgba(0,0,0,.30);
}

.servicesImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(.82) contrast(1.08) saturate(1.05);
}

/* ACCORDION / LISTA DE SERVICIOS */
.accordion {
  display: grid;
  gap: .8rem;
  margin-top: 2rem;
}

.serviceItem {
  position: relative;
  padding: 1.15rem 1.25rem;
  border: 1px solid rgba(255,255,255,.13);
  background:
    linear-gradient(145deg, rgba(255,255,255,.075), rgba(255,255,255,.026));
  color: #fff;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 18px 50px rgba(0,0,0,.16);
}

.serviceItem::after {
  content: "→";
  position: absolute;
  right: 1.2rem;
  top: 50%;
  transform: translateY(-50%);
  color: #ed1b2f;
}

.serviceItem h3,
.serviceItem strong {
  margin: 0;
  color: #fff;
  font-size: .98rem;
  line-height: 1.2;
}

.serviceItem p {
  max-width: 520px;
  margin: .5rem 2rem 0 0;
  color: rgba(255,255,255,.72);
  font-size: .86rem;
  line-height: 1.5;
}

/* CTA COMPACTO */
.compactCta,
.cta {
  width: 100vw;
  max-width: none;
  margin-left: 50%;
  margin-right: 50%;
  transform: translateX(-50%);
  padding: 3.2rem max(24px, calc((100vw - 1180px) / 2));
  background:
    radial-gradient(circle at 82% 28%, rgba(237,27,47,.14), transparent 22rem),
    linear-gradient(180deg, #07080c 0%, #050609 100%);
  color: #fff;
  border-top: 1px solid rgba(255,255,255,.08);
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.compactCta h2,
.cta h2 {
  max-width: 680px;
  margin: 0;
  color: #fff;
  font-size: clamp(2.2rem, 3.2vw, 3.8rem);
  line-height: .94;
  letter-spacing: -.055em;
}

.compactCta p,
.cta p {
  max-width: 640px;
  margin: 1rem 0 0;
  color: rgba(255,255,255,.74);
  font-size: .96rem;
  line-height: 1.62;
}

/* DESKTOP BAJO */
@media (min-width: 901px) and (max-height: 700px) {
  .hero {
    min-height: 520px;
    padding: 5.4rem 6vw 2.4rem;
  }

  .heroContent h1 {
    font-size: clamp(2.8rem, 4.7vw, 4.5rem);
  }

  .heroContent p {
    font-size: .94rem;
    line-height: 1.5;
  }

  .actions a {
    min-height: 42px;
  }
}

/* TABLET */
@media (max-width: 1100px) {
  .hero {
    padding: 6.2rem 6vw 3rem;
  }

  .servicesPanel,
  .servicesPanelReverse {
    grid-template-columns: 1fr;
  }

  .servicesPanelReverse .servicesCopy,
  .servicesPanelReverse .servicesImageWrap {
    order: initial;
  }
}

/* MOBILE */
@media (max-width: 700px) {
  .hero {
    min-height: auto;
    padding: 5.4rem 22px 2.5rem;
    display: block;
  }

  .heroContent h1 {
    max-width: 420px;
    font-size: clamp(2.25rem, 10vw, 3.25rem);
    line-height: .95;
  }

  .heroContent p {
    max-width: 420px;
    font-size: .92rem;
    line-height: 1.52;
  }

  .actions,
  .compactCtaActions {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 420px;
  }

  .actions a,
  .compactCtaActions a {
    width: 100%;
    min-height: 46px;
    border-radius: 999px;
  }

  .heroImageDesktop {
    display: none !important;
  }

  .heroImageMobile {
    display: block !important;
  }

  .block {
    width: calc(100% - 36px);
    padding: 3rem 0;
  }

  .block h2,
  .servicesCopy h2 {
    font-size: clamp(2rem, 9vw, 2.9rem);
  }

  .servicesPanel,
  .servicesPanelReverse {
    width: 100%;
    margin: 0;
    transform: none;
    padding: 3rem 18px;
  }

  .servicesImageWrap {
    min-height: 240px;
  }

  .serviceItem {
    padding: 1rem;
  }

  .serviceItem p {
    margin-right: 1.4rem;
  }

  .compactCta,
  .cta {
    width: 100%;
    margin: 0;
    transform: none;
    padding: 2.7rem 18px;
  }

  .compactCta h2,
  .cta h2 {
    font-size: clamp(2rem, 9vw, 2.85rem);
  }

  .compactCtaActions {
    width: 100%;
  }
}

/* IPHONE SE / FOLD ANGOSTO */
@media (max-width: 380px) {
  .hero {
    padding: 5rem 18px 2rem;
  }

  .heroContent h1 {
    font-size: clamp(1.95rem, 10.2vw, 2.45rem);
  }

  .heroContent p {
    font-size: .82rem;
  }

  .actions a,
  .compactCtaActions a {
    min-height: 42px;
    font-size: .66rem;
  }

  .servicesPanel,
  .servicesPanelReverse {
    padding: 2.6rem 14px;
  }
}
