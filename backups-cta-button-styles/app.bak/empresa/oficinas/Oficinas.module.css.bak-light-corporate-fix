.page {
  min-height: 100vh;
  background: #07080b;
  color: #fff;
  overflow: hidden;
}

/* HERO */
.intro {
  position: absolute;
  z-index: 20;
  top: 15.5rem;
  left: 5vw;
  width: min(980px, 92vw);
  padding: 0;
  background: transparent;
  color: #fff;
}

.intro span {
  display: inline-flex;
  align-items: center;
  gap: .7rem;
  padding: .85rem 1.25rem;
  border-radius: 999px;
  background:
    linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.04));
  border: 1px solid rgba(255,255,255,.12);
  backdrop-filter: blur(14px);
  color: #fff;
  font-size: .78rem;
  font-weight: 850;
  letter-spacing: .22em;
  text-transform: uppercase;
  box-shadow:
    0 18px 42px rgba(0,0,0,.24),
    0 0 26px rgba(255,35,82,.08);
}

.intro span::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #ff214f;
  box-shadow: 0 0 16px rgba(255,33,79,.75);
}

.intro h1 {
  max-width: 980px;
  margin: 1.25rem 0 0;
  color: #fff;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3.6rem, 6.4vw, 7.4rem);
  font-weight: 350;
  line-height: .88;
  letter-spacing: -.085em;
  text-shadow: 0 24px 80px rgba(0,0,0,.65);
}

.intro h1::after {
  content: ".";
  color: #ed1b2f;
}

.intro p {
  max-width: 820px;
  margin: 1.55rem 0 0;
  padding-left: 1.35rem;
  border-left: 2px solid rgba(255,35,82,.58);
  color: rgba(255,255,255,.88);
  font-size: clamp(1.05rem, 1.35vw, 1.38rem);
  line-height: 1.62;
  letter-spacing: -.018em;
  text-shadow:
    0 14px 34px rgba(0,0,0,.52),
    0 2px 12px rgba(0,0,0,.34);
}

.introActions {
  margin-top: 1.8rem;
  display: flex;
  align-items: center;
  gap: .9rem;
  flex-wrap: wrap;
}

.introActions a {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.45rem;
  border-radius: 999px;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .035em;
}

.introActions a:first-child {
  background: #ed1b2f;
  color: #fff;
  box-shadow: 0 18px 42px rgba(237,27,47,.24);
}

.introActions a:first-child::after {
  content: "→";
  margin-left: .7rem;
}

.introActions a:last-child {
  color: #fff;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.25);
}

.heroStrip {
  position: relative;
  z-index: 1;
  height: 760px;
  margin: 0;
  overflow: hidden;
  background: #050609;
}

.heroImage {
  object-fit: cover;
  object-position: center;
  transform: scale(1.035);
  filter: brightness(1.05) contrast(1.04) saturate(1.05);
}

.heroOverlay,
.heroStrip::before {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.heroStrip::before {
  content: "";
  z-index: 4;
  background:
    linear-gradient(90deg, rgba(5,6,9,.78) 0%, rgba(5,6,9,.48) 34%, rgba(5,6,9,.12) 58%, rgba(5,6,9,.58) 100%),
    linear-gradient(180deg, rgba(5,6,9,.10) 0%, rgba(5,6,9,.04) 42%, #07080b 100%);
}

.heroOverlay {
  z-index: 3;
  background:
    radial-gradient(circle at 82% 20%, rgba(160,12,38,.14), transparent 30rem),
    linear-gradient(180deg, rgba(255,255,255,.02) 0%, #07080b 100%);
}

/* GRID OFICINAS */
.grid {
  position: relative;
  z-index: 10;
  padding: 5.5rem 5vw 6.5rem;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1.15rem;
  background:
    radial-gradient(circle at 90% 0%, rgba(190,18,55,.16), transparent 28rem),
    linear-gradient(180deg, #07080b 0%, #050608 100%);
  border-top: 1px solid rgba(190,18,55,.30);
}

.card {
  position: relative;
  min-height: 360px;
  overflow: hidden;
  border-radius: 28px;
  color: #fff;
  text-decoration: none;
  background: rgba(255,255,255,.025);
  border: 1px solid rgba(255,255,255,.08);
  box-shadow:
    0 24px 70px rgba(0,0,0,.24),
    inset 0 1px 0 rgba(255,255,255,.06);
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}

.card::after {
  content: "";
  position: absolute;
  left: 1.2rem;
  right: 1.2rem;
  bottom: 0;
  height: 2px;
  z-index: 3;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(255,35,82,.85), transparent);
  box-shadow: 0 0 18px rgba(255,35,82,.35);
  opacity: .55;
}

.card:hover {
  transform: translateY(-7px) scale(1.012);
  border-color: rgba(255,35,82,.34);
  box-shadow:
    0 38px 110px rgba(0,0,0,.35),
    0 0 0 1px rgba(255,35,82,.18),
    0 0 42px rgba(255,35,82,.10);
}

.cardImage {
  object-fit: cover;
  transition: transform .6s ease;
}

.card:hover .cardImage {
  transform: scale(1.06);
}

.cardOverlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(circle at 80% 15%, rgba(255,35,82,.18), transparent 15rem),
    linear-gradient(180deg, rgba(0,0,0,.10) 0%, rgba(0,0,0,.48) 40%, rgba(0,0,0,.92) 100%);
}

.cardContent {
  position: absolute;
  inset: auto 0 0;
  z-index: 2;
  padding: 1.45rem;
}

.cardContent small {
  color: #d5a85b;
  font-size: .62rem;
  font-weight: 850;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.cardContent h2 {
  margin: .65rem 0 .65rem;
  color: #fff;
  font-family: var(--font-tight), "Manrope", system-ui, sans-serif;
  font-size: clamp(1.45rem, 1.6vw, 2rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -.05em;
  text-shadow: 0 8px 26px rgba(0,0,0,.55);
}

.cardContent p {
  max-height: 4.4em;
  overflow: hidden;
  margin: 0;
  color: rgba(255,255,255,.74);
  font-size: .84rem;
  line-height: 1.48;
  text-shadow: 0 5px 18px rgba(0,0,0,.45);
}

.cardContent strong {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 34px;
  margin-top: .85rem;
  padding: .5rem .8rem;
  color: #fff;
  background: rgba(0,0,0,.62);
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 999px;
  font-size: .78rem;
  line-height: 1;
  white-space: nowrap;
  backdrop-filter: blur(12px);
}

.cardContent span {
  display: inline-flex;
  margin-left: .55rem;
  margin-top: .9rem;
  color: #ff2d58;
  font-weight: 850;
  font-size: .78rem;
  text-shadow: 0 0 18px rgba(255,45,88,.45);
}

/* CTA */
.networkCta {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto 6rem;
  padding: 2rem clamp(1.4rem, 5vw, 3.5rem);
  border-radius: 28px;
  background:
    radial-gradient(circle at 84% 20%, rgba(237,27,47,.18), transparent 22rem),
    linear-gradient(135deg, #120812 0%, #2b1020 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: 0 24px 80px rgba(0,0,0,.26);
}

.networkCta span {
  display: block;
  margin-bottom: .65rem;
  color: #ed1b2f;
  font-size: .7rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.networkCta h2 {
  max-width: 760px;
  margin: 0;
  color: #fff;
  font-size: clamp(1.8rem, 2.8vw, 3rem);
  line-height: .96;
  letter-spacing: -.055em;
}

.networkCta p {
  max-width: 720px;
  margin: .9rem 0 0;
  color: rgba(255,255,255,.74);
  font-size: .95rem;
  line-height: 1.58;
}

.networkCtaActions {
  display: flex;
  align-items: center;
  gap: .75rem;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.networkCtaActions a {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.15rem;
  border-radius: 999px;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .035em;
}

.networkCtaActions a:first-child {
  background: #ed1b2f;
  color: #fff;
}

.networkCtaActions a:last-child {
  color: #fff;
  background: rgba(255,255,255,.10);
  border: 1px solid rgba(255,255,255,.16);
}

/* DETALLE OFICINA */
.detail {
  padding: 12rem 5vw 6rem;
  background: #f4f0ea;
  color: #111;
}

.back {
  display: inline-flex;
  margin-bottom: 2rem;
  color: #9d0b28;
  text-decoration: none;
  font-weight: 850;
}

.detail span {
  color: #a9823e;
  font-size: .72rem;
  font-weight: 850;
  letter-spacing: .28em;
  text-transform: uppercase;
}

.detail h1 {
  max-width: 980px;
  margin: 1rem 0 0;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3rem, 6vw, 6.6rem);
  font-weight: 300;
  line-height: .92;
  letter-spacing: -.075em;
}

.detailCard {
  max-width: 980px;
  margin-top: 2.5rem;
  padding: 2rem;
  border-radius: 34px;
  background: rgba(255,255,255,.72);
  border: 1px solid rgba(0,0,0,.07);
  box-shadow:
    0 30px 90px rgba(0,0,0,.10),
    inset 0 1px 0 rgba(255,255,255,.86);
}

.detailCard small {
  color: #a9823e;
  font-weight: 850;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.detailCard p {
  margin: .6rem 0 1.4rem;
  color: rgba(0,0,0,.68);
  line-height: 1.7;
  font-size: 1.05rem;
}

.actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 1.4rem;
}

.actions a {
  min-width: 210px;
  height: 58px;
  border-radius: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-weight: 850;
}

.actions a:first-child {
  color: white;
  background: linear-gradient(135deg, #8c0b25, #c51338, #72071d);
}

.actions a:last-child {
  color: #111;
  border: 1px solid rgba(0,0,0,.12);
  background: rgba(255,255,255,.72);
}

/* RESPONSIVE */
@media (max-width: 1200px) {
  .grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .intro {
    top: 9.5rem;
    left: 1.2rem;
    width: calc(100vw - 2.4rem);
  }

  .intro h1 {
    font-size: clamp(3rem, 13vw, 4.55rem);
    line-height: .93;
  }

  .intro p {
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.55;
    padding-left: 1rem;
  }

  .heroStrip {
    height: 620px;
  }

  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 3.5rem 1.2rem 4rem;
  }

  .networkCta {
    width: calc(100% - 2.4rem);
    margin-bottom: 4rem;
    flex-direction: column;
    align-items: flex-start;
  }

  .networkCtaActions {
    width: 100%;
  }

  .networkCtaActions a {
    flex: 1;
    min-width: min(100%, 160px);
  }
}

@media (max-width: 560px) {
  .intro {
    top: 8.5rem;
  }

  .intro span {
    max-width: 100%;
    padding: .7rem .85rem;
    font-size: .58rem;
    letter-spacing: .17em;
  }

  .intro h1 {
    font-size: clamp(2.35rem, 11.5vw, 3.25rem);
  }

  .intro p {
    margin-top: 1rem;
    font-size: .86rem;
    line-height: 1.5;
  }

  .introActions {
    display: grid;
    grid-template-columns: 1fr;
    gap: .65rem;
    margin-top: 1.2rem;
  }

  .introActions a {
    width: 100%;
    min-height: 44px;
    font-size: .66rem;
  }

  .heroStrip {
    height: 560px;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: .9rem;
    padding-top: 2.6rem;
  }

  .card {
    min-height: 320px;
    border-radius: 24px;
  }

  .cardContent {
    padding: 1.2rem;
  }

  .cardContent h2 {
    font-size: 1.65rem;
  }

  .networkCta {
    width: calc(100% - 2rem);
    padding: 1.45rem;
    border-radius: 24px;
  }

  .networkCtaActions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .networkCtaActions a {
    width: 100%;
  }
}
