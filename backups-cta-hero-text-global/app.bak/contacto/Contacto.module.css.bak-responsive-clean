.page {
  background: #f4f1eb;
  color: #111;
}

.hero {
  position: relative;
  min-height: 82vh;
  display: flex;
  align-items: flex-end;
  padding: 10rem 5vw 6rem;
  overflow: hidden;
  isolation: isolate;
  background: #07080b;
  color: #fff;
}

.heroImage {
  object-fit: cover;
  z-index: -3;
  filter: brightness(.68) contrast(1.06) saturate(1.04);
}

.overlay {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(circle at 82% 18%, rgba(190,18,55,.26), transparent 34rem),
    linear-gradient(90deg, rgba(5,6,9,.94), rgba(5,6,9,.66) 45%, rgba(5,6,9,.18)),
    linear-gradient(180deg, rgba(5,6,9,.1), #07080b 100%);
}

.heroContent {
  max-width: 940px;
}

.heroContent span,
.formIntro span {
  color: #d5a85b;
  font-size: .76rem;
  font-weight: 900;
  letter-spacing: .28em;
  text-transform: uppercase;
}

.heroContent h1 {
  margin: 1rem 0 0;
  font-size: clamp(4rem, 7vw, 8rem);
  line-height: .88;
  letter-spacing: -.08em;
}

.heroContent p {
  max-width: 780px;
  color: rgba(255,255,255,.78);
  font-size: 1.15rem;
  line-height: 1.75;
}

.main {
  width: min(1240px, calc(100% - 40px));
  margin: 0 auto;
  padding: 5rem 0;
}

.regions {
  padding: 2rem;
  border-radius: 34px;
  background: #08090d;
  color: white;
  box-shadow: 0 30px 90px rgba(0,0,0,.18);
}

.regions h2 {
  margin: 0 0 1.4rem;
  font-size: clamp(2rem, 4vw, 4rem);
  letter-spacing: -.07em;
}

.regions > div {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}

.regions article {
  padding: 1.2rem;
  border-radius: 22px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.08);
}

.regions span,
.regions strong {
  display: block;
}

.regions span {
  color: #d5a85b;
  font-weight: 900;
  text-transform: uppercase;
}

.regions strong {
  margin-top: .5rem;
  font-size: 1.2rem;
}

.formSection {
  margin-top: 4rem;
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 3rem;
  align-items: start;
}

.formIntro {
  position: sticky;
  top: 8rem;
}

.formIntro h2 {
  margin: 1rem 0 0;
  font-size: clamp(2.8rem, 5vw, 5.4rem);
  line-height: .92;
  letter-spacing: -.08em;
}

.formIntro p {
  max-width: 500px;
  color: rgba(0,0,0,.66);
  line-height: 1.8;
}

.form {
  padding: 2rem;
  border-radius: 36px;
  background: rgba(255,255,255,.86);
  border: 1px solid rgba(0,0,0,.06);
  box-shadow: 0 34px 100px rgba(0,0,0,.14);
  display: grid;
  gap: 1rem;
}

.form input,
.form textarea {
  width: 100%;
  border: 0;
  outline: 0;
  border-radius: 18px;
  padding: 1rem 1.1rem;
  background: #ece7de;
  color: #111;
  font: inherit;
  font-weight: 700;
}

.form textarea {
  resize: vertical;
}

.consent {
  display: flex;
  gap: .7rem;
  align-items: flex-start;
  color: rgba(0,0,0,.62);
  font-size: .9rem;
}

.consent input {
  width: auto;
  margin-top: .25rem;
}

.form button {
  min-height: 58px;
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, #9c0b29, #e11343);
  color: #fff;
  font-weight: 950;
  cursor: pointer;
  box-shadow: 0 24px 70px rgba(180,0,45,.28);
}

.success {
  color: #0a7a3b;
  font-weight: 900;
}

@media (max-width: 900px) {
  .hero {
    min-height: 72vh;
    padding: 8rem 1.2rem 4rem;
  }

  .main {
    width: calc(100% - 24px);
    padding: 3rem 0;
  }

  .regions > div,
  .formSection {
    grid-template-columns: 1fr;
  }

  .formIntro {
    position: static;
  }
}

