/* =====================================================
   SOLUTIONS PANEL TYPOGRAPHY LIKE GLOBAL TRUST
   Hace que el panel de operación integrada siga el estilo
   oscuro/blanco/dorado de la sección del mapa.
   ===================================================== */

.solutionsPanel {
  color: #f4efe4 !important;
}

.solutionsPanel span {
  color: #d6c08d !important;
  font-weight: 900 !important;
  letter-spacing: .18em !important;
  text-transform: uppercase !important;
  text-shadow: 0 10px 24px rgba(0,0,0,.36) !important;
}

.solutionsPanel h3 {
  color: #ffffff !important;
  font-weight: 760 !important;
  letter-spacing: -.045em !important;
  line-height: 1.05 !important;
  text-shadow:
    0 18px 42px rgba(0,0,0,.46),
    0 2px 8px rgba(0,0,0,.28) !important;
}

.solutionsPanel p {
  color: rgba(244,239,228,.76) !important;
  font-weight: 430 !important;
  line-height: 1.58 !important;
  text-shadow: 0 14px 34px rgba(0,0,0,.34) !important;
}

.panelStats {
  display: grid !important;
  gap: .85rem !important;
}

.panelStats > div {
  position: relative !important;
  padding: .78rem .85rem .78rem 2.1rem !important;
  border-radius: 14px !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.035)) !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.10),
    0 12px 28px rgba(0,0,0,.14) !important;
  backdrop-filter: blur(12px) saturate(1.1) !important;
  -webkit-backdrop-filter: blur(12px) saturate(1.1) !important;
}

.panelStats > div::before {
  content: "" !important;
  position: absolute !important;
  left: .82rem !important;
  top: .9rem !important;
  width: .58rem !important;
  height: .58rem !important;
  border-radius: 999px !important;
  border: 1px solid rgba(214,192,141,.78) !important;
  box-shadow:
    0 0 0 4px rgba(214,192,141,.08),
    0 0 18px rgba(214,192,141,.16) !important;
}

.panelStats strong {
  display: block !important;
  color: #ffffff !important;
  font-weight: 850 !important;
  font-size: clamp(.92rem, 1.05vw, 1.08rem) !important;
  line-height: 1.05 !important;
  letter-spacing: -.025em !important;
  text-shadow: 0 12px 28px rgba(0,0,0,.34) !important;
}

.panelStats small {
  display: block !important;
  margin-top: .24rem !important;
  color: rgba(244,239,228,.66) !important;
  font-size: .66rem !important;
  line-height: 1.28 !important;
  font-weight: 650 !important;
}

/* Overlay más fuerte para que la letra nunca se pierda */
.solutionsPanel::before {
  background:
    linear-gradient(
      90deg,
      rgba(5, 11, 18, .86) 0%,
      rgba(5, 11, 18, .70) 48%,
      rgba(5, 11, 18, .38) 100%
    ),
    radial-gradient(circle at 20% 18%, rgba(214,192,141,.18), transparent 13rem),
    radial-gradient(circle at 85% 12%, rgba(142,177,203,.15), transparent 14rem) !important;
}

/* Mobile/tablet: que no quede texto negro ni chico */
@media (max-width: 900px) {
  .solutionsPanel h3 {
    color: #ffffff !important;
    font-size: clamp(1.45rem, 6vw, 2.1rem) !important;
  }

  .solutionsPanel p {
    color: rgba(244,239,228,.76) !important;
    font-size: .9rem !important;
  }

  .panelStats strong {
    color: #ffffff !important;
  }

  .panelStats small {
    color: rgba(244,239,228,.66) !important;
  }
}

/* =====================================================
   SOLUTIONS PANEL RESPONSIVE CONTENT FIX
   Evita que el contenido interno se corte y mejora proporciones.
   ===================================================== */

.solutionsPanel {
  overflow: hidden !important;
}

.solutionsPanel > div:first-child {
  max-width: 62% !important;
}

.solutionsPanel h3 {
  max-width: 100% !important;
  font-size: clamp(1.45rem, 2vw, 2.15rem) !important;
  line-height: 1.02 !important;
  margin: .65rem 0 .75rem !important;
}

.solutionsPanel p {
  max-width: 100% !important;
  font-size: clamp(.82rem, .9vw, .96rem) !important;
  line-height: 1.55 !important;
}

.panelStats {
  width: 100% !important;
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: .75rem !important;
  margin-top: auto !important;
}

.panelStats > div {
  min-width: 0 !important;
  padding: .82rem .78rem .82rem 2.05rem !important;
  border-radius: 14px !important;
}

.panelStats strong {
  font-size: clamp(.86rem, .95vw, 1.08rem) !important;
  line-height: 1.05 !important;
  white-space: normal !important;
}

.panelStats small {
  font-size: clamp(.54rem, .58vw, .66rem) !important;
  line-height: 1.25 !important;
  white-space: normal !important;
}

/* Tablet: que no se rompa ni se corte */
@media (max-width: 1024px) {
  .solutionsPanel {
    padding: 1.55rem 1.45rem 1.35rem !important;
  }

  .solutionsPanel > div:first-child {
    max-width: 72% !important;
  }

  .solutionsPanel h3 {
    font-size: clamp(1.28rem, 2.2vw, 1.75rem) !important;
  }

  .solutionsPanel p {
    font-size: .78rem !important;
    line-height: 1.5 !important;
  }

  .panelStats {
    gap: .55rem !important;
  }

  .panelStats > div {
    padding: .68rem .62rem .68rem 1.85rem !important;
  }

  .panelStats strong {
    font-size: .82rem !important;
  }

  .panelStats small {
    font-size: .52rem !important;
  }
}

/* Mobile: stats en columna para que nunca se corten */
@media (max-width: 760px) {
  .solutionsPanel {
    min-height: auto !important;
    height: auto !important;
    max-height: none !important;
    padding: 1.6rem 1.25rem !important;
  }

  .solutionsPanel > div:first-child {
    max-width: 100% !important;
  }

  .solutionsPanel h3 {
    font-size: clamp(1.72rem, 7vw, 2.35rem) !important;
    line-height: 1.02 !important;
  }

  .solutionsPanel p {
    font-size: .9rem !important;
    line-height: 1.55 !important;
  }

  .panelStats {
    grid-template-columns: 1fr !important;
    gap: .7rem !important;
    margin-top: 1.35rem !important;
  }

  .panelStats > div {
    padding: .78rem .85rem .78rem 2.1rem !important;
  }

  .panelStats strong {
    font-size: .96rem !important;
  }

  .panelStats small {
    font-size: .62rem !important;
  }
}

/* =====================================================
   HOME WARM PREMIUM SURFACES
   Cambia blancos puros por marfil corporativo.
   ===================================================== */

.services,
.homeOffices,
.mobileCertifications {
  background:
    radial-gradient(circle at 12% 0%, rgba(214,192,141,.10), transparent 24rem),
    linear-gradient(180deg, #f7f3ea 0%, #f4efe4 100%) !important;
}

.serviceRow,
.homeOfficeCard {
  background:
    linear-gradient(180deg, rgba(255,255,255,.86), rgba(247,243,234,.74)) !important;
  border: 1px solid rgba(7,17,29,.08) !important;
  box-shadow:
    0 18px 48px rgba(7,17,29,.075),
    inset 0 1px 0 rgba(255,255,255,.72) !important;
}

.serviceRow:hover,
.homeOfficeCard:hover {
  border-color: rgba(214,192,141,.22) !important;
  box-shadow:
    0 24px 58px rgba(7,17,29,.11),
    0 8px 24px rgba(214,192,141,.08),
    inset 0 1px 0 rgba(255,255,255,.82) !important;
}
