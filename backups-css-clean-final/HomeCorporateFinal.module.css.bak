/* =====================================================
   INTEGRATED SECTION FEDEX / MAERSK CLEAN STYLE
   Menos pesado, más aire, tipografía corporativa.
   ===================================================== */

.integrated {
  background:
    linear-gradient(180deg, #fbfaf7 0%, #f6f3ed 100%) !important;
}

.integratedInner {
  gap: 2.6rem !important;
}

/* Label */
.integrated .copy > span {
  color: #173247 !important;
  font-size: .72rem !important;
  letter-spacing: .26em !important;
  font-weight: 800 !important;
  margin-bottom: 1.05rem !important;
}

/* Título menos brutal */
.integrated .copy h2,
.integrated .copy h3 {
  color: #101820 !important;
  max-width: 520px !important;

  font-family: Arial, Helvetica, sans-serif !important;
  font-weight: 650 !important;
  font-size: clamp(2.25rem, 5vw, 4.1rem) !important;
  line-height: 1.02 !important;
  letter-spacing: -0.055em !important;

  margin-bottom: 1.35rem !important;
}

/* Punto final más discreto */
.integrated .copy h2 span,
.integrated .copy h3 span,
.integrated .copy h2 strong,
.integrated .copy h3 strong {
  color: #173247 !important;
}

/* Párrafo más FedEx: fino, legible */
.integrated .copy p {
  max-width: 510px !important;
  color: rgba(16, 24, 32, .72) !important;

  font-family: Arial, Helvetica, sans-serif !important;
  font-size: 1rem !important;
  line-height: 1.72 !important;
  font-weight: 400 !important;

  margin-bottom: 1.7rem !important;
}

/* Lista más limpia */
.integrated .copy ul {
  display: grid !important;
  gap: .78rem !important;
  margin-top: 0 !important;
  margin-bottom: 1.75rem !important;
}

.integrated .copy li {
  color: rgba(16, 24, 32, .82) !important;

  font-family: Arial, Helvetica, sans-serif !important;
  font-size: .98rem !important;
  line-height: 1.35 !important;
  font-weight: 700 !important;
  letter-spacing: -0.015em !important;
}

/* Puntos más chicos y finos */
.integrated .copy li::before,
.integrated .copy li span:first-child,
.integrated .copy li i,
.integrated .copy li b {
  width: 8px !important;
  height: 8px !important;
  min-width: 8px !important;
  min-height: 8px !important;

  background: #173247 !important;
  color: #173247 !important;
  border-radius: 999px !important;
  box-shadow: 0 0 0 6px rgba(23,50,71,.075) !important;
}

/* Link menos rojo/agresivo */
.integrated .copy a {
  color: #173247 !important;
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: .78rem !important;
  letter-spacing: .20em !important;
  font-weight: 800 !important;
  text-decoration: none !important;
}

.integrated .copy a:hover {
  color: #07111d !important;
}

/* Imagen más limpia, menos pesada */
.integrated .heroImage {
  border-radius: 12px !important;
  border: 1px solid rgba(16,24,32,.12) !important;
  box-shadow:
    0 16px 42px rgba(16,24,32,.10),
    inset 0 1px 0 rgba(255,255,255,.75) !important;
  overflow: hidden !important;
}

.integrated .heroImage img {
  filter: saturate(.94) contrast(1.02) brightness(1.01) !important;
}

/* Mobile: bajar peso visual */
@media (max-width: 760px) {
  .integrated {
    padding-top: 4.2rem !important;
    padding-bottom: 4.4rem !important;
  }

  .integratedInner {
    gap: 2.15rem !important;
  }

  .integrated .copy > span {
    font-size: .66rem !important;
    letter-spacing: .24em !important;
    margin-bottom: .95rem !important;
  }

  .integrated .copy h2,
  .integrated .copy h3 {
    max-width: 330px !important;
    font-size: clamp(2.25rem, 9.2vw, 2.85rem) !important;
    line-height: 1.03 !important;
    letter-spacing: -0.055em !important;
    font-weight: 650 !important;
    margin-bottom: 1.25rem !important;
  }

  .integrated .copy p {
    max-width: 320px !important;
    font-size: .94rem !important;
    line-height: 1.68 !important;
    margin-bottom: 1.55rem !important;
  }

  .integrated .copy li {
    font-size: .93rem !important;
    font-weight: 700 !important;
  }

  .integrated .copy a {
    font-size: .72rem !important;
    letter-spacing: .18em !important;
  }

  .integrated .heroImage {
    border-radius: 10px !important;
    box-shadow:
      0 14px 34px rgba(16,24,32,.10),
      inset 0 1px 0 rgba(255,255,255,.75) !important;
  }
}

/* =====================================================
   HOME TYPOGRAPHY ALIGNMENT
   Hace que la home respete el sistema global.
   ===================================================== */

.integrated h2,
.services h2,
.globalTrust h2,
.homeOffices h2,
.homeFinalCta h2 {
  font-family: Arial, Helvetica, sans-serif !important;
  font-weight: 650 !important;
  letter-spacing: -0.045em !important;
  line-height: 1.02 !important;
}

.integrated p,
.services p,
.globalTrust p,
.homeOffices p,
.homeFinalCta p {
  font-family: Arial, Helvetica, sans-serif !important;
  font-weight: 400 !important;
  line-height: 1.64 !important;
}

.serviceRow h3,
.solutionsPanel h3,
.globalCards h3,
.homeOfficeCard h3,
.allOfficesCard h3 {
  font-family: Arial, Helvetica, sans-serif !important;
  font-weight: 650 !important;
  letter-spacing: -0.025em !important;
}

.integrated li {
  font-family: Arial, Helvetica, sans-serif !important;
  font-weight: 650 !important;
}

@media (max-width: 760px) {
  .integrated h2,
  .services h2,
  .globalTrust h2,
  .homeOffices h2,
  .homeFinalCta h2 {
    font-size: clamp(2.05rem, 9vw, 3rem) !important;
    line-height: 1.04 !important;
    letter-spacing: -0.05em !important;
  }
}

/* =====================================================
   GLOBAL TRUST TYPOGRAPHY CLEAN
   Menos bold, más corporativo premium.
   ===================================================== */

.globalTrust .globalContent > span {
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: .68rem !important;
  letter-spacing: .28em !important;
  font-weight: 700 !important;
  color: #cdbb8d !important;
}

.globalTrust h2,
.globalTrust .globalContent h2 {
  font-family: Arial, Helvetica, sans-serif !important;
  font-weight: 600 !important;
  letter-spacing: -0.045em !important;
  line-height: 1.02 !important;
  color: #ffffff !important;
  max-width: 620px !important;
}

.globalCards h3,
.globalCards article h3,
.globalCards > div h3 {
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: 1.28rem !important;
  line-height: 1.18 !important;
  font-weight: 650 !important;
  letter-spacing: -0.025em !important;
  color: #fff !important;
}

.globalCards p,
.globalCards article p,
.globalCards > div p {
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: .9rem !important;
  line-height: 1.55 !important;
  font-weight: 400 !important;
  color: rgba(255,255,255,.76) !important;
}

/* Cards más finas, menos bloque pesado */
.globalCards article,
.globalCards > div {
  border-radius: 9px !important;
  border: 1px solid rgba(255,255,255,.14) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,.082), rgba(255,255,255,.038)) !important;
  box-shadow:
    0 14px 34px rgba(0,0,0,.24),
    inset 0 1px 0 rgba(255,255,255,.10) !important;
}

@media (max-width: 760px) {
  .globalTrust .globalContent > span {
    font-size: .62rem !important;
    letter-spacing: .25em !important;
  }

  .globalTrust h2,
  .globalTrust .globalContent h2 {
    font-size: clamp(2rem, 8.8vw, 2.65rem) !important;
    line-height: 1.04 !important;
    font-weight: 600 !important;
    letter-spacing: -0.045em !important;
  }

  .globalCards {
    gap: .85rem !important;
  }

  .globalCards h3,
  .globalCards article h3,
  .globalCards > div h3 {
    font-size: 1.16rem !important;
    font-weight: 650 !important;
  }

  .globalCards p,
  .globalCards article p,
  .globalCards > div p {
    font-size: .84rem !important;
    line-height: 1.52 !important;
  }
}

/* =====================================================
   GLOBAL TRUST FINAL MOBILE BALANCE
   Ajuste fino: título menos grande, cards más limpias.
   ===================================================== */

@media (max-width: 760px) {
  .globalTrust {
    padding-top: 4.6rem !important;
    padding-bottom: 4.6rem !important;
  }

  .globalTrust .globalContent h2,
  .globalTrust h2 {
    max-width: 315px !important;
    font-size: clamp(1.88rem, 8.1vw, 2.42rem) !important;
    line-height: 1.04 !important;
    letter-spacing: -0.043em !important;
    margin-bottom: 1.65rem !important;
  }

  .globalCards {
    gap: .72rem !important;
  }

  .globalCards article,
  .globalCards > div {
    min-height: auto !important;
    padding: 1rem 1.05rem !important;
    border-radius: 8px !important;
    background:
      linear-gradient(180deg, rgba(5, 11, 18, .72), rgba(5, 11, 18, .54)) !important;
    border: 1px solid rgba(255,255,255,.13) !important;
    box-shadow:
      0 12px 28px rgba(0,0,0,.22),
      inset 0 1px 0 rgba(255,255,255,.09) !important;
  }

  .globalCards h3,
  .globalCards article h3,
  .globalCards > div h3 {
    font-size: 1.05rem !important;
    line-height: 1.18 !important;
    margin-bottom: .38rem !important;
  }

  .globalCards p,
  .globalCards article p,
  .globalCards > div p {
    font-size: .80rem !important;
    line-height: 1.48 !important;
  }
}

