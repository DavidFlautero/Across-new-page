.page {
  min-height: 100vh;
  background: #f4f1eb;
  color: #080b10;
  overflow-x: hidden;
}

/* =========================
   HERO TRACKING ENTERPRISE
   ========================= */

.hero {
  position: relative;
  min-height: clamp(590px, calc(100svh - 28px), 760px);
  padding: clamp(6.8rem, 9vh, 8rem) 6vw clamp(3.2rem, 5vh, 4.6rem);
  display: flex;
  align-items: center;
  isolation: isolate;
  overflow: hidden;
  background: #050609;
  color: #fff;
}

.heroMap {
  position: absolute !important;
  inset: 0 !important;
  z-index: -3 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  filter: brightness(.78) contrast(1.08) saturate(.96);
}

.heroMapDesktop {
  display: block !important;
  object-position: center center !important;
}

.heroMapMobile {
  display: none !important;
  object-position: center center !important;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(circle at 72% 42%, rgba(237, 27, 47, .13), transparent 28rem),
    linear-gradient(90deg, rgba(2,4,8,.97) 0%, rgba(2,4,8,.86) 34%, rgba(2,4,8,.50) 62%, rgba(2,4,8,.30) 100%),
    linear-gradient(180deg, rgba(0,0,0,.08) 0%, rgba(0,0,0,.34) 58%, rgba(0,0,0,.72) 100%);
}

.heroContent {
  width: min(820px, 100%);
  position: relative;
  z-index: 2;
}

.heroContent span {
  display: block;
  margin-bottom: 1rem;
  color: #ed1b2f;
  font-size: .78rem;
  font-weight: 950;
  letter-spacing: .20em;
  text-transform: uppercase;
}

.heroContent h1 {
  max-width: 820px;
  margin: 0;
  color: #fff;
  font-size: clamp(3.25rem, 5vw, 5.9rem);
  line-height: .9;
  letter-spacing: -.065em;
}

.heroContent h1::after {
  content: ".";
  color: #ed1b2f;
}

.heroContent p {
  max-width: 650px;
  margin: 1.35rem 0 0;
  color: rgba(255,255,255,.84);
  font-size: clamp(1rem, 1.08vw, 1.13rem);
  line-height: 1.68;
}

.heroActions {
  display: flex;
  flex-wrap: wrap;
  gap: .9rem;
  margin-top: 1.85rem;
}

.heroActions a,
.noticeCard a {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.55rem;
  text-decoration: none;
  text-transform: uppercase;
  font-size: .76rem;
  font-weight: 950;
  letter-spacing: .04em;
}

.heroActions a:first-child,
.noticeCard a {
  background: #ed1b2f;
  color: #fff;
  box-shadow: 0 18px 42px rgba(237, 27, 47, .22);
}

.heroActions a:first-child::after,
.noticeCard a::after {
  content: "→";
  margin-left: .75rem;
}

.heroActions a:last-child {
  color: #fff;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.28);
}

/* =========================
   MAP PANEL
   ========================= */

.trackingShell {
  position: relative;
  z-index: 5;
  width: min(1240px, calc(100% - 48px));
  margin: clamp(4rem, 6vw, 6rem) auto clamp(5rem, 7vw, 7rem);
  display: grid;
  gap: 1rem;
}

.mapCard {
  position: relative;
  min-height: 620px;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(380px, .68fr);
  overflow: hidden;
  background: #050609;
  border: 1px solid rgba(8,11,16,.10);
  box-shadow:
    0 32px 100px rgba(8,11,16,.18),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.mapVisual {
  position: relative;
  min-height: 620px;
  overflow: hidden;
  background: #050609;
}

.mapDesktop,
.mapMobile {
  object-fit: cover;
  filter: brightness(.90) contrast(1.06) saturate(.95);
}

.mapDesktop {
  display: block;
}

.mapMobile {
  display: none;
}

.mapShade {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 45%, rgba(255,255,255,.04), transparent 20rem),
    linear-gradient(90deg, rgba(5,6,9,.08) 0%, rgba(5,6,9,.18) 58%, #050609 100%);
}

.operationPanel {
  position: relative;
  z-index: 2;
  padding: clamp(2rem, 4vw, 3.4rem);
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at 100% 0%, rgba(237,27,47,.12), transparent 22rem),
    linear-gradient(180deg, rgba(12,14,20,.96) 0%, rgba(5,6,9,.98) 100%);
  color: #fff;
  border-left: 1px solid rgba(255,255,255,.09);
}

.operationPanel > span {
  display: block;
  margin-bottom: .9rem;
  color: #ed1b2f;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.operationPanel h2 {
  max-width: 520px;
  margin: 0;
  color: #fff;
  font-size: clamp(2rem, 3vw, 3.35rem);
  line-height: .96;
  letter-spacing: -.055em;
}

.operationPanel h2::after {
  content: ".";
  color: #ed1b2f;
}

.operationPanel p {
  max-width: 520px;
  margin: 1rem 0 0;
  color: rgba(255,255,255,.74);
  font-size: .96rem;
  line-height: 1.65;
}

.timeline {
  margin-top: 2rem;
  display: grid;
  gap: .75rem;
}

.timeline article {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: .9rem;
  align-items: center;
  padding: .95rem 0;
  border-top: 1px solid rgba(255,255,255,.11);
}

.timeline article:last-child {
  border-bottom: 1px solid rgba(255,255,255,.11);
}

.timeline strong {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  background: rgba(237,27,47,.12);
  border: 1px solid rgba(237,27,47,.40);
  color: #fff;
  font-size: .78rem;
  font-weight: 950;
}

.timeline p {
  margin: 0;
  color: rgba(255,255,255,.82);
  font-size: .9rem;
  line-height: 1.35;
  font-weight: 800;
}

/* =========================
   NOTICE
   ========================= */

.noticeCard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.4rem;
  padding: 1.25rem 1.35rem;
  background:
    radial-gradient(circle at 100% 0%, rgba(237,27,47,.08), transparent 18rem),
    rgba(255,255,255,.86);
  border: 1px solid rgba(8,11,16,.08);
  box-shadow:
    0 18px 60px rgba(8,11,16,.08),
    inset 0 1px 0 rgba(255,255,255,.82);
}

.noticeCard p {
  max-width: 820px;
  margin: 0;
  color: rgba(8,11,16,.68);
  font-size: .98rem;
  line-height: 1.55;
  font-weight: 750;
}

.noticeCard a {
  flex: 0 0 auto;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (min-width: 901px) and (max-height: 700px) {
  .hero {
    min-height: 520px;
    padding: 5.4rem 6vw 2.4rem;
  }

  .heroContent h1 {
    font-size: clamp(2.8rem, 4.7vw, 4.5rem);
  }

  .heroContent p {
    font-size: .94rem;
    line-height: 1.5;
  }

  .heroActions a {
    min-height: 42px;
  }
}

@media (max-width: 1080px) {
  .mapCard {
    grid-template-columns: 1fr;
  }

  .operationPanel {
    border-left: 0;
    border-top: 1px solid rgba(255,255,255,.09);
  }
}

@media (max-width: 760px) {
  .hero {
    min-height: auto;
    padding: 5.4rem 22px 2.7rem;
    display: block;
  }

  .heroMapDesktop {
    display: none !important;
  }

  .heroMapMobile {
    display: block !important;
  }

  .heroContent h1 {
    max-width: 420px;
    font-size: clamp(2.18rem, 9.8vw, 3.1rem);
    line-height: .95;
  }

  .heroContent p {
    max-width: 420px;
    font-size: .9rem;
    line-height: 1.52;
  }

  .heroActions {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 420px;
  }

  .heroActions a {
    width: 100%;
    min-height: 46px;
    border-radius: 999px;
  }

  .trackingShell {
    width: calc(100% - 36px);
    margin: 3.2rem auto 5rem;
  }

  .mapCard {
    min-height: auto;
  }

  .mapVisual {
    min-height: 460px;
  }

  .mapDesktop {
    display: none;
  }

  .mapMobile {
    display: block;
  }

  .mapShade {
    background:
      linear-gradient(180deg, rgba(5,6,9,.04) 0%, rgba(5,6,9,.20) 54%, #050609 100%);
  }

  .operationPanel {
    padding: 1.6rem;
  }

  .operationPanel h2 {
    font-size: clamp(1.9rem, 8.8vw, 2.7rem);
  }

  .operationPanel p {
    font-size: .88rem;
    line-height: 1.55;
  }

  .noticeCard {
    flex-direction: column;
    align-items: flex-start;
    padding: 1.35rem;
  }

  .noticeCard a {
    width: 100%;
    border-radius: 999px;
  }
}

@media (max-width: 380px) {
  .hero {
    padding: 5rem 18px 2.4rem;
  }

  .heroContent h1 {
    font-size: clamp(1.9rem, 10vw, 2.4rem);
  }

  .heroContent p {
    font-size: .82rem;
  }

  .heroActions a {
    min-height: 42px;
    font-size: .66rem;
  }

  .trackingShell {
    width: calc(100% - 28px);
  }

  .mapVisual {
    min-height: 420px;
  }

  .operationPanel {
    padding: 1.35rem;
  }
}
