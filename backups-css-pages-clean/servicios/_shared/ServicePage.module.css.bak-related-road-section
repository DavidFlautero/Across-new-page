  .hero {
    min-height: 100svh;
    padding-top: 6.7rem;
    padding-bottom: 3.6rem;
  }

  .heroContent {
    max-width: min(880px, 64vw);
    transform: translateY(1.5vh);
  }

  .heroContent h1 {
    font-size: clamp(2.45rem, 4.15vw, 4.35rem);
    line-height: .93;
  }

  .heroContent p {
    margin-top: 1.45rem;
    font-size: .98rem;
    line-height: 1.48;
  }

  .actions {
    margin-top: 1.35rem;
  }

  .actions a,
  .cta a {
    min-height: 44px;
    padding-inline: 1.15rem;
  }
}

@media (min-width: 1400px) {
  .heroContent {
    max-width: 940px;
  }
}

@media (min-width: 1800px) {
  .heroContent h1 {
    font-size: clamp(3rem, 4.2vw, 5.15rem);
  }
}

@media (max-width: 900px) {
  .hero {
  overflow: hidden;
    min-height: 72vh;
    padding: 7rem 22px 4rem;
  }

  .block,
  .servicesPanel,
  .related,
  .cta {
    width: min(100% - 28px, 720px);
  }

  .block,
  .cta {
    padding: 2rem;
    border-radius: 28px;
  }

  .servicesPanel {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .servicesImageWrap {
    min-height: 420px;
  }

  .relatedGrid {
    grid-template-columns: 1fr;
  }
}

.serviceItem {
  border-bottom: 1px solid rgba(204,0,42,.8);
}

.serviceItem summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1.55rem 0;
}

.serviceItem summary::-webkit-details-marker {
  display: none;
}

.serviceItem h3 {
  margin: 0;
  color: #c9002f;
  font-size: 1.05rem;
  font-weight: 900;
}

.serviceItem span {
  color: #111;
  font-weight: 950;
  font-size: 1.2rem;
  transition: transform .25s ease;
}

.serviceItem[open] span {
  transform: rotate(45deg);
}

.serviceItem p {
  max-width: 92%;
  margin: -.4rem 0 1.5rem;
  color: #333;
  font-size: .98rem;
  line-height: 1.7;
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 180px;
  pointer-events: none;
  background:
    linear-gradient(
      180deg,
      rgba(5,6,9,0) 0%,
      rgba(5,6,9,.45) 28%,
      rgba(244,241,235,.72) 68%,
      #f4f1eb 100%
    );
  z-index: 5;
}

.relatedGrid {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 18px !important;
}

.relatedCard {
  position: relative !important;
  min-height: 240px !important;
  overflow: hidden !important;
  border-radius: 28px !important;
  display: flex !important;
  align-items: flex-end !important;
  padding: 22px !important;
  text-decoration: none !important;
  isolation: isolate !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  background: #08090d !important;
  box-shadow: 0 24px 70px rgba(0,0,0,.20) !important;
}

.relatedCard img {
  object-fit: cover !important;
  transform: scale(1.02) !important;
  filter: brightness(.72) saturate(1.06) contrast(1.05) !important;
  transition: transform .35s ease, filter .35s ease !important;
  z-index: -2 !important;
}

.relatedCard::after {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  z-index: -1 !important;
  background:
    linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.78)),
    radial-gradient(circle at 80% 10%, rgba(200,16,46,.22), transparent 18rem) !important;
}

.relatedCard span {
  color: white !important;
  font-size: 1.05rem !important;
  font-weight: 850 !important;
  letter-spacing: -.02em !important;
  text-shadow: 0 10px 28px rgba(0,0,0,.55) !important;
}

.relatedCard:hover img {
  transform: scale(1.08) !important;
  filter: brightness(.86) saturate(1.14) contrast(1.08) !important;
}

@media (max-width: 900px) {
  .relatedGrid {
    grid-template-columns: 1fr !important;
  }

  .relatedCard {
    min-height: 210px !important;
  }
}


/* === Air freight capabilities section === */
.capabilities {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr);
  gap: 28px;
  align-items: stretch;
  margin: 64px 0 54px;
}

.capabilitiesContent {
  position: relative;
  overflow: hidden;
  border-radius: 34px;
  padding: clamp(28px, 4vw, 54px);
  background:
    radial-gradient(circle at 86% 12%, rgba(204,0,47,.20), transparent 26rem),
    linear-gradient(145deg, #151114 0%, #37121d 48%, #17181c 100%);
  color: #fff;
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 28px 80px rgba(0,0,0,.18);
}

.capabilitiesContent::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,55,91,.62), transparent);
}

.capabilitiesContent > span {
  display: inline-flex;
  margin-bottom: 18px;
  color: #d8b869;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .22em;
}

.capabilitiesContent h2 {
  max-width: 780px;
  margin: 0;
  font-size: clamp(32px, 4vw, 58px);
  line-height: .94;
  letter-spacing: -.055em;
}

.capabilitiesContent p {
  max-width: 760px;
  margin: 22px 0 0;
  color: rgba(255,255,255,.72);
  font-size: 16px;
  line-height: 1.7;
}

.capabilityStats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-top: 34px;
}

.capabilityStats div {
  min-height: 112px;
  padding: 20px 18px;
  border-radius: 24px;
  background: rgba(255,255,255,.055);
  border: 1px solid rgba(255,255,255,.09);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
}

.capabilityStats strong {
  display: block;
  color: #fff;
  font-size: clamp(24px, 2.5vw, 36px);
  line-height: .9;
  letter-spacing: -.04em;
}

.capabilityStats small {
  display: block;
  margin-top: 12px;
  color: rgba(255,255,255,.62);
  font-size: 12px;
  line-height: 1.35;
  font-weight: 700;
}

.capabilitiesImage {
  position: relative;
  min-height: 420px;
  overflow: hidden;
  border-radius: 34px;
  background: #08090d;
  border: 1px solid rgba(0,0,0,.08);
  box-shadow: 0 28px 80px rgba(0,0,0,.16);
}

.capabilitiesImage img {
  object-fit: cover;
  filter: brightness(.82) saturate(1.08) contrast(1.06);
  transform: scale(1.02);
}

.capabilitiesImage::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.36)),
    radial-gradient(circle at 80% 10%, rgba(204,0,47,.18), transparent 18rem);
}

/* Improve air accordion visual weight */
