.page {
  background: #f4f1eb;
  color: #111;
  overflow: hidden;
}

.hero {
  overflow: hidden;
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding: clamp(7rem, 10vh, 9rem) 6vw clamp(4.5rem, 7vh, 6rem);
  isolation: isolate;
  background: #050609;
  color: #fff;
}

.heroImage {
  object-fit: cover;
  z-index: -3;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(90deg, rgba(3,4,8,.94) 0%, rgba(3,4,8,.72) 42%, rgba(3,4,8,.16) 100%),
    linear-gradient(180deg, rgba(0,0,0,.25) 0%, rgba(0,0,0,.78) 100%);
}

.heroContent {
  max-width: min(920px, 62vw);
  transform: translateY(2.5vh);
}

.heroContent > span,
.block > span,
.cta > span {
  display: inline-flex;
  margin-bottom: 1rem;
  color: #c7a25a;
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.heroContent h1 {
  max-width: 900px;
  margin: 0;
  font-size: clamp(2.8rem, 4.65vw, 5rem);
  line-height: .94;
  letter-spacing: -.065em;
  font-weight: 950;
}

.heroContent p {
  max-width: 760px;
  margin: 1.75rem 0 0;
  color: rgba(255,255,255,.82);
  font-size: clamp(.98rem, 1.15vw, 1.15rem);
  line-height: 1.58;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: .9rem;
  margin-top: 1.7rem;
}

.actions a,
.cta a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 1.25rem;
  border-radius: 999px;
  font-weight: 900;
  text-decoration: none;
}

.actions a:first-child,
.cta a {
  background: linear-gradient(135deg, #b4002d, #ec1749);
  color: #fff;
  box-shadow: 0 18px 48px rgba(180,0,45,.35);
}

.actions a:last-child {
  color: #fff;
  border: 1px solid rgba(255,255,255,.22);
  background: rgba(255,255,255,.08);
  backdrop-filter: blur(14px);
}

.content {
  width: 100%;
  padding: 0;
  background: #f4f1eb;
}

.mainContent {
  width: 100%;
}

.block {
  width: min(1180px, calc(100% - 40px));
  margin: 5rem auto 4rem;
  padding: 4rem 3.5rem;
  border-radius: 34px;
  color: #fff;
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(90deg,
      rgba(3,6,14,1) 0%,
      rgba(20,8,18,.98) 38%,
      rgba(65,12,28,.82) 72%,
      rgba(20,12,18,.18) 100%
    );
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: 0 18px 60px rgba(0,0,0,.10);
}

.block h2,
.related h2,
.cta h2 {
  margin: 0;
  font-size: clamp(2rem, 3.4vw, 3.4rem);
  line-height: 1;
  letter-spacing: -.05em;
}

.block p,
.cta p {
  max-width: 780px;
  margin: 1.2rem 0 0;
  color: rgba(255,255,255,.74);
  font-size: 1.05rem;
  line-height: 1.75;
}

.servicesPanel {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto 5rem;
  display: grid;
  grid-template-columns: .92fr 1.08fr;
  gap: 4rem;
  align-items: stretch;
}

.servicesCopy {
  padding-top: .5rem;
}

.servicesCopy p {
  max-width: 520px;
  margin: 0 0 2rem;
  color: #171717;
  font-size: 1rem;
  line-height: 1.65;
}

.servicesCopy p::after {
  content: "";
  display: block;
  width: 100%;
  height: 1px;
  margin-top: 2rem;
  background: rgba(0,0,0,.75);
}

.servicesCopy h2 {
  max-width: 560px;
  margin: 0 0 2.2rem;
  font-size: clamp(2.2rem, 3.8vw, 4rem);
  line-height: 1.08;
  letter-spacing: -.055em;
  color: #050505;
}

.accordion {
  overflow: hidden;
}

.accordion article {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1.55rem 0;
  border-bottom: 1px solid rgba(204,0,42,.8);
}

.accordion h3 {
  margin: 0;
  color: #c9002f;
  font-size: 1.05rem;
  font-weight: 900;
}

.accordion span {
  color: #111;
  font-weight: 950;
  font-size: 1.2rem;
}

.servicesImageWrap {
  position: relative;
  min-height: 760px;
  border-radius: 0;
  overflow: hidden;
  box-shadow: 0 28px 80px rgba(0,0,0,.12);
}

.servicesImage {
  object-fit: cover;
}

.related {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto 4rem;
  color: #111;
}

.relatedGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1.4rem;
}

.relatedGrid a {
  min-height: 150px;
  padding: 1.3rem;
  display: flex;
  align-items: flex-end;
  border-radius: 28px;
  color: #fff;
  text-decoration: none;
  font-weight: 900;
  background:
    linear-gradient(135deg, rgba(180,0,45,.34), rgba(255,255,255,.06)),
    #15161a;
  border: 1px solid rgba(255,255,255,.1);
  box-shadow: 0 20px 60px rgba(0,0,0,.18);
}

.cta {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto 6rem;
  padding: 3rem;
  border-radius: 36px;
  color: #fff;
  background:
    linear-gradient(135deg, rgba(180,0,45,.34), rgba(199,162,90,.18)),
    #15161a;
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 28px 80px rgba(0,0,0,.16);
}

.cta a {
  margin-top: 1.8rem;
}



/* SERVICE HERO DESKTOP SAFETY */
