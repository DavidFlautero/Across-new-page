.hero {
  position: relative;
  width: 100%;
  min-height: 100svh;
  height: 100svh;
  overflow: hidden;
  background: #050505;
  color: #fff;
}

.video,
.overlay,
.redGlow {
  position: absolute;
  inset: 0;
}

.video {
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #07080c;
  filter: brightness(0.96) saturate(1.08) contrast(1.08);
  pointer-events: none;
}

.overlay {
  z-index: 2;
  background:
    linear-gradient(90deg, rgba(4, 6, 10, 0.84) 0%, rgba(4, 6, 10, 0.34) 50%, rgba(4, 6, 10, 0.12) 100%),
    linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.34) 100%);
  pointer-events: none;
}

.redGlow {
  z-index: 3;
  background:
    radial-gradient(circle at 88% 18%, rgba(193, 18, 47, 0.22), transparent 34rem),
    linear-gradient(110deg, transparent 0%, transparent 62%, rgba(193, 18, 47, 0.16) 100%);
  pointer-events: none;
}

.content {
  position: absolute;
  z-index: 10;
  left: clamp(2rem, 5vw, 5rem);
  right: clamp(2rem, 5vw, 5rem);
  top: clamp(7.8rem, 15vh, 10.5rem);
  bottom: clamp(7.6rem, 13vh, 9.5rem);
  max-width: 980px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  transform: translateY(3.2vh);
}

.titleWrap {
  width: 100%;
  max-width: 980px;
}

.title {
  margin: 0;
  max-width: 980px;
  color: #fff;
  font-family: var(--font-tight), system-ui, sans-serif;
  font-size: clamp(3.15rem, 4.75vw, 5.85rem);
  line-height: 0.91;
  font-weight: 300;
  letter-spacing: -0.058em;
  text-shadow: 0 16px 44px rgba(0, 0, 0, 0.46);
}

.title span {
  display: block;
}

.subtitle {
  max-width: 760px;
  margin: 1.75rem 0 0;
  color: rgba(255, 255, 255, 0.8);
  font-size: clamp(1rem, 1.05vw, 1.2rem);
  font-weight: 700;
  line-height: 1.55;
  text-shadow: 0 10px 30px rgba(0, 0, 0, 0.42);
}

.line {
  width: min(720px, 48vw);
  height: 1px;
  margin-top: 1.45rem;
  background:
    linear-gradient(
      90deg,
      rgba(255, 0, 76, 0) 0%,
      rgba(255, 0, 76, 0.14) 10%,
      rgba(255, 45, 82, 0.72) 50%,
      rgba(255, 0, 76, 0.14) 90%,
      rgba(255, 0, 76, 0) 100%
    );
  opacity: 0.45;
  box-shadow:
    0 0 10px rgba(255, 45, 82, 0.18),
    0 0 24px rgba(255, 45, 82, 0.08);
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(190px, 1fr));
  gap: 0.85rem;
  width: min(560px, 100%);
  margin-top: 1.65rem;
}

.primaryBtn,
.secondaryBtn {
  min-height: 56px;
  border-radius: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.2rem;
  text-align: center;
  text-decoration: none;
  color: #fff;
  font-family: var(--font-manrope), system-ui, sans-serif;
  font-size: 0.9rem;
  font-weight: 850;
  line-height: 1.1;
  letter-spacing: -0.01em;
  backdrop-filter: blur(16px) saturate(1.18);
  -webkit-backdrop-filter: blur(16px) saturate(1.18);
  transition: transform 0.24s ease, box-shadow 0.24s ease, background 0.24s ease;
}

.primaryBtn {
  border: 1px solid rgba(255, 70, 105, 0.34);
  background:
    linear-gradient(
      135deg,
      rgba(120, 8, 24, 0.96) 0%,
      rgba(190, 10, 45, 0.94) 48%,
      rgba(125, 7, 28, 0.96) 100%
    );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.12),
    0 14px 34px rgba(120, 8, 24, 0.36),
    0 0 22px rgba(180, 18, 50, 0.18);
}

.secondaryBtn {
  border: 1px solid rgba(255, 255, 255, 0.16);
  background:
    linear-gradient(
      135deg,
      rgba(12, 12, 12, 0.56),
      rgba(28, 18, 18, 0.36)
    );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 16px 45px rgba(0, 0, 0, 0.24);
}

.primaryBtn:hover,
.secondaryBtn:hover {
  transform: translateY(-2px);
}

.commandBar {
  position: absolute;
  z-index: 12;
  left: clamp(1rem, 4vw, 4.5rem);
  right: clamp(1rem, 4vw, 4.5rem);
  bottom: 1.45rem;
  height: 74px;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(6, 6, 6, 0.66);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:
    0 -20px 50px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.03);
}

.commandItem {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 0 1.2rem;
  color: #fff;
  text-decoration: none;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  transition: background 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
}

.commandItem:last-child {
  border-right: 0;
}

.commandItem:hover {
  transform: translateY(-2px);
  background:
    linear-gradient(90deg, rgba(193, 18, 47, 0.16), rgba(255, 255, 255, 0.045));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.commandItem svg {
  width: 27px;
  height: 27px;
  flex: 0 0 27px;
  fill: none;
  stroke: rgba(255, 255, 255, 0.86);
  stroke-width: 1.45;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.commandItem:hover svg {
  stroke: #ff405e;
}

.commandItem span {
  display: block;
  color: #fff;
  font-size: 0.88rem;
  font-weight: 850;
  margin-bottom: 0.16rem;
}

.commandItem small {
  display: block;
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.7rem;
  line-height: 1.2;
}

/* TABLET */
@media (min-width: 761px) and (max-width: 1100px) {
  .content {
    left: clamp(1.5rem, 5vw, 3.4rem);
    right: clamp(1.5rem, 5vw, 3.4rem);
    top: clamp(8rem, 18vh, 12rem);
    max-width: 720px;
  }

  .title {
    max-width: 720px;
    font-size: clamp(3rem, 7.2vw, 5.2rem);
    line-height: 0.92;
  }

  .subtitle {
    max-width: 620px;
    margin-top: 1.35rem;
    font-size: clamp(0.96rem, 2vw, 1.15rem);
    line-height: 1.42;
  }

  .line {
    display: none;
  }

  .actions {
    width: min(600px, 100%);
    margin-top: 1.2rem;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 54px;
    border-radius: 17px;
    font-size: 0.9rem;
  }

  .commandBar {
    left: 0;
    right: 0;
    bottom: 0;
    height: 82px;
    border-left: 0;
    border-right: 0;
    border-bottom: 0;
    background: rgba(5, 5, 8, 0.92);
  }

  .commandItem {
    justify-content: center;
    padding: 0 0.9rem;
  }
}

/* TABLET BAJITA / LANDSCAPE */
@media (min-width: 761px) and (max-width: 1100px) and (max-height: 760px) {
  .content {
    top: 6.4rem;
    max-width: 540px;
  }

  .title {
    font-size: clamp(2rem, 4.7vw, 3.2rem);
  }

  .subtitle {
    margin-top: 0.9rem;
    font-size: 0.82rem;
    line-height: 1.3;
  }

  .actions {
    width: min(440px, 100%);
    gap: 0.55rem;
    margin-top: 0.8rem;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 40px;
    border-radius: 13px;
    font-size: 0.68rem;
  }

  .commandBar {
    height: 64px;
  }

  .commandItem svg {
    width: 18px;
    height: 18px;
    flex-basis: 18px;
  }

  .commandItem span {
    font-size: 0.72rem;
  }

  .commandItem small {
    font-size: 0.58rem;
  }
}

/* MOBILE */
@media (max-width: 760px) {
  .hero {
    min-height: 100svh;
    height: 100svh;
  }

  .video {
    filter: brightness(0.92) saturate(1.05) contrast(1.05);
  }

  .overlay {
    background:
      linear-gradient(90deg, rgba(4, 6, 10, 0.72) 0%, rgba(4, 6, 10, 0.28) 58%, rgba(4, 6, 10, 0.12) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0.34) 100%);
  }

  .content {
    left: 0;
    right: 0;
    top: calc(74px + env(safe-area-inset-top));
    bottom: calc(88px + env(safe-area-inset-bottom));
    max-width: none;
    padding: 0 0.82rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transform: translateY(5.5svh);
  }

  .titleWrap {
    max-width: 100%;
  }

  .title {
    max-width: 96vw;
    font-size: clamp(1.64rem, 8.6vw, 3.1rem);
    line-height: 0.93;
    letter-spacing: -0.055em;
  }

  .subtitle {
    max-width: 94vw;
    margin-top: 0.82rem;
    font-size: clamp(0.72rem, 3.08vw, 0.86rem);
    line-height: 1.28;
  }

  .line {
    display: none;
  }

  .actions {
    grid-template-columns: 1fr 1fr;
    width: 100%;
    max-width: 96vw;
    gap: 0.48rem;
    margin-top: 0.8rem;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: clamp(38px, 5.8svh, 45px);
    border-radius: 14px;
    padding: 0 0.42rem;
    font-size: clamp(0.56rem, 2.55vw, 0.72rem);
    line-height: 1.08;
    font-weight: 950;
    white-space: normal;
  }

  .commandBar {
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 100%;
    height: 82px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-left: 0;
    border-right: 0;
    border-bottom: 0;
    background: rgba(5, 5, 8, 0.94);
    padding-right: 0;
    transform: none;
  }

  .commandItem {
    min-width: 0;
    min-height: 82px;
    padding: 9px 4px;
    gap: 6px;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .commandItem svg {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .commandItem span {
    font-size: 0.62rem;
    line-height: 1;
    margin: 0;
  }

  .commandItem small {
    font-size: 0.48rem;
    line-height: 1.05;
  }
}

/* MOBILE MUY BAJITO: 375x667 */
@media (max-width: 760px) and (max-height: 720px) {
  .content {
    top: calc(64px + env(safe-area-inset-top));
    bottom: calc(74px + env(safe-area-inset-bottom));
    padding: 0 0.72rem;
    justify-content: center;
    transform: translateY(3.5svh);
  }

  .title {
    font-size: clamp(1.34rem, 7.45vw, 2.18rem);
    line-height: 0.92;
  }

  .subtitle {
    margin-top: 0.62rem;
    font-size: clamp(0.6rem, 2.65vw, 0.7rem);
    line-height: 1.2;
  }

  .actions {
    gap: 0.4rem;
    margin-top: 0.58rem;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 35px;
    border-radius: 12px;
    font-size: 0.56rem;
    padding: 0 0.34rem;
  }

  .commandBar {
    height: 68px;
    width: 100%;
    max-width: 100%;
    padding-right: 0;
  }

  .commandItem {
    min-width: 0;
    min-height: 68px;
    padding: 6px 3px;
    overflow: hidden;
  }

  .commandItem svg {
    width: 16px;
    height: 16px;
    flex-basis: 16px;
  }

  .commandItem span {
    font-size: 0.52rem;
  }

  .commandItem small {
    font-size: 0.4rem;
  }
}

/* MOBILE ANGOSTO */
@media (max-width: 390px) {
  .content {
    padding-inline: 0.68rem;
  }

  .actions {
    gap: 0.38rem;
  }

  .primaryBtn,
  .secondaryBtn {
    font-size: 0.54rem;
    padding-inline: 0.3rem;
  }
}

/* DESKTOP BAJO */
@media (min-width: 1101px) and (max-height: 780px) {
  .content {
    top: 6.4rem;
    bottom: 6rem;
    transform: translateY(2vh);
  }

  .title {
    font-size: clamp(2.55rem, 3.75vw, 4.25rem);
    line-height: 0.9;
  }

  .subtitle {
    margin-top: 1.15rem;
    font-size: 0.94rem;
    line-height: 1.42;
  }

  .actions {
    margin-top: 1.15rem;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 48px;
  }

  .commandBar {
    height: 66px;
    bottom: 1rem;
  }
}

/* =====================================================
   HOME MOBILE PHASE 1 — HERO TYPOGRAPHY + SPACING
   Ajuste puntual pedido por cliente:
   versión móvil / letras / respiración visual
   ===================================================== */

@media (max-width: 760px) {
  .hero {
    min-height: 100svh !important;
  }

  .content {
    top: calc(76px + env(safe-area-inset-top)) !important;
    bottom: calc(92px + env(safe-area-inset-bottom)) !important;
    padding-inline: 22px !important;
    transform: translateY(3.2svh) !important;
    max-width: 100% !important;
  }

  .titleWrap {
    max-width: 340px !important;
  }

  .title {
    max-width: 340px !important;
    font-size: clamp(2.05rem, 9.2vw, 3.05rem) !important;
    line-height: .98 !important;
    letter-spacing: -.052em !important;
    margin-bottom: .82rem !important;
  }

  .subtitle {
    max-width: 315px !important;
    margin-top: .72rem !important;
    font-size: clamp(.84rem, 3.35vw, .96rem) !important;
    line-height: 1.55 !important;
    color: rgba(255,255,255,.78) !important;
  }

  .actions {
    max-width: 330px !important;
    margin-top: 1rem !important;
  }

  .commandBar {
    height: 78px !important;
  }

  .commandItem {
    min-height: 78px !important;
  }

  .commandItem span {
    font-size: 9.5px !important;
    line-height: 1.08 !important;
  }

  .commandItem small {
    font-size: 7.5px !important;
    line-height: 1.05 !important;
  }
}

@media (max-width: 430px) {
  .content {
    padding-inline: 20px !important;
    transform: translateY(2.7svh) !important;
  }

  .titleWrap {
    max-width: 320px !important;
  }

  .title {
    max-width: 320px !important;
    font-size: clamp(1.92rem, 8.8vw, 2.72rem) !important;
    line-height: 1 !important;
  }

  .subtitle {
    max-width: 300px !important;
    font-size: clamp(.8rem, 3.2vw, .9rem) !important;
    line-height: 1.52 !important;
  }

  .actions {
    max-width: 315px !important;
  }
}

@media (max-width: 380px), (max-height: 720px) {
  .content {
    top: calc(66px + env(safe-area-inset-top)) !important;
    bottom: calc(78px + env(safe-area-inset-bottom)) !important;
    padding-inline: 18px !important;
    transform: translateY(1.6svh) !important;
  }

  .titleWrap {
    max-width: 292px !important;
  }

  .title {
    max-width: 292px !important;
    font-size: clamp(1.72rem, 8.1vw, 2.25rem) !important;
    line-height: 1 !important;
    margin-bottom: .58rem !important;
  }

  .subtitle {
    max-width: 282px !important;
    margin-top: .52rem !important;
    font-size: clamp(.72rem, 2.9vw, .82rem) !important;
    line-height: 1.45 !important;
  }

  .actions {
    max-width: 292px !important;
    margin-top: .72rem !important;
  }

  .commandBar {
    height: 66px !important;
  }

  .commandItem {
    min-height: 66px !important;
    padding: 5px 3px !important;
  }

  .commandItem svg {
    width: 15px !important;
    height: 15px !important;
    flex-basis: 15px !important;
  }

  .commandItem span {
    font-size: 8.5px !important;
  }

  .commandItem small {
    font-size: 6.8px !important;
  }
}

/* =====================================================
   HOME MOBILE PHASE 2 — CTA + SHADOW POLISH
   Ajuste puntual pedido por cliente:
   llamados de acción / botones / sombras
   ===================================================== */

@media (max-width: 760px) {
  .actions {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: .72rem !important;
    width: 100% !important;
    max-width: 330px !important;
    margin-top: 1.12rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    width: 100% !important;
    min-height: 50px !important;
    padding: 0 1rem !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 999px !important;
    text-align: center !important;
    text-decoration: none !important;
    text-transform: uppercase !important;

    font-size: .72rem !important;
    font-weight: 950 !important;
    letter-spacing: .065em !important;
    line-height: 1.1 !important;

    backdrop-filter: blur(14px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.08) !important;

    transition:
      transform .22s ease,
      box-shadow .22s ease,
      border-color .22s ease,
      background .22s ease !important;
  }

  .primaryBtn {
    color: #fff !important;
    background:
      linear-gradient(135deg, #b40032 0%, #ed1b2f 52%, #980027 100%) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    box-shadow:
      0 16px 34px rgba(180,0,50,.24),
      0 4px 12px rgba(0,0,0,.20),
      inset 0 1px 0 rgba(255,255,255,.18) !important;
  }

  .secondaryBtn {
    color: rgba(255,255,255,.94) !important;
    background:
      linear-gradient(180deg, rgba(255,255,255,.105), rgba(255,255,255,.052)) !important;
    border: 1px solid rgba(255,255,255,.24) !important;
    box-shadow:
      0 14px 32px rgba(0,0,0,.24),
      inset 0 1px 0 rgba(255,255,255,.10) !important;
  }

  .primaryBtn:active,
  .secondaryBtn:active {
    transform: translateY(1px) scale(.99) !important;
  }

  .commandBar {
    border-top: 1px solid rgba(255,255,255,.12) !important;
    border-bottom: 1px solid rgba(255,255,255,.08) !important;
    background: rgba(5,6,9,.91) !important;
    box-shadow:
      0 -18px 42px rgba(0,0,0,.28),
      inset 0 1px 0 rgba(255,255,255,.045) !important;
    backdrop-filter: blur(18px) saturate(1.12) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.12) !important;
  }

  .commandItem {
    border-right: 1px solid rgba(255,255,255,.075) !important;
  }
}

@media (max-width: 430px) {
  .actions {
    max-width: 315px !important;
    gap: .66rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 48px !important;
    font-size: .68rem !important;
    letter-spacing: .055em !important;
  }
}

@media (max-width: 380px), (max-height: 720px) {
  .actions {
    max-width: 292px !important;
    gap: .56rem !important;
    margin-top: .78rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 44px !important;
    font-size: .62rem !important;
    letter-spacing: .048em !important;
  }
}

/* =====================================================
   HOME MOBILE PHASE 2 — CTA + SHADOW POLISH
   Ajuste puntual pedido por cliente:
   llamados de acción / botones / sombras
   ===================================================== */

@media (max-width: 760px) {
  .actions {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: .72rem !important;
    width: 100% !important;
    max-width: 330px !important;
    margin-top: 1.12rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    width: 100% !important;
    min-height: 50px !important;
    padding: 0 1rem !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 999px !important;
    text-align: center !important;
    text-decoration: none !important;
    text-transform: uppercase !important;

    font-size: .72rem !important;
    font-weight: 950 !important;
    letter-spacing: .065em !important;
    line-height: 1.1 !important;

    backdrop-filter: blur(14px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.08) !important;

    transition:
      transform .22s ease,
      box-shadow .22s ease,
      border-color .22s ease,
      background .22s ease !important;
  }

  .primaryBtn {
    color: #fff !important;
    background:
      linear-gradient(135deg, #b40032 0%, #ed1b2f 52%, #980027 100%) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    box-shadow:
      0 16px 34px rgba(180,0,50,.24),
      0 4px 12px rgba(0,0,0,.20),
      inset 0 1px 0 rgba(255,255,255,.18) !important;
  }

  .secondaryBtn {
    color: rgba(255,255,255,.94) !important;
    background:
      linear-gradient(180deg, rgba(255,255,255,.105), rgba(255,255,255,.052)) !important;
    border: 1px solid rgba(255,255,255,.24) !important;
    box-shadow:
      0 14px 32px rgba(0,0,0,.24),
      inset 0 1px 0 rgba(255,255,255,.10) !important;
  }

  .primaryBtn:active,
  .secondaryBtn:active {
    transform: translateY(1px) scale(.99) !important;
  }

  .commandBar {
    border-top: 1px solid rgba(255,255,255,.12) !important;
    border-bottom: 1px solid rgba(255,255,255,.08) !important;
    background: rgba(5,6,9,.91) !important;
    box-shadow:
      0 -18px 42px rgba(0,0,0,.28),
      inset 0 1px 0 rgba(255,255,255,.045) !important;
    backdrop-filter: blur(18px) saturate(1.12) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.12) !important;
  }

  .commandItem {
    border-right: 1px solid rgba(255,255,255,.075) !important;
  }
}

@media (max-width: 430px) {
  .actions {
    max-width: 315px !important;
    gap: .66rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 48px !important;
    font-size: .68rem !important;
    letter-spacing: .055em !important;
  }
}

@media (max-width: 380px), (max-height: 720px) {
  .actions {
    max-width: 292px !important;
    gap: .56rem !important;
    margin-top: .78rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 44px !important;
    font-size: .62rem !important;
    letter-spacing: .048em !important;
  }
}

/* =====================================================
   HOME MOBILE PHASE 2.1 — SAFE EDGES FIX
   Corrige cortes laterales en mobile:
   header visual, texto hero, CTAs y command bar
   ===================================================== */

@media (max-width: 760px) {
  .hero {
    width: 100% !important;
    max-width: 100vw !important;
    overflow: hidden !important;
  }

  .content {
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 100vw !important;
    box-sizing: border-box !important;
    padding-left: 18px !important;
    padding-right: 18px !important;
  }

  .titleWrap,
  .title,
  .subtitle,
  .actions {
    margin-left: 0 !important;
    margin-right: auto !important;
  }

  .titleWrap {
    width: 100% !important;
    max-width: 325px !important;
  }

  .title {
    max-width: 325px !important;
  }

  .subtitle {
    max-width: 305px !important;
  }

  .actions {
    width: 100% !important;
    max-width: 310px !important;
  }

  .primaryBtn,
  .secondaryBtn {
    width: 100% !important;
    max-width: 310px !important;
  }

  .commandBar {
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 100vw !important;
    box-sizing: border-box !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    overflow: hidden !important;
  }

  .commandItem {
    min-width: 0 !important;
    overflow: hidden !important;
  }

  .commandItem span,
  .commandItem small {
    max-width: 100% !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
}

@media (max-width: 430px) {
  .content {
    padding-left: 18px !important;
    padding-right: 18px !important;
  }

  .titleWrap,
  .title {
    max-width: 315px !important;
  }

  .subtitle {
    max-width: 295px !important;
  }

  .actions,
  .primaryBtn,
  .secondaryBtn {
    max-width: 300px !important;
  }
}

@media (max-width: 380px) {
  .content {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }

  .titleWrap,
  .title {
    max-width: 292px !important;
  }

  .subtitle {
    max-width: 278px !important;
  }

  .actions,
  .primaryBtn,
  .secondaryBtn {
    max-width: 292px !important;
  }
}

/* =====================================================
   HOME MOBILE PHASE 2.2 — FLOATING CTA CLEANUP
   Limpieza visual mobile: evita CTA flotante compitiendo
   con botones principales y command bar
   ===================================================== */

@media (max-width: 760px) {
  .hero :global(.floatingCall),
  .hero :global(.floating-call),
  .hero :global([class*="floating"]),
  .hero :global([class*="Floating"]),
  .hero :global([class*="whatsapp"]),
  .hero :global([class*="Whatsapp"]) {
    display: none !important;
  }

  .commandItem span {
    font-size: 8.8px !important;
    letter-spacing: -.02em !important;
  }

  .commandItem small {
    font-size: 6.8px !important;
    letter-spacing: -.02em !important;
  }
}

@media (max-width: 380px) {
  .commandItem span {
    font-size: 8px !important;
  }

  .commandItem small {
    font-size: 6.2px !important;
  }
}

/* =====================================================
   HOME MOBILE ROUND 3 — MAERSK CORPORATE MOBILE STYLE
   Dirección: menos landing oscura, más portal corporativo.
   - Botones sobrios
   - Menos glow
   - Mejor lectura
   - Quick access más institucional
   ===================================================== */

@media (max-width: 760px) {
  .hero {
    background: #f7f5f0 !important;
  }

  .overlay {
    background:
      linear-gradient(180deg, rgba(5, 6, 9, .52) 0%, rgba(5, 6, 9, .36) 36%, rgba(5, 6, 9, .60) 100%),
      linear-gradient(90deg, rgba(5, 6, 9, .58), rgba(5, 6, 9, .16)) !important;
  }

  .redGlow {
    opacity: .22 !important;
    filter: blur(34px) !important;
  }

  .content {
    padding-left: 22px !important;
    padding-right: 22px !important;
  }

  .title {
    color: #fff !important;
    text-shadow: 0 4px 18px rgba(0,0,0,.32) !important;
  }

  .subtitle {
    color: rgba(255,255,255,.86) !important;
    font-weight: 750 !important;
    text-shadow: 0 3px 12px rgba(0,0,0,.24) !important;
  }

  .actions {
    grid-template-columns: 1fr !important;
    gap: .72rem !important;
    max-width: 315px !important;
  }

  .primaryBtn,
  .secondaryBtn {
    border-radius: 6px !important;
    min-height: 48px !important;
    font-size: .68rem !important;
    letter-spacing: .045em !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .primaryBtn {
    background: #b40032 !important;
    border: 1px solid #b40032 !important;
    color: #fff !important;
  }

  .secondaryBtn {
    background: #151515 !important;
    border: 1px solid #151515 !important;
    color: #fff !important;
  }

  .commandBar {
    height: 76px !important;
    background: #111 !important;
    border-top: 1px solid rgba(255,255,255,.14) !important;
    border-bottom: 0 !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .commandItem {
    background: transparent !important;
    border-right: 1px solid rgba(255,255,255,.12) !important;
  }

  .commandItem svg {
    stroke: rgba(255,255,255,.9) !important;
  }

  .commandItem span {
    color: #fff !important;
    font-weight: 900 !important;
  }

  .commandItem small {
    color: rgba(255,255,255,.64) !important;
  }
}

@media (max-width: 430px) {
  .content {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }

  .actions {
    max-width: 305px !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 46px !important;
    font-size: .64rem !important;
  }
}

@media (max-width: 380px) {
  .content {
    padding-left: 18px !important;
    padding-right: 18px !important;
  }

  .actions {
    max-width: 292px !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 44px !important;
    font-size: .6rem !important;
  }

  .commandBar {
    height: 68px !important;
  }

  .commandItem {
    min-height: 68px !important;
  }
}

/* =====================================================
   HERO WHITE CORPORATE DIRECTION
   Menos oscuro/cinemático, más corporativo.
   ===================================================== */

@media (min-width: 761px) {
  .hero {
    background: #f7f5f0 !important;
  }

  .video {
    filter: brightness(.82) contrast(1.02) saturate(.92) !important;
  }

  .overlay {
    background:
      linear-gradient(90deg, rgba(5,6,9,.72) 0%, rgba(5,6,9,.40) 46%, rgba(5,6,9,.12) 100%),
      linear-gradient(180deg, rgba(5,6,9,.10), rgba(5,6,9,.30)) !important;
  }

  .redGlow {
    opacity: .18 !important;
  }

  .primaryBtn {
    background: #b40032 !important;
    border: 1px solid #b40032 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
  }

  .secondaryBtn {
    background: #111 !important;
    border: 1px solid #111 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
    color: #fff !important;
  }

  .commandBar {
    background: #fff !important;
    border: 1px solid rgba(0,0,0,.10) !important;
    box-shadow: 0 18px 48px rgba(0,0,0,.10) !important;
  }

  .commandItem {
    color: #111 !important;
    border-right: 1px solid rgba(0,0,0,.10) !important;
  }

  .commandItem span {
    color: #111 !important;
  }

  .commandItem small {
    color: rgba(17,17,17,.62) !important;
  }

  .commandItem svg {
    stroke: #111 !important;
  }
}

@media (max-width: 760px) {
  .primaryBtn {
    background: #b40032 !important;
    border-color: #b40032 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
  }

  .secondaryBtn {
    background: #111 !important;
    border-color: #111 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
  }

  .commandBar {
    background: #fff !important;
    border-top: 1px solid rgba(0,0,0,.12) !important;
    box-shadow: none !important;
  }

  .commandItem {
    border-right: 1px solid rgba(0,0,0,.10) !important;
  }

  .commandItem span {
    color: #111 !important;
  }

  .commandItem small {
    color: rgba(17,17,17,.62) !important;
  }

  .commandItem svg {
    stroke: #111 !important;
  }
}

/* =====================================================
   DESKTOP HERO HYBRID FIX
   Corrige mezcla rara: hero oscuro + commandBar blanca.
   Mantiene desktop elegante y deja blanco para secciones.
   ===================================================== */

@media (min-width: 761px) {
  .commandBar {
    background: rgba(6, 6, 6, 0.76) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    box-shadow:
      0 -20px 50px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.04) !important;
    backdrop-filter: blur(18px) !important;
    -webkit-backdrop-filter: blur(18px) !important;
  }

  .commandItem {
    color: #fff !important;
    border-right: 1px solid rgba(255,255,255,.10) !important;
  }

  .commandItem span {
    color: #fff !important;
  }

  .commandItem small {
    color: rgba(255,255,255,.62) !important;
  }

  .commandItem svg {
    stroke: rgba(255,255,255,.86) !important;
  }

  .primaryBtn {
    background: #b40032 !important;
    border: 1px solid #b40032 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
  }

  .secondaryBtn {
    background: #111 !important;
    border: 1px solid #111 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
    color: #fff !important;
  }
}

/* =====================================================
   HERO MOBILE CLEAN ACCESS ROUND
   Objetivo:
   - título más corporativo y menos gigante
   - CTAs claros
   - barra inferior blanca limpia tipo accesos rápidos
   - sin textos microscópicos ni elementos rotos
   ===================================================== */

@media (max-width: 760px) {
  .content {
    top: calc(78px + env(safe-area-inset-top)) !important;
    bottom: calc(82px + env(safe-area-inset-bottom)) !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    transform: translateY(1.2svh) !important;
  }

  .titleWrap {
    max-width: 305px !important;
  }

  .title {
    max-width: 305px !important;
    font-size: clamp(2rem, 8.2vw, 2.82rem) !important;
    line-height: .98 !important;
    letter-spacing: -.052em !important;
    margin-bottom: .75rem !important;
  }

  .subtitle {
    max-width: 305px !important;
    margin-top: .68rem !important;
    font-size: .86rem !important;
    line-height: 1.48 !important;
    font-weight: 750 !important;
  }

  .actions {
    max-width: 292px !important;
    gap: .64rem !important;
    margin-top: 1rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 46px !important;
    border-radius: 6px !important;
    font-size: .62rem !important;
    letter-spacing: .045em !important;
  }

  .commandBar {
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    max-width: 100vw !important;
    height: 72px !important;

    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;

    background: #fff !important;
    border-top: 1px solid rgba(0,0,0,.12) !important;
    border-left: 0 !important;
    border-right: 0 !important;
    border-bottom: 0 !important;
    border-radius: 0 !important;
    box-shadow: 0 -8px 24px rgba(0,0,0,.10) !important;
    overflow: hidden !important;
  }

  .commandItem {
    min-width: 0 !important;
    min-height: 72px !important;
    padding: 7px 2px 6px !important;

    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 5px !important;

    background: #fff !important;
    border-right: 1px solid rgba(0,0,0,.10) !important;
    color: #111 !important;
    text-align: center !important;
    overflow: hidden !important;
  }

  .commandItem:last-child {
    border-right: 0 !important;
  }

  .commandItem svg {
    width: 17px !important;
    height: 17px !important;
    flex: 0 0 17px !important;
    stroke: #111 !important;
  }

  .commandItem span {
    max-width: 100% !important;
    display: block !important;
    color: #111 !important;
    font-size: 9px !important;
    line-height: 1.05 !important;
    font-weight: 950 !important;
    letter-spacing: -.02em !important;
    white-space: normal !important;
    overflow: hidden !important;
  }

  .commandItem small {
    display: none !important;
  }
}

@media (max-width: 430px) {
  .content {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }

  .titleWrap,
  .title {
    max-width: 292px !important;
  }

  .title {
    font-size: clamp(1.86rem, 7.8vw, 2.48rem) !important;
  }

  .subtitle {
    max-width: 285px !important;
    font-size: .82rem !important;
  }

  .actions {
    max-width: 280px !important;
  }

  .commandItem span {
    font-size: 8.4px !important;
  }
}

@media (max-width: 380px) {
  .content {
    top: calc(70px + env(safe-area-inset-top)) !important;
    bottom: calc(70px + env(safe-area-inset-bottom)) !important;
    padding-left: 18px !important;
    padding-right: 18px !important;
    transform: translateY(.4svh) !important;
  }

  .titleWrap,
  .title {
    max-width: 270px !important;
  }

  .title {
    font-size: clamp(1.62rem, 7.3vw, 2.08rem) !important;
    margin-bottom: .52rem !important;
  }

  .subtitle {
    max-width: 265px !important;
    font-size: .76rem !important;
    line-height: 1.42 !important;
  }

  .actions {
    max-width: 265px !important;
    margin-top: .72rem !important;
    gap: .52rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 42px !important;
    font-size: .56rem !important;
  }

  .commandBar {
    height: 64px !important;
  }

  .commandItem {
    min-height: 64px !important;
    padding: 5px 1px !important;
  }

  .commandItem svg {
    width: 15px !important;
    height: 15px !important;
    flex-basis: 15px !important;
  }

  .commandItem span {
    font-size: 7.7px !important;
  }
}

/* =====================================================
   HERO VIDEO LIGHT RIGHT POLISH
   Más vida visual al video sin perder lectura del texto.
   Izquierda protegida / derecha con más luz y color.
   ===================================================== */

@media (max-width: 760px) {
  .video {
    filter: brightness(1.08) contrast(1.08) saturate(1.18) !important;
  }

  .overlay {
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 9, .78) 0%,
        rgba(5, 6, 9, .58) 34%,
        rgba(5, 6, 9, .28) 66%,
        rgba(5, 6, 9, .12) 100%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 9, .18) 0%,
        rgba(5, 6, 9, .26) 44%,
        rgba(5, 6, 9, .58) 100%
      ) !important;
  }

  .redGlow {
    opacity: .18 !important;
  }
}

@media (min-width: 761px) {
  .video {
    filter: brightness(1.03) contrast(1.05) saturate(1.12) !important;
  }

  .overlay {
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 9, .76) 0%,
        rgba(5, 6, 9, .54) 34%,
        rgba(5, 6, 9, .24) 68%,
        rgba(5, 6, 9, .10) 100%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 9, .12) 0%,
        rgba(5, 6, 9, .24) 48%,
        rgba(5, 6, 9, .48) 100%
      ) !important;
  }
}

/* =====================================================
   HERO MOBILE FINAL POLISH
   Más luz controlada + command bar consistente
   ===================================================== */

@media (max-width: 760px) {
  .video {
    filter: brightness(1.14) contrast(1.07) saturate(1.16) !important;
  }

  .overlay {
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 9, .70) 0%,
        rgba(5, 6, 9, .52) 34%,
        rgba(5, 6, 9, .25) 66%,
        rgba(5, 6, 9, .10) 100%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 9, .12) 0%,
        rgba(5, 6, 9, .20) 42%,
        rgba(5, 6, 9, .50) 100%
      ) !important;
  }

  .commandItem,
  .commandItem:first-child {
    background: #fff !important;
    color: #111 !important;
  }

  .commandItem::before,
  .commandItem::after,
  .commandItem:first-child::before,
  .commandItem:first-child::after {
    display: none !important;
    content: none !important;
  }

  .commandItem svg {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }
}

/* =====================================================
   HERO VIDEO RESPONSIVE FIT
   Nuevo video: avión / barco / camión / descarga.
   Ajusta recorte desktop y mobile.
   ===================================================== */

.video {
  object-fit: cover !important;
  object-position: center center !important;
}

/* Desktop: composición amplia, acción a la derecha, texto protegido */
@media (min-width: 761px) {
  .video {
    object-position: center center !important;
    transform: scale(1.01) !important;
  }

  .overlay {
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 9, .54) 0%,
        rgba(5, 6, 9, .40) 32%,
        rgba(5, 6, 9, .18) 62%,
        rgba(5, 6, 9, .05) 100%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 9, .08) 0%,
        rgba(5, 6, 9, .14) 52%,
        rgba(5, 6, 9, .32) 100%
      ) !important;
  }
}

/* Mobile: el viewport es angosto, empujamos el video hacia la derecha */
@media (max-width: 760px) {
  .hero {
    min-height: 100svh !important;
  }

  .video {
    object-position: 64% center !important;
    transform: scale(1.04) !important;
  }

  .overlay {
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 9, .62) 0%,
        rgba(5, 6, 9, .46) 38%,
        rgba(5, 6, 9, .22) 72%,
        rgba(5, 6, 9, .08) 100%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 9, .08) 0%,
        rgba(5, 6, 9, .18) 48%,
        rgba(5, 6, 9, .38) 100%
      ) !important;
  }
}

/* iPhone chico: menos zoom para que no se coma el video */
@media (max-width: 430px) {
  .video {
    object-position: 66% center !important;
    transform: scale(1.025) !important;
  }
}

@media (max-width: 380px) {
  .video {
    object-position: 68% center !important;
    transform: scale(1.015) !important;
  }
}

/* =====================================================
   HERO DESKTOP ZOOM OUT
   Aleja un poco el video en desktop para ver más escena.
   ===================================================== */

@media (min-width: 761px) {
  .video {
    object-fit: cover !important;
    object-position: center center !important;
    transform: scale(1) !important;
  }
}

@media (min-width: 1200px) {
  .video {
    object-position: center center !important;
    transform: scale(1) !important;
  }
}

@media (min-width: 1600px) {
  .video {
    object-position: center center !important;
    transform: scale(1) !important;
  }
}

/* =====================================================
   MOBILE HERO VIDEO LIGHT POLISH
   El video mobile ya está bien compuesto.
   Bajamos oscuridad para que se vea más blanco/corporativo.
   ===================================================== */

@media (max-width: 760px) {
  .mobileVideo {
    filter: brightness(1.16) contrast(1.03) saturate(1.06) !important;
    opacity: .96 !important;
    object-fit: cover !important;
    object-position: center center !important;
    transform: scale(1) !important;
  }

  .overlay {
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 9, .48) 0%,
        rgba(5, 6, 9, .34) 38%,
        rgba(5, 6, 9, .16) 72%,
        rgba(5, 6, 9, .06) 100%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 9, .05) 0%,
        rgba(5, 6, 9, .12) 45%,
        rgba(5, 6, 9, .30) 100%
      ) !important;
  }
}

/* =====================================================
   HERO BOTTOM MENU ELEGANT POLISH
   Menú inferior blanco, fino, estilo portal corporativo.
   ===================================================== */

@media (max-width: 760px) {
  .commandBar {
    left: 10px !important;
    right: 10px !important;
    bottom: calc(10px + env(safe-area-inset-bottom)) !important;
    width: auto !important;
    max-width: none !important;
    height: 70px !important;

    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;

    background: rgba(255,255,255,.94) !important;
    border: 1px solid rgba(17,17,17,.10) !important;
    border-radius: 18px !important;
    box-shadow:
      0 16px 38px rgba(0,0,0,.14),
      inset 0 1px 0 rgba(255,255,255,.86) !important;
    backdrop-filter: blur(16px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(16px) saturate(1.08) !important;

    overflow: hidden !important;
  }

  .commandItem {
    position: relative !important;
    min-width: 0 !important;
    min-height: 70px !important;
    padding: 8px 2px 7px !important;

    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 5px !important;

    background: transparent !important;
    border-right: 1px solid rgba(17,17,17,.08) !important;
    color: #111 !important;
    text-align: center !important;
    overflow: hidden !important;
  }

  .commandItem:last-child {
    border-right: 0 !important;
  }

  .commandItem::before,
  .commandItem::after,
  .commandItem:first-child::before,
  .commandItem:first-child::after {
    display: none !important;
    content: none !important;
  }

  .commandItem svg {
    width: 18px !important;
    height: 18px !important;
    flex: 0 0 18px !important;
    stroke: #111 !important;
    color: #111 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  .commandItem span {
    display: block !important;
    max-width: 100% !important;
    color: #111 !important;
    font-size: 9.4px !important;
    line-height: 1.05 !important;
    font-weight: 950 !important;
    letter-spacing: -.02em !important;
    white-space: normal !important;
  }

  .commandItem small {
    display: none !important;
  }

  .commandItem:hover,
  .commandItem:focus-visible {
    background: rgba(180,0,50,.055) !important;
  }

  .commandItem:hover svg,
  .commandItem:focus-visible svg,
  .commandItem:hover span,
  .commandItem:focus-visible span {
    color: #b40032 !important;
    stroke: #b40032 !important;
  }

  .commandItem[aria-current="page"],
  .commandItem.active,
  .commandItem[data-active="true"] {
    background: rgba(180,0,50,.08) !important;
  }

  .commandItem[aria-current="page"] svg,
  .commandItem.active svg,
  .commandItem[data-active="true"] svg,
  .commandItem[aria-current="page"] span,
  .commandItem.active span,
  .commandItem[data-active="true"] span {
    color: #b40032 !important;
    stroke: #b40032 !important;
  }
}

@media (max-width: 390px) {
  .commandBar {
    left: 8px !important;
    right: 8px !important;
    height: 66px !important;
    border-radius: 16px !important;
  }

  .commandItem {
    min-height: 66px !important;
    padding: 7px 1px 6px !important;
  }

  .commandItem svg {
    width: 16px !important;
    height: 16px !important;
    flex-basis: 16px !important;
  }

  .commandItem span {
    font-size: 8.4px !important;
  }
}

/* =====================================================
   HERO MOBILE TEXT SPACING POLISH
   Más aire entre título, bajada y botones.
   ===================================================== */

@media (max-width: 760px) {
  .content {
    gap: 0 !important;
  }

  .titleWrap {
    margin-bottom: 0 !important;
  }

  .title {
    margin-bottom: 1.05rem !important;
    line-height: 1.02 !important;
  }

  .subtitle {
    margin-top: 0 !important;
    margin-bottom: 1.55rem !important;
    line-height: 1.58 !important;
    max-width: 315px !important;
  }

  .actions {
    margin-top: 0 !important;
    gap: .78rem !important;
    max-width: 305px !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 48px !important;
  }
}

@media (max-width: 430px) {
  .title {
    margin-bottom: .95rem !important;
  }

  .subtitle {
    margin-bottom: 1.35rem !important;
    line-height: 1.55 !important;
  }

  .actions {
    gap: .72rem !important;
  }
}

@media (max-width: 380px) {
  .title {
    margin-bottom: .82rem !important;
  }

  .subtitle {
    margin-bottom: 1.15rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 44px !important;
  }
}

/* =====================================================
   HERO CTA FINAL PREMIUM STYLE
   Botones con presencia, sombras, hover y mejor espaciado.
   ===================================================== */

.actions {
  gap: .95rem !important;
}

.primaryBtn,
.secondaryBtn {
  position: relative !important;
  isolation: isolate !important;
  overflow: hidden !important;

  min-height: 54px !important;
  padding: 0 1.45rem !important;

  border-radius: 999px !important;
  text-transform: uppercase !important;
  text-decoration: none !important;
  text-align: center !important;

  font-size: .76rem !important;
  font-weight: 950 !important;
  letter-spacing: .07em !important;
  line-height: 1.12 !important;

  transform: translateZ(0) !important;
  transition:
    transform .22s ease,
    box-shadow .22s ease,
    border-color .22s ease,
    background .22s ease,
    color .22s ease !important;
}

.primaryBtn::before,
.secondaryBtn::before {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  z-index: -1 !important;
  opacity: 0 !important;
  transition: opacity .22s ease !important;
}

.primaryBtn {
  color: #fff !important;
  background:
    linear-gradient(135deg, #8f0028 0%, #b40032 38%, #ed1b2f 100%) !important;
  border: 1px solid rgba(255,255,255,.20) !important;
  box-shadow:
    0 18px 42px rgba(180,0,50,.34),
    0 8px 18px rgba(0,0,0,.18),
    inset 0 1px 0 rgba(255,255,255,.20) !important;
}

.primaryBtn::before {
  background:
    linear-gradient(135deg, #ed1b2f 0%, #b40032 52%, #7e0023 100%) !important;
}

.secondaryBtn {
  color: #111 !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,.98), rgba(245,245,245,.92)) !important;
  border: 1px solid rgba(17,17,17,.16) !important;
  box-shadow:
    0 16px 36px rgba(0,0,0,.16),
    inset 0 1px 0 rgba(255,255,255,.95) !important;
}

.secondaryBtn::before {
  background:
    linear-gradient(180deg, #ffffff, #f1f1f1) !important;
}

.primaryBtn:hover,
.secondaryBtn:hover {
  transform: translateY(-2px) !important;
}

.primaryBtn:hover::before,
.secondaryBtn:hover::before {
  opacity: 1 !important;
}

.primaryBtn:hover {
  box-shadow:
    0 22px 52px rgba(180,0,50,.40),
    0 10px 24px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.22) !important;
}

.secondaryBtn:hover {
  border-color: rgba(180,0,50,.26) !important;
  box-shadow:
    0 20px 44px rgba(0,0,0,.18),
    inset 0 1px 0 rgba(255,255,255,1) !important;
}

.primaryBtn:active,
.secondaryBtn:active {
  transform: translateY(1px) scale(.99) !important;
}

/* Mobile: botones grandes, elegantes y respirados */
@media (max-width: 760px) {
  .title {
    margin-bottom: 1.05rem !important;
  }

  .subtitle {
    margin-bottom: 1.65rem !important;
    line-height: 1.62 !important;
  }

  .actions {
    max-width: 315px !important;
    gap: .86rem !important;
    margin-top: 0 !important;
  }

  .primaryBtn,
  .secondaryBtn {
    width: 100% !important;
    min-height: 50px !important;
    padding: 0 1.15rem !important;
    font-size: .66rem !important;
    letter-spacing: .062em !important;
  }
}

@media (max-width: 390px) {
  .actions {
    max-width: 292px !important;
    gap: .72rem !important;
  }

  .primaryBtn,
  .secondaryBtn {
    min-height: 46px !important;
    font-size: .60rem !important;
    letter-spacing: .052em !important;
  }
}

/* =====================================================
   HERO BOTTOM ACCESS FINAL PREMIUM
   Barra inferior elegante tipo app corporativa.
   ===================================================== */

@media (max-width: 760px) {
  .commandBar {
    background:
      linear-gradient(180deg, rgba(255,255,255,.98), rgba(245,245,245,.94)) !important;
    border: 1px solid rgba(17,17,17,.12) !important;
    border-radius: 22px !important;
    box-shadow:
      0 18px 44px rgba(0,0,0,.16),
      inset 0 1px 0 rgba(255,255,255,.95) !important;
  }

  .commandItem {
    background: transparent !important;
    border-right: 1px solid rgba(17,17,17,.08) !important;
  }

  .commandItem svg {
    stroke: #b40032 !important;
    width: 19px !important;
    height: 19px !important;
  }

  .commandItem span {
    color: #111 !important;
    font-weight: 950 !important;
  }

  .commandItem:hover,
  .commandItem:focus-visible {
    background: rgba(180,0,50,.06) !important;
  }
}

