/* =====================================================
   HERO CTA PREMIUM RUBY
   Rojo más elegante, oscuro y corporativo.
   ===================================================== */

.primaryBtn {
  color: #fff !important;
  background:
    radial-gradient(circle at 18% 0%, rgba(255,255,255,.22), transparent 28%),
    linear-gradient(135deg, #6f001d 0%, #98002b 42%, #c20b38 100%) !important;

  border: 1px solid rgba(255,255,255,.22) !important;

  box-shadow:
    0 18px 42px rgba(112, 0, 30, .34),
    0 8px 18px rgba(0, 0, 0, .18),
    inset 0 1px 0 rgba(255,255,255,.24),
    inset 0 -10px 22px rgba(50,0,15,.18) !important;
}

.primaryBtn::before {
  background:
    radial-gradient(circle at 18% 0%, rgba(255,255,255,.28), transparent 30%),
    linear-gradient(135deg, #820024 0%, #b40032 50%, #d71943 100%) !important;
}

.primaryBtn:hover {
  box-shadow:
    0 22px 54px rgba(112, 0, 30, .42),
    0 10px 24px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.26),
    inset 0 -10px 22px rgba(50,0,15,.16) !important;
}

/* Mobile: más fino y premium */
@media (max-width: 760px) {
  .primaryBtn {
    max-width: 286px !important;
    min-height: 45px !important;
    font-size: .58rem !important;
    letter-spacing: .065em !important;

    background:
      radial-gradient(circle at 18% 0%, rgba(255,255,255,.22), transparent 28%),
      linear-gradient(135deg, #65001b 0%, #930028 46%, #bd0a35 100%) !important;

    box-shadow:
      0 16px 34px rgba(95,0,28,.34),
      0 7px 16px rgba(0,0,0,.17),
      inset 0 1px 0 rgba(255,255,255,.24),
      inset 0 -9px 18px rgba(50,0,15,.18) !important;
  }
}

