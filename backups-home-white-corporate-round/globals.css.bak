/* Header contact button alignment fix */
header a[href="/contacto"],
header a[href="/contact"],
nav a[href="/contacto"],
nav a[href="/contact"] {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  text-align: center !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

/* Cookie banner: force a real decision, no visual escape */
[class*="cookie"] button[aria-label*="close" i],
[class*="cookie"] button[aria-label*="cerrar" i],
[class*="cookie"] .close,
[class*="cookie"] .Close,
[class*="cookie"] [class*="close"],
[class*="cookie"] [class*="Close"] {
  display: none !important;
  pointer-events: none !important;
}

[class*="cookie"] a,
[class*="Cookie"] a {
  text-decoration: underline !important;
  text-underline-offset: 3px !important;
}

[class*="cookie"] button,
[class*="Cookie"] button {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
}

/* Brand red for cookie buttons */
[class*="cookie"] button,
[class*="Cookie"] button {
  background: #e11343f2 !important;
  border-color: #e11343f2 !important;
  color: #fff !important;
}

/* === HERO CTA ABOVE OVERLAYS === */
[class*="heroContent"],
[class*="Hero_heroContent"],
[class*="heroInner"] {
  position: relative;
  z-index: 5;
}

[class*="heroContent"] a,
[class*="heroContent"] button,
[class*="Hero_heroContent"] a,
[class*="Hero_heroContent"] button,
[class*="actions"] a,
[class*="actions"] button {
  position: relative;
  z-index: 6;
}

[class*="heroOverlay"],
[class*="overlay"],
[class*="redGlow"] {
  pointer-events: none;
}

/* === FLOATING CALL BUTTON FINAL POSITION === */
@media (max-width: 1100px) {
  [class*="FloatingCallButton_floating"] {
    right: clamp(.75rem, 2.4vw, 1.2rem) !important;
    bottom: calc(7rem + env(safe-area-inset-bottom)) !important;
    z-index: 5200 !important;
  }

  [class*="FloatingCallButton_chatBubble"] {
    right: 0 !important;
    bottom: calc(100% + .42rem) !important;
    z-index: 5201 !important;
  }

  [class*="FloatingCallButton_callPill"] {
    z-index: 5201 !important;
  }
}

@media (max-width: 760px) {
  [class*="FloatingCallButton_floating"] {
    right: .72rem !important;
    bottom: calc(7.15rem + env(safe-area-inset-bottom)) !important;
  }
}

@media (max-width: 760px) and (max-height: 720px) {
  [class*="FloatingCallButton_floating"] {
    right: .58rem !important;
    bottom: calc(5.75rem + env(safe-area-inset-bottom)) !important;
  }
}

@media (max-width: 1100px) {
  body:has([class*="mobilePanelVisible"]) [class*="FloatingCallButton_floating"] {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(16px) scale(.96) !important;
  }
}


/* =====================================================
   IPHONE SE / SMALL MOBILE — OMIT FLOATING CALL BUTTON
   No se elimina del proyecto. Solo se oculta en pantallas
   pequeñas donde compite con CTAs y barra inferior.
   ===================================================== */

@media (max-width: 430px), (max-height: 760px) {
  [class*="FloatingCallButton_floating"],
  [class*="FloatingCallButton_callPill"],
  [class*="FloatingCallButton_callButton"],
  [class*="FloatingCallButton_chatBubble"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* FORCE MOBILE — OMIT FLOATING CALL BUTTON */
@media (max-width: 760px) {
  [class*="FloatingCallButton_floating"],
  [class*="FloatingCallButton_callPill"],
  [class*="FloatingCallButton_callButton"],
  [class*="FloatingCallButton_chatBubble"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* FORCE MOBILE — FLOATING CALL BUTTON OFF */
@media (max-width: 760px) {
  [class*="FloatingCallButton"],
  [class*="FloatingCallButton_floating"],
  [class*="FloatingCallButton_callPill"],
  [class*="FloatingCallButton_callButton"],
  [class*="FloatingCallButton_chatBubble"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* =====================================================
   MOBILE CORPORATE BACKGROUND — MAERSK STYLE ROUND
   ===================================================== */

@media (max-width: 760px) {
  html,
  body {
    background: #f7f5f0 !important;
  }
}
