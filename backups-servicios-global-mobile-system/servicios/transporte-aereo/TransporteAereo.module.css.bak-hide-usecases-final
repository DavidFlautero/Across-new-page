  margin-top: 0 !important;
  padding-top: 4.8rem !important;
  background: #f4f1eb !important;
}

/* El bloque oscuro no debe ser azul: negro marca */
.darkBand {
  background: #050609 !important;
}

.darkBandContent {
  background:
    radial-gradient(circle at 78% 18%, rgba(237, 27, 47, .12), transparent 24rem),
    #050609 !important;
}

.darkBandContent h2 {
  color: #fff !important;
}

.darkBandContent p {
  color: rgba(255,255,255,.76) !important;
}

/* CTA final: que no parezca cortado raro, más premium */
.finalCta {
  background: #f4f1eb !important;
}

.finalCta > div:first-child {
  background: #f4f1eb !important;
}

/* Related services después: separación limpia */
.related,
.relatedGrid {
  background: #f4f1eb !important;
}

