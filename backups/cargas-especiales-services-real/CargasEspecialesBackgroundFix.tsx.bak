"use client";

import { useEffect } from "react";

export default function CargasEspecialesBackgroundFix() {
  useEffect(() => {
    const testImage = (url: string): Promise<string | null> =>
      new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve(url);
        img.onerror = () => resolve(null);
        img.src = `${url}?v=${Date.now()}`;
      });

    const findImage = async (base: string): Promise<string | null> => {
      const exts = [".png", ".jpg", ".jpeg", ".webp"];

      for (const ext of exts) {
        const ok = await testImage(base + ext);
        if (ok) return base + ext;
      }

      return null;
    };

    const applyBackground = async () => {
      const desktopImg = await findImage("/images/transporte-especial/especial1");
      const mobileImg = await findImage("/images/transporte-especial-mobile/especial");

      if (!desktopImg || !mobileImg) return;

      const section = [...document.querySelectorAll("section")].find((sec) => {
        const txt = (sec.textContent || "").toLowerCase();

        return (
          txt.includes("nuestros servicios especiales") ||
          txt.includes("soluciones diseñadas para cargas") ||
          txt.includes("carga sobredimensionada") ||
          txt.includes("proyectos especiales")
        );
      }) as HTMLElement | undefined;

      if (!section) return;

      section.setAttribute("data-cargas-especiales-bg", "true");

      section.style.setProperty(
        "background-image",
        `
          linear-gradient(90deg, rgba(5,12,20,.62) 0%, rgba(5,12,20,.38) 42%, rgba(5,12,20,.14) 100%),
          url("${desktopImg}")
        `,
        "important"
      );

      section.style.setProperty("background-size", "cover", "important");
      section.style.setProperty("background-position", "center center", "important");
      section.style.setProperty("background-repeat", "no-repeat", "important");
      section.style.setProperty("background-color", "transparent", "important");

      let style = document.querySelector("#cargas-especiales-bg-runtime") as HTMLStyleElement | null;

      if (!style) {
        style = document.createElement("style");
        style.id = "cargas-especiales-bg-runtime";
        document.head.appendChild(style);
      }

      style.textContent = `
        [data-cargas-especiales-bg="true"] {
          background-image:
            linear-gradient(90deg, rgba(5,12,20,.62) 0%, rgba(5,12,20,.38) 42%, rgba(5,12,20,.14) 100%),
            url("${desktopImg}") !important;
          background-size: cover !important;
          background-position: center center !important;
          background-repeat: no-repeat !important;
          background-color: transparent !important;
        }

        [data-cargas-especiales-bg="true"]::before {
          background:
            linear-gradient(90deg, rgba(5,12,20,.50) 0%, rgba(5,12,20,.22) 48%, rgba(5,12,20,.08) 100%) !important;
          opacity: 1 !important;
        }

        [data-cargas-especiales-bg="true"]::after {
          opacity: 0 !important;
          background: transparent !important;
        }

        @media (max-width: 900px) {
          [data-cargas-especiales-bg="true"] {
            background-image:
              linear-gradient(180deg, rgba(5,12,20,.55) 0%, rgba(5,12,20,.24) 45%, rgba(5,12,20,.58) 100%),
              url("${mobileImg}") !important;
            background-size: cover !important;
            background-position: center center !important;
            background-repeat: no-repeat !important;
          }
        }
      `;
    };

    applyBackground();

    const timers = [
      window.setTimeout(applyBackground, 250),
      window.setTimeout(applyBackground, 800),
      window.setTimeout(applyBackground, 1600),
    ];

    const observer = new MutationObserver(() => {
      applyBackground();
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });

    window.addEventListener("across-locale-change", applyBackground);

    return () => {
      timers.forEach((timer) => window.clearTimeout(timer));
      observer.disconnect();
      window.removeEventListener("across-locale-change", applyBackground);
    };
  }, []);

  return null;
}
