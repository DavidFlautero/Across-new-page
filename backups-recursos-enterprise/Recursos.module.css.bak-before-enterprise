@media (max-width: 430px) {
  .hero {
    padding: 5.35rem 20px 6.1rem !important;
  }

  .heroContent {
    transform: translateY(3.6vh) !important;
  }

  .heroContent span {
    margin-bottom: .82rem !important;
    font-size: .64rem !important;
  }

  .heroContent h1 {
    font-size: clamp(2.08rem, 10.5vw, 2.9rem) !important;
    line-height: .92 !important;
  }

  .heroContent p {
    margin-top: 1.35rem !important;
    font-size: .86rem !important;
