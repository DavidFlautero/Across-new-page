.wrapper {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 1000;
  padding: 1.2rem 2rem;
  pointer-events: none;
}

.header {
  pointer-events: auto;
  max-width: 1540px;
  margin: 0 auto;
  height: 68px;
  display: flex;
  align-items: center;
  gap: 1.15rem;
  padding: 0 1.55rem;
  border-radius: 999px;
  position: relative;

  background:
    linear-gradient(180deg, rgba(8, 9, 14, .50), rgba(5, 5, 10, .38));

  border: 1px solid rgba(255,255,255,.13);

  backdrop-filter: blur(34px) saturate(1.22);
  -webkit-backdrop-filter: blur(34px) saturate(1.22);

  box-shadow:
    0 18px 52px rgba(0,0,0,.24),
    inset 0 1px 0 rgba(255,255,255,.14),
    inset 0 -1px 0 rgba(255,255,255,.035);
}




.header::after {
  content: "";
  position: absolute;
  left: 22%;
  right: 22%;
  bottom: -1px;
  height: 1px;
  border-radius: 999px;
  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(225, 19, 67, .08) 20%,
      rgba(225, 19, 67, .42) 50%,
      rgba(225, 19, 67, .08) 80%,
      transparent 100%
    );
  box-shadow:
    0 0 8px rgba(225,19,67,.22),
    0 0 22px rgba(225,19,67,.10);
  pointer-events: none;
}

.logo {
  display: flex;
  flex: 0 0 auto;
}

.logo img {
  width: 176px;
  height: auto;
}

.nav {
  display: flex;
  align-items: center;
  gap: 2.45rem;
  margin-left: auto;
}

.nav a,
.dropdownTrigger {
  color: rgba(255,255,255,.78);
  text-decoration: none;
  background: transparent;
  border: 0;
  cursor: pointer;
  font-size: .78rem;
  font-weight: 450;
  letter-spacing: .045em;
  white-space: nowrap;
  transition: color .22s ease, opacity .22s ease, background .22s ease;
}

.nav a:hover,
.dropdownTrigger:hover {
  color: #fff;
  background: rgba(255,255,255,.035);
}

.divider {
  width: 1px;
  height: 26px;
  background: rgba(255,255,255,.14);
}

.dropdown {
  position: relative;
}

.dropdownTrigger {
  display: flex;
  align-items: center;
  gap: .4rem;
}

.dropdownMenu {
  position: absolute;
  top: calc(100% + 1.05rem);
  left: 50%;
  transform: translateX(-50%) translateY(12px);
  width: 330px;
  padding: .72rem;
  border-radius: 22px;
  opacity: 0;
  visibility: hidden;
  transition: .25s ease;
  backdrop-filter: blur(34px) saturate(1.2);
  -webkit-backdrop-filter: blur(34px) saturate(1.2);
  background: rgba(7,8,13,.72);
  border: 1px solid rgba(255,255,255,.11);
  box-shadow:
    0 22px 70px rgba(0,0,0,.34),
    inset 0 1px 0 rgba(255,255,255,.10);
}

.dropdownVisible {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.dropdownMenu a {
  display: flex;
  align-items: center;
  min-height: 46px;
  padding: 0 .95rem;
  border-radius: 13px;
  border-bottom: 1px solid rgba(255,255,255,.055);
  font-size: .8rem;
  font-weight: 430;
  letter-spacing: .025em;
}

.dropdownMenu a:last-child {
  border-bottom: 0;
}

.dropdownMenu a:hover {
  background: rgba(255,255,255,.045);
}

.language {
  display: flex;
  align-items: center;
  gap: .35rem;
  padding-left: .9rem;
  border-left: 1px solid rgba(255,255,255,.09);
}

.language button {
  width: 34px;
  min-width: 34px;
  height: 34px;
  padding: 0;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.035);
  color: rgba(255,255,255,.78);
  cursor: pointer;
  display: grid;
  place-items: center;
}

.languageActive {
  background: rgba(255,255,255,.11) !important;
  color: white !important;
}

.mobileButton,
.mobileLang,
.mobileBackdrop,
.mobilePanel {
  display: none;
}

@media (max-width: 1100px) {
  .wrapper {
    padding: .9rem 1rem;
  }

  .header {
    height: 74px;
    padding: 0 .75rem 0 .9rem;
    gap: .55rem;
  }

  .logo img {
    width: 170px;
  }

  .nav,
  .language {
    display: none;
  }

  .mobileLang {
    display: flex;
    align-items: center;
    gap: .35rem;
    margin-left: auto;
  }

  .mobileLang button {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.06);
    color: white;
    cursor: pointer;
    font-size: .72rem;
  }

  .mobileButton {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 17px;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(135deg, rgba(20,20,26,.95), rgba(10,10,14,.88));
    color: white;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .mobileBackdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: rgba(0,0,0,.48);
    backdrop-filter: blur(8px);
    transition: .25s ease;
  }

  .mobileBackdropVisible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobilePanel {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1002;
    width: min(360px, 86vw);
    height: 100vh;
    padding: 1.4rem;
    transform: translateX(-105%);
    transition: transform .32s ease;
    border-left: 1px solid rgba(255,255,255,.12);
    background:
      radial-gradient(circle at 85% 10%, rgba(190,18,50,.24), transparent 18rem),
      linear-gradient(145deg, rgba(10,10,15,.88), rgba(6,7,10,.78));
    backdrop-filter: blur(26px) saturate(1.2);
    box-shadow: -30px 0 80px rgba(0,0,0,.42);
  }

  .mobilePanelVisible {
    transform: translateX(0);
  }

  .closeButton {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.06);
    color: white;
    font-size: 1.7rem;
    cursor: pointer;
  }

  .mobileLogo {
    width: 185px;
    height: auto;
    margin-bottom: 2rem;
  }

  .mobileLinks {
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }

  .mobileLinks a {
    min-height: 54px;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    border-radius: 18px;
    color: rgba(255,255,255,.92);
    text-decoration: none;
    font-weight: 800;
    background: rgba(255,255,255,.045);
    border: 1px solid rgba(255,255,255,.07);
  }

  .mobileLinks a:hover {
    background: linear-gradient(90deg, rgba(210,12,52,.28), rgba(255,255,255,.06));
  }
}

@media (max-width: 430px) {
  .wrapper {
    padding: .8rem .85rem;
  }

  .header {
    height: 66px;
    border-radius: 34px;
  }

  .logo img {
    width: 145px;
  }

  .mobileLang button {
    width: 28px;
    height: 28px;
    font-size: .62rem;
  }

  .mobileButton {
    width: 48px;
    height: 48px;
  }
}

/* === MOBILE REAL SCALE FIX === */
@media (max-width: 640px) {
  .wrapper {
    padding: 10px 12px !important;
  }

  .header {
    height: 58px !important;
    padding: 0 8px 0 10px !important;
    border-radius: 30px !important;
    gap: 6px !important;
  }

  .logo img {
    width: 132px !important;
  }

  .mobileLang {
    gap: 3px !important;
  }

  .mobileLang button {
    width: 24px !important;
    height: 24px !important;
    font-size: 10px !important;
  }

  .mobileButton {
    width: 42px !important;
    height: 42px !important;
    border-radius: 14px !important;
    font-size: 1.1rem !important;
  }
}

@media (max-width: 380px) {
  .logo img {
    width: 120px !important;
  }

  .mobileLang button {
    width: 22px !important;
    height: 22px !important;
  }

  .mobileButton {
    width: 40px !important;
    height: 40px !important;
  }
}

