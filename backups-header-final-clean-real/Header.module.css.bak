/* FINAL MINIMAL FLAGS + CTA */
.language button svg,
.mobileLang button svg {
  width: 19px;
  height: 19px;
  display: block;
  border-radius: 999px;
}

.nav > a:last-child {
  min-height: 40px;
  padding: 0 1.05rem;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(183,0,48,.95), rgba(225,19,67,.95));
  color: #fff !important;
  font-weight: 620;
  letter-spacing: .015em;
  box-shadow:
    0 10px 26px rgba(225,19,67,.20),
    inset 0 1px 0 rgba(255,255,255,.14);
  transform: translateY(1px);
}

.nav > a:last-child:hover {
  background: linear-gradient(135deg, rgba(195,0,52,1), rgba(235,32,78,1));
}

/* MICRO FIX: glass depth, red glow, lighter menu type */

.header {
  background:
    linear-gradient(180deg, rgba(7,8,13,.64), rgba(4,5,10,.46)) !important;

  backdrop-filter: blur(42px) saturate(1.42) contrast(1.04) !important;
  -webkit-backdrop-filter: blur(42px) saturate(1.42) contrast(1.04) !important;

  box-shadow:
    0 24px 70px rgba(0,0,0,.34),
    0 6px 22px rgba(0,0,0,.18),
    inset 0 1px 0 rgba(255,255,255,.16),
    inset 0 -1px 0 rgba(255,255,255,.04) !important;
}

.header::after {
  height: 1px !important;
  left: 28% !important;
  right: 28% !important;
  bottom: -1px !important;

  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(225,19,67,.06) 20%,
      rgba(255,58,96,.46) 50%,
      rgba(225,19,67,.06) 80%,
      transparent 100%
    ) !important;

  box-shadow:
    0 0 7px rgba(255,58,96,.32),
    0 0 18px rgba(255,58,96,.14),
    0 0 36px rgba(255,58,96,.06) !important;
}

.nav a,
.dropdownTrigger {
  font-weight: 400 !important;
  letter-spacing: .055em !important;
  color: rgba(255,255,255,.76) !important;
}

.nav > a:nth-child(1),
.nav > a:nth-child(2) {
  font-weight: 520 !important;
}

/* FINAL MICRO REFINEMENT */

.header {
  background:
    linear-gradient(180deg, rgba(9,10,16,.72), rgba(4,5,10,.52)) !important;

  border-color: rgba(255,255,255,.18) !important;

  backdrop-filter: blur(48px) saturate(1.55) brightness(1.06) !important;
  -webkit-backdrop-filter: blur(48px) saturate(1.55) brightness(1.06) !important;

  box-shadow:
    0 30px 90px rgba(0,0,0,.38),
    inset 0 1px 0 rgba(255,255,255,.20),
    inset 0 -1px 0 rgba(255,255,255,.05) !important;
}

.header::after {
  height: .5px !important;
  left: 32% !important;
  right: 32% !important;

  background: rgba(255,58,96,.42) !important;

  box-shadow:
    0 0 5px rgba(255,58,96,.34),
    0 0 16px rgba(255,58,96,.16),
    0 0 34px rgba(255,58,96,.08) !important;
}

.nav a,
.dropdownTrigger {
  font-weight: 360 !important;
  letter-spacing: .065em !important;
  color: rgba(255,255,255,.72) !important;
}

.nav a:hover,
.dropdownTrigger:hover {
  color: rgba(255,255,255,.96) !important;
}

/* FINAL PREMIUM POLISH */

.header {
  background:
    linear-gradient(
      180deg,
      rgba(9,10,16,.62),
      rgba(4,5,10,.40)
    ) !important;
}

.header::after {
  opacity: .55 !important;
  height: .5px !important;

  left: 36% !important;
  right: 36% !important;
}

.nav a,
.dropdownTrigger {
  line-height: 1 !important;
}

/* ULTRA FINAL REFINEMENT */

.header {
  height: 64px !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

.header::after {
  opacity: .38 !important;

  box-shadow:
    0 0 4px rgba(255,58,96,.18),
    0 0 12px rgba(255,58,96,.08) !important;
}

.nav a,
.dropdownTrigger {
  font-size: .76rem !important;
  letter-spacing: .07em !important;
}

.language button {
  width: 32px !important;
  height: 32px !important;
}

/* RED GLOW RESTORE */

.header::after {
  opacity: .62 !important;

  left: 31% !important;
  right: 31% !important;

  height: 1px !important;

  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(255,58,96,.08) 18%,
      rgba(255,58,96,.72) 50%,
      rgba(255,58,96,.08) 82%,
      transparent 100%
    ) !important;

  box-shadow:
    0 0 6px rgba(255,58,96,.26),
    0 0 18px rgba(255,58,96,.12),
    0 0 34px rgba(255,58,96,.05) !important;
}

/* === FINAL MOBILE / TABLET DRAWER FIX === */
@media (max-width: 1100px) {
  .mobileBackdrop {
    display: block !important;
    position: fixed !important;
    inset: 0 !important;
    z-index: 3000 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    background:
      radial-gradient(circle at 82% 12%, rgba(225, 19, 67, 0.16), transparent 22rem),
      rgba(2, 3, 7, 0.74) !important;
    backdrop-filter: blur(16px) saturate(1.1) !important;
    -webkit-backdrop-filter: blur(16px) saturate(1.1) !important;
    transition: opacity 0.25s ease, visibility 0.25s ease !important;
  }

  .mobileBackdropVisible {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .mobilePanel {
    pointer-events: auto !important;
    display: flex !important;
    flex-direction: column !important;
    position: fixed !important;
    inset: 0 auto 0 0 !important;
    z-index: 3001 !important;
    width: min(520px, 100vw) !important;
    max-width: 100vw !important;
    height: 100dvh !important;
    padding: max(1.15rem, env(safe-area-inset-top)) 1.15rem 1.15rem !important;
    overflow-y: auto !important;
    overscroll-behavior: contain !important;
    transform: translateX(-105%) !important;
    transition: transform 0.32s cubic-bezier(.22, .85, .24, 1) !important;
    border: 0 !important;
    border-right: 1px solid rgba(255,255,255,.12) !important;
    background:
      radial-gradient(circle at 86% 8%, rgba(225, 19, 67, .22), transparent 19rem),
      radial-gradient(circle at 8% 92%, rgba(255,255,255,.05), transparent 18rem),
      linear-gradient(145deg, rgba(9,10,15,.98), rgba(14,15,20,.96)) !important;
    backdrop-filter: blur(28px) saturate(1.15) !important;
    -webkit-backdrop-filter: blur(28px) saturate(1.15) !important;
    box-shadow: 28px 0 90px rgba(0,0,0,.55) !important;
  }

  .mobilePanelVisible {
    transform: translateX(0) !important;
  }

  .closeButton {
    position: absolute !important;
    top: max(1rem, env(safe-area-inset-top)) !important;
    right: 1rem !important;
    width: 52px !important;
    height: 52px !important;
    border-radius: 999px !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    background: rgba(255,255,255,.07) !important;
    color: #fff !important;
    font-size: 2rem !important;
    line-height: 1 !important;
    display: grid !important;
    place-items: center !important;
    cursor: pointer !important;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.11) !important;
  }

  .mobileLogo {
    width: min(240px, 68vw) !important;
    height: auto !important;
    margin: 0 0 2rem !important;
    padding-right: 4.2rem !important;
  }

  .mobileLinks {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    gap: .72rem !important;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom)) !important;
  }

  .mobileLinks a,
  .mobileLinks button,
  .mobileSubmenu a,
  .mobileBack {
    width: 100% !important;
    min-height: 62px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 1rem !important;
    padding: 0 1.2rem !important;
    border-radius: 22px !important;
    border: 1px solid rgba(255,255,255,.105) !important;
    background:
      linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.035)) !important;
    color: rgba(255,255,255,.93) !important;
    text-decoration: none !important;
    font: inherit !important;
    font-size: clamp(.98rem, 3.8vw, 1.12rem) !important;
    font-weight: 850 !important;
    letter-spacing: .035em !important;
    text-align: left !important;
    cursor: pointer !important;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.08),
      0 10px 28px rgba(0,0,0,.16) !important;
  }

  .mobileLinks button span {
    color: #e11343f2 !important;
    font-size: 1.45rem !important;
    line-height: 1 !important;
  }

  .mobileLinks a[href="/contacto"] {
    justify-content: center !important;
    margin-top: .5rem !important;
    color: #fff !important;
    background: linear-gradient(135deg, #9d0b28, #e11343f2) !important;
    border-color: rgba(225,19,67,.42) !important;
    box-shadow: 0 18px 48px rgba(225,19,67,.24) !important;
  }

  .mobileSubmenu {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    gap: .62rem !important;
    animation: mobileSubmenuIn .22s ease both !important;
  }

  .mobileBack {
    justify-content: flex-start !important;
    min-height: 54px !important;
    color: #fff !important;
    background:
      linear-gradient(90deg, rgba(225,19,67,.24), rgba(255,255,255,.045)) !important;
    border-color: rgba(225,19,67,.28) !important;
  }

  .mobileSubmenu a {
    min-height: 56px !important;
    font-size: clamp(.88rem, 3.5vw, 1rem) !important;
    font-weight: 760 !important;
    letter-spacing: .02em !important;
  }

  @keyframes mobileSubmenuIn {
    from {
      opacity: 0;
      transform: translateX(14px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
}

@media (max-width: 640px) {
  .mobilePanel {
    width: 100vw !important;
    padding-inline: 1.05rem !important;
  }

  .mobileLogo {
    width: min(230px, 72vw) !important;
    margin-bottom: 2.1rem !important;
  }

  .mobileLinks a,
  .mobileLinks button,
  .mobileSubmenu a,
  .mobileBack {
    min-height: 60px !important;
    border-radius: 20px !important;
  }
}

@media (max-width: 380px) {
  .mobilePanel {
    padding-inline: .85rem !important;
  }

  .closeButton {
    width: 46px !important;
    height: 46px !important;
  }

  .mobileLogo {
    width: min(205px, 70vw) !important;
  }

  .mobileLinks a,
  .mobileLinks button,
  .mobileSubmenu a,
  .mobileBack {
    min-height: 56px !important;
    padding-inline: 1rem !important;
  }
}

/* Hide floating widgets behind the open mobile menu */
@media (max-width: 1100px) {
  body:has(.mobilePanelVisible) [class*="floating"],
  body:has(.mobilePanelVisible) [class*="Floating"],
  body:has(.mobilePanelVisible) [class*="chatBubble"],
  body:has(.mobilePanelVisible) [class*="callPill"] {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* === HEADER FULL WIDTH + FLOATING BUTTON SAFE AREA === */
.wrapper {
  z-index: 2500 !important;
  padding-inline: clamp(0.75rem, 2vw, 2rem) !important;
}

.header {
  width: 100% !important;
  max-width: none !important;
}

/* Desktop: el menú negro llega casi de lado a lado, pero reserva espacio si el botón flotante está en la derecha */
@media (min-width: 1101px) {
  .wrapper {
    padding-right: 8.6rem !important;
  }

  .header {
    max-width: none !important;
  }
}

/* Pantallas grandes: más aire, pero sigue full premium */
@media (min-width: 1500px) {
  .wrapper {
    padding-left: 2rem !important;
    padding-right: 9.5rem !important;
  }
}

/* Tablet/mobile: menú limpio, sin reservar espacio al botón flotante */
@media (max-width: 1100px) {
  .wrapper {
    padding-right: 1rem !important;
  }

  .header {
    max-width: calc(100vw - 2rem) !important;
  }
}

/* Cuando el menú mobile está abierto, el drawer manda por encima de todo */
.mobileBackdrop {
  z-index: 5000 !important;
}

.mobilePanel {
  z-index: 5001 !important;
}

/* === FINAL OVERRIDE: MOBILE HEADER FULL WIDTH === */
@media (max-width: 1100px) {
  .wrapper {
    inset: 0 0 auto 0 !important;
    width: 100vw !important;
    max-width: 100vw !important;
    padding: 0 !important;
    z-index: 2600 !important;
  }

  .header {
    width: 100vw !important;
    max-width: 100vw !important;
    height: 64px !important;
    margin: 0 !important;
    padding: 0 0.85rem !important;
    border-radius: 0 0 26px 26px !important;
    overflow: visible !important;

    background:
      linear-gradient(180deg, rgba(8, 9, 14, .86), rgba(5, 5, 10, .74)) !important;

    border-top: 0 !important;
    border-left: 0 !important;
    border-right: 0 !important;

    box-shadow:
      0 18px 52px rgba(0,0,0,.34),
      inset 0 1px 0 rgba(255,255,255,.13) !important;
  }

  .header::after {
    left: 0 !important;
    right: 0 !important;
    bottom: -1px !important;
  }

  .logo img {
    width: clamp(118px, 34vw, 160px) !important;
  }

  .mobileLang {
    margin-left: auto !important;
    flex-shrink: 0 !important;
  }

  .mobileLang button {
    width: 26px !important;
    height: 26px !important;
    min-width: 26px !important;
  }

  .mobileButton {
    width: 42px !important;
    height: 42px !important;
    min-width: 42px !important;
    border-radius: 14px !important;
    flex-shrink: 0 !important;
    z-index: 2 !important;
  }
}

@media (max-width: 430px) {
  .header {
    height: 60px !important;
    padding: 0 0.7rem !important;
    border-radius: 0 0 22px 22px !important;
  }

  .logo img {
    width: clamp(108px, 32vw, 138px) !important;
  }

  .mobileLang button {
    width: 23px !important;
    height: 23px !important;
    min-width: 23px !important;
  }

  .mobileButton {
    width: 39px !important;
    height: 39px !important;
    min-width: 39px !important;
  }
}

/* Mobile drawer always above the header */
@media (max-width: 1100px) {
  .mobileBackdrop {
    z-index: 7000 !important;
  }

  .mobilePanel {
    z-index: 7001 !important;
  }
}

/* === FINAL OVERRIDE: MOBILE HEADER FULL WIDTH === */
@media (max-width: 1100px) {
  .wrapper {
    inset: 0 0 auto 0 !important;
    width: 100vw !important;
