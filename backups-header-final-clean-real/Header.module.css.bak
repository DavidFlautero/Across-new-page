/* HEADER RESPONSIVE WIDTH FINAL */
.wrapper {
  left: clamp(.75rem, 2.1vw, 2.5rem) !important;
  right: clamp(.75rem, 2.1vw, 2.5rem) !important;
  width: auto !important;
  max-width: none !important;
  box-sizing: border-box !important;
}

/* En pantallas medianas, compactar para que no se salga */
@media (min-width: 901px) and (max-width: 1280px) {
  .wrapper {
    left: 1rem !important;
    right: 1rem !important;
  }

  .nav {
    gap: clamp(.55rem, 1vw, 1rem) !important;
  }

  .nav a,
  .nav button {
    font-size: clamp(.72rem, .82vw, .86rem) !important;
    white-space: nowrap !important;
  }

  .logo img,
  .brand img {
    max-width: clamp(150px, 16vw, 220px) !important;
    height: auto !important;
  }
}

/* En notebook/tablet horizontal, esconder menos aire y evitar overflow */
@media (min-width: 901px) and (max-width: 1120px) {
  .wrapper {
    left: .75rem !important;
    right: .75rem !important;
  }

  .nav {
    gap: .65rem !important;
  }

  .nav a,
  .nav button {
    font-size: .72rem !important;
  }
}

/* Mobile queda full width arriba */
@media (max-width: 900px) {
  .wrapper {
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    border-radius: 0 0 18px 18px !important;
  }
}


/* =====================================================
   HEADER MENU COLOR POLISH
   Ajuste visual: botones, letras y menú más corporativo.
   ===================================================== */

/* Desktop */
@media (min-width: 761px) {
  .header {
    background: rgba(8, 10, 14, .76) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    box-shadow: 0 18px 48px rgba(0,0,0,.18) !important;
  }

  .nav a,
  .nav button,
  .actions a,
  .actions button {
    color: rgba(255,255,255,.88) !important;
    font-weight: 850 !important;
    letter-spacing: .035em !important;
  }

  .nav a:hover,
  .nav button:hover,
  .actions a:hover,
  .actions button:hover {
    color: #fff !important;
    background: rgba(255,255,255,.08) !important;
  }

  .nav a[aria-current="page"],
  .nav button[aria-expanded="true"] {
    color: #fff !important;
  }

  .contactButton,
  .cta,
  .contactLink {
    background: #b40032 !important;
    color: #fff !important;
    border: 1px solid #b40032 !important;
    border-radius: 8px !important;
    box-shadow: none !important;
  }

  .languageButton,
  .localeButton {
    background: rgba(255,255,255,.08) !important;
    border: 1px solid rgba(255,255,255,.18) !important;
    color: #fff !important;
  }
}

/* Mobile */
@media (max-width: 760px) {
  .header {
    background: rgba(8, 10, 14, .88) !important;
    border: 1px solid rgba(255,255,255,.14) !important;
    box-shadow: 0 16px 42px rgba(0,0,0,.22) !important;
  }

  .brand,
  .logo {
    color: #fff !important;
  }

  .languageButton,
  .localeButton {
    background: rgba(255,255,255,.10) !important;
    border: 1px solid rgba(255,255,255,.18) !important;
    color: #fff !important;
    box-shadow: none !important;
  }

  .menuButton,
  .mobileToggle {
    background: #111 !important;
    color: #fff !important;
    border: 1px solid rgba(255,255,255,.18) !important;
    box-shadow: none !important;
  }

  .menuButton svg,
  .mobileToggle svg {
    stroke: #fff !important;
  }

  .mobilePanel,
  .mobilePanelVisible,
  .mobileMenu,
  .panel {
    background: #fff !important;
    color: #111 !important;
  }

  .mobilePanel a,
  .mobilePanel button,
  .mobilePanelVisible a,
  .mobilePanelVisible button,
  .mobileMenu a,
  .mobileMenu button,
  .panel a,
  .panel button {
    color: #111 !important;
    font-weight: 850 !important;
    letter-spacing: -.01em !important;
  }

  .mobilePanel a:hover,
  .mobilePanel button:hover,
  .mobilePanelVisible a:hover,
  .mobilePanelVisible button:hover,
  .mobileMenu a:hover,
  .mobileMenu button:hover,
  .panel a:hover,
  .panel button:hover {
    background: #f3f3f3 !important;
    color: #b40032 !important;
  }
}

/* =====================================================
   HEADER FINAL LIGHT CORPORATE POLISH
   Header claro, corporativo, sin bloque negro pesado.
   El logo queda protegido para mantener lectura.
   ===================================================== */

@media (max-width: 760px) {
  .header {
    top: 10px !important;
    left: 10px !important;
    right: 10px !important;
    width: auto !important;

    background: rgba(255,255,255,.92) !important;
    border: 1px solid rgba(17,17,17,.10) !important;
    border-radius: 20px !important;
    box-shadow:
      0 14px 36px rgba(0,0,0,.14),
      inset 0 1px 0 rgba(255,255,255,.86) !important;
    backdrop-filter: blur(18px) saturate(1.1) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.1) !important;
  }

  .inner {
    min-height: 62px !important;
    padding: 0 10px !important;
  }

  .brand,
  .logo {
    min-height: 44px !important;
    padding: 5px 9px !important;
    border-radius: 16px !important;
    background: linear-gradient(135deg, #101216, #1b1d23) !important;
    box-shadow:
      0 8px 20px rgba(0,0,0,.16),
      inset 0 1px 0 rgba(255,255,255,.08) !important;
  }

  .brand img,
  .logo img {
    max-height: 36px !important;
    width: auto !important;
  }

  .languageButton,
  .localeButton,
  .flagButton {
    width: 34px !important;
    height: 34px !important;
    border-radius: 999px !important;
    background: #fff !important;
    border: 1px solid rgba(17,17,17,.12) !important;
    box-shadow: 0 6px 14px rgba(0,0,0,.08) !important;
  }

  .menuButton,
  .mobileToggle,
  .burger {
    width: 40px !important;
    height: 40px !important;
    border-radius: 14px !important;
    background: #fff !important;
    color: #111 !important;
    border: 1px solid rgba(17,17,17,.14) !important;
    box-shadow:
      0 8px 20px rgba(0,0,0,.10),
      inset 0 1px 0 rgba(255,255,255,.9) !important;
  }

  .menuButton svg,
  .mobileToggle svg,
  .burger svg {
    stroke: #111 !important;
  }
}

@media (min-width: 761px) {
  .header {
    background: rgba(255,255,255,.88) !important;
    border: 1px solid rgba(17,17,17,.09) !important;
    box-shadow:
      0 14px 38px rgba(0,0,0,.08),
      inset 0 1px 0 rgba(255,255,255,.82) !important;
    backdrop-filter: blur(18px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.08) !important;
  }

  .brand,
  .logo {
    padding: 6px 12px !important;
    border-radius: 16px !important;
    background: linear-gradient(135deg, #101216, #1b1d23) !important;
  }

  .nav a,
  .nav button,
  .actions a,
  .actions button {
    color: #111 !important;
    font-weight: 850 !important;
  }

  .nav a:hover,
  .nav button:hover {
    background: rgba(180,0,50,.07) !important;
    color: #b40032 !important;
  }
}

/* =====================================================
   HEADER REAL TRANSPARENT HERO FIX
   Corrige el header blanco sólido sobre el hero.
   Sobre hero: transparente/glass.
   Después del hero: blanco corporativo.
   ===================================================== */

/* MOBILE — sobre el hero */
@media (max-width: 760px) {
  :global(body:not(.across-header-solid)) .header {
    background: rgba(255, 255, 255, .08) !important;
    border: 1px solid rgba(255, 255, 255, .18) !important;
    box-shadow:
      0 14px 36px rgba(0, 0, 0, .18),
      inset 0 1px 0 rgba(255, 255, 255, .14) !important;
    backdrop-filter: blur(18px) saturate(1.14) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.14) !important;
  }

  :global(body:not(.across-header-solid)) .inner {
    background: transparent !important;
  }

  :global(body:not(.across-header-solid)) .brand,
  :global(body:not(.across-header-solid)) .logo {
    background: rgba(8, 10, 14, .82) !important;
    border: 1px solid rgba(255, 255, 255, .12) !important;
    border-radius: 16px !important;
    box-shadow:
      0 10px 24px rgba(0,0,0,.18),
      inset 0 1px 0 rgba(255,255,255,.08) !important;
  }

  :global(body:not(.across-header-solid)) .menuButton,
  :global(body:not(.across-header-solid)) .mobileToggle,
  :global(body:not(.across-header-solid)) .burger {
    background: rgba(8, 10, 14, .86) !important;
    color: #fff !important;
    border: 1px solid rgba(255, 255, 255, .16) !important;
    box-shadow:
      0 8px 20px rgba(0,0,0,.16),
      inset 0 1px 0 rgba(255,255,255,.08) !important;
  }

  :global(body:not(.across-header-solid)) .menuButton svg,
  :global(body:not(.across-header-solid)) .mobileToggle svg,
  :global(body:not(.across-header-solid)) .burger svg {
    stroke: #fff !important;
  }

  :global(body:not(.across-header-solid)) .languageButton,
  :global(body:not(.across-header-solid)) .localeButton,
  :global(body:not(.across-header-solid)) .flagButton {
    background: rgba(255, 255, 255, .18) !important;
    border: 1px solid rgba(255, 255, 255, .22) !important;
    box-shadow: 0 8px 18px rgba(0,0,0,.12) !important;
  }
}

/* MOBILE — después del hero */
@media (max-width: 760px) {
  :global(body.across-header-solid) .header {
    background: rgba(255, 255, 255, .96) !important;
    border: 1px solid rgba(17, 17, 17, .10) !important;
    box-shadow:
      0 14px 36px rgba(0, 0, 0, .12),
      inset 0 1px 0 rgba(255, 255, 255, .9) !important;
    backdrop-filter: blur(18px) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.08) !important;
  }

  :global(body.across-header-solid) .brand,
  :global(body.across-header-solid) .logo {
    background: rgba(8, 10, 14, .92) !important;
    border-radius: 16px !important;
  }

  :global(body.across-header-solid) .menuButton,
  :global(body.across-header-solid) .mobileToggle,
  :global(body.across-header-solid) .burger {
    background: #fff !important;
    color: #111 !important;
    border: 1px solid rgba(17, 17, 17, .14) !important;
  }

  :global(body.across-header-solid) .menuButton svg,
  :global(body.across-header-solid) .mobileToggle svg,
  :global(body.across-header-solid) .burger svg {
    stroke: #111 !important;
  }
}

/* DESKTOP — sobre el hero */
@media (min-width: 761px) {
  :global(body:not(.across-header-solid)) .header {
    background: rgba(255, 255, 255, .07) !important;
    border: 1px solid rgba(255, 255, 255, .16) !important;
    box-shadow:
      0 16px 42px rgba(0, 0, 0, .16),
      inset 0 1px 0 rgba(255, 255, 255, .12) !important;
    backdrop-filter: blur(18px) saturate(1.12) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.12) !important;
  }

  :global(body:not(.across-header-solid)) .inner {
    background: transparent !important;
  }

  :global(body:not(.across-header-solid)) .brand,
  :global(body:not(.across-header-solid)) .logo {
    background: rgba(8, 10, 14, .82) !important;
    border: 1px solid rgba(255, 255, 255, .12) !important;
    border-radius: 16px !important;
  }

  :global(body:not(.across-header-solid)) .nav a,
  :global(body:not(.across-header-solid)) .nav button,
  :global(body:not(.across-header-solid)) .actions a,
  :global(body:not(.across-header-solid)) .actions button {
    color: rgba(255, 255, 255, .94) !important;
  }
}

/* DESKTOP — después del hero */
@media (min-width: 761px) {
  :global(body.across-header-solid) .header {
    background: rgba(255, 255, 255, .96) !important;
    border: 1px solid rgba(17, 17, 17, .10) !important;
    box-shadow:
      0 14px 36px rgba(0, 0, 0, .10),
      inset 0 1px 0 rgba(255, 255, 255, .90) !important;
  }

  :global(body.across-header-solid) .nav a,
  :global(body.across-header-solid) .nav button,
  :global(body.across-header-solid) .actions a,
  :global(body.across-header-solid) .actions button {
    color: #111 !important;
  }
}

/* =====================================================
   HEADER REAL CLASSES FINAL FIX
   Estructura real:
   wrapper > header > logo/nav/language/mobileButton
   Hero: transparente / glass
   Después del hero: blanco corporativo
   ===================================================== */

/* Evita capas viejas/pseudo-elementos */
.wrapper::before,
.wrapper::after,
.header::before,
.header::after {
  display: none !important;
  content: none !important;
  background: transparent !important;
  box-shadow: none !important;
}

/* -----------------------------
   HERO — TRANSPARENTE REAL
   ----------------------------- */

:global(body:not(.across-header-solid)) .wrapper {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

:global(body:not(.across-header-solid)) .header {
  background: rgba(255, 255, 255, .10) !important;
  border: 1px solid rgba(255, 255, 255, .20) !important;
  box-shadow:
    0 14px 34px rgba(0, 0, 0, .16),
    inset 0 1px 0 rgba(255, 255, 255, .16) !important;
  backdrop-filter: blur(18px) saturate(1.14) !important;
  -webkit-backdrop-filter: blur(18px) saturate(1.14) !important;
}

/* Logo protegido */
:global(body:not(.across-header-solid)) .logo {
  background: rgba(8, 10, 14, .86) !important;
  border: 1px solid rgba(255, 255, 255, .12) !important;
  border-radius: 16px !important;
  box-shadow:
    0 10px 24px rgba(0, 0, 0, .18),
    inset 0 1px 0 rgba(255, 255, 255, .08) !important;
}

/* Banderas sobre hero */
:global(body:not(.across-header-solid)) .language button,
:global(body:not(.across-header-solid)) .mobileLang button {
  background: rgba(255, 255, 255, .18) !important;
  border: 1px solid rgba(255, 255, 255, .24) !important;
  box-shadow: 0 8px 18px rgba(0, 0, 0, .12) !important;
}

/* Hamburguesa sobre hero */
:global(body:not(.across-header-solid)) .mobileButton {
  background: rgba(8, 10, 14, .88) !important;
  color: #fff !important;
  border: 1px solid rgba(255, 255, 255, .16) !important;
  box-shadow:
    0 8px 20px rgba(0, 0, 0, .16),
    inset 0 1px 0 rgba(255, 255, 255, .08) !important;
}

:global(body:not(.across-header-solid)) .mobileButton svg {
  stroke: #fff !important;
}

/* Desktop links sobre hero */
@media (min-width: 761px) {
  :global(body:not(.across-header-solid)) .nav a,
  :global(body:not(.across-header-solid)) .nav button {
    color: rgba(255, 255, 255, .94) !important;
  }
}

/* -----------------------------
   DESPUÉS DEL HERO — BLANCO
   ----------------------------- */

:global(body.across-header-solid) .wrapper {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

:global(body.across-header-solid) .header {
  background: rgba(255, 255, 255, .96) !important;
  border: 1px solid rgba(17, 17, 17, .10) !important;
  box-shadow:
    0 14px 36px rgba(0, 0, 0, .12),
    inset 0 1px 0 rgba(255, 255, 255, .90) !important;
  backdrop-filter: blur(18px) saturate(1.08) !important;
  -webkit-backdrop-filter: blur(18px) saturate(1.08) !important;
}

:global(body.across-header-solid) .logo {
  background: rgba(8, 10, 14, .92) !important;
  border-radius: 16px !important;
  box-shadow: 0 8px 20px rgba(0, 0, 0, .12) !important;
}

:global(body.across-header-solid) .mobileButton {
  background: #fff !important;
  color: #111 !important;
  border: 1px solid rgba(17, 17, 17, .14) !important;
  box-shadow: 0 8px 20px rgba(0, 0, 0, .08) !important;
}

:global(body.across-header-solid) .mobileButton svg {
  stroke: #111 !important;
}

:global(body.across-header-solid) .language button,
:global(body.across-header-solid) .mobileLang button {
  background: #fff !important;
  border: 1px solid rgba(17, 17, 17, .12) !important;
  box-shadow: 0 6px 14px rgba(0, 0, 0, .08) !important;
}

@media (min-width: 761px) {
  :global(body.across-header-solid) .nav a,
  :global(body.across-header-solid) .nav button {
    color: #111 !important;
  }

  :global(body.across-header-solid) .nav a:hover,
  :global(body.across-header-solid) .nav button:hover {
    color: #b40032 !important;
    background: rgba(180, 0, 50, .07) !important;
  }
}

/* =====================================================
   HEADER SOLID WHITE AFTER HERO
   En hero: glass.
   Fuera del hero: blanco sólido, sin transparencias.
   ===================================================== */

:global(body.across-header-solid) .header {
  background: #ffffff !important;
  border: 1px solid rgba(17, 17, 17, .10) !important;
  box-shadow: 0 12px 32px rgba(0, 0, 0, .12) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

:global(body.across-header-solid) .wrapper {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

:global(body.across-header-solid) .language button,
:global(body.across-header-solid) .mobileLang button {
  background: #ffffff !important;
  border: 1px solid rgba(17,17,17,.12) !important;
  box-shadow: 0 4px 10px rgba(0,0,0,.08) !important;
}

:global(body.across-header-solid) .mobileButton {
  background: #111 !important;
  color: #fff !important;
  border: 1px solid #111 !important;
}

:global(body.across-header-solid) .mobileButton svg {
  stroke: #fff !important;
}

/* =====================================================
   HEADER FINAL CLEAN REAL
   Hero: glass transparente.
   Scroll: blanco sólido.
   Logo: compacto, no gigante.
   ===================================================== */

/* Mata capas viejas */
.wrapper::before,
.wrapper::after,
.header::before,
.header::after {
  display: none !important;
  content: none !important;
}

/* Base */
.wrapper {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.header {
  height: 58px !important;
  min-height: 58px !important;
  padding: 0 12px !important;
  transition: background .22s ease, box-shadow .22s ease, border-color .22s ease !important;
}

/* Logo compacto */
.logo {
  height: 42px !important;
  min-height: 42px !important;
  padding: 5px 10px !important;
  border-radius: 14px !important;
  display: inline-flex !important;
  align-items: center !important;
}

.logo img {
  height: 30px !important;
  max-height: 30px !important;
  width: auto !important;
}

/* HERO: transparente/glass */
:global(body:not(.across-header-solid)) .header {
  background: rgba(255,255,255,.08) !important;
  border: 1px solid rgba(255,255,255,.18) !important;
  box-shadow: 0 12px 30px rgba(0,0,0,.14) !important;
  backdrop-filter: blur(18px) saturate(1.12) !important;
  -webkit-backdrop-filter: blur(18px) saturate(1.12) !important;
}

:global(body:not(.across-header-solid)) .logo {
  background: rgba(8,10,14,.86) !important;
  border: 1px solid rgba(255,255,255,.12) !important;
  box-shadow: 0 8px 18px rgba(0,0,0,.16) !important;
}

:global(body:not(.across-header-solid)) .nav a,
:global(body:not(.across-header-solid)) .nav button,
:global(body:not(.across-header-solid)) .dropdownTrigger {
  color: rgba(255,255,255,.94) !important;
}

:global(body:not(.across-header-solid)) .mobileButton {
  background: rgba(8,10,14,.88) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.16) !important;
}

:global(body:not(.across-header-solid)) .mobileButton svg {
  stroke: #fff !important;
}

/* SCROLL: blanco sólido */
:global(body.across-header-solid) .header {
  background: #fff !important;
  border: 1px solid rgba(17,17,17,.10) !important;
  box-shadow: 0 12px 30px rgba(0,0,0,.10) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

:global(body.across-header-solid) .logo {
  background: #111 !important;
  border: 1px solid #111 !important;
  box-shadow: none !important;
}

:global(body.across-header-solid) .nav a,
:global(body.across-header-solid) .nav button,
:global(body.across-header-solid) .dropdownTrigger {
  color: #111 !important;
}

:global(body.across-header-solid) .nav a:hover,
:global(body.across-header-solid) .nav button:hover,
:global(body.across-header-solid) .dropdownTrigger:hover {
  color: #b40032 !important;
  background: rgba(180,0,50,.07) !important;
}

:global(body.across-header-solid) .mobileButton {
  background: #111 !important;
  color: #fff !important;
  border: 1px solid #111 !important;
}

:global(body.across-header-solid) .mobileButton svg {
  stroke: #fff !important;
}

/* Mobile ajuste fino */
@media (max-width: 760px) {
  .header {
    height: 56px !important;
    min-height: 56px !important;
    padding: 0 8px !important;
    border-radius: 18px !important;
  }

  .logo {
    height: 40px !important;
    min-height: 40px !important;
    padding: 5px 9px !important;
    border-radius: 13px !important;
  }

  .logo img {
    height: 28px !important;
    max-height: 28px !important;
  }

  .mobileButton {
    width: 38px !important;
    height: 38px !important;
    border-radius: 13px !important;
  }
}
